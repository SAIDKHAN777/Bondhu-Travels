// 1. Fetch live Hero Slides from database
let dbSlides: any[] = [];
try {
  const slideSetting = await prisma.systemSetting.findUnique({ where: { key: 'hero_slides' } });
  if (slideSetting && Array.isArray(slideSetting.value) && slideSetting.value.length > 0) {
    dbSlides = slideSetting.value;
  }
} catch (e: any) {
  console.warn('[Admin Page] DB slides load fallback:', e.message);
}

// Default fallback items matching user's video slides if DB is empty
if (dbSlides.length === 0) {
  dbSlides = [
    { id: 'slide-1', title: "Cox's Bazar sunrise", order: 1, active: true, videoUrl: "/uploads/videos/coxs_bazar_optimized_60fps.mp4" },
    { id: 'slide-2', title: "Sajek clouds", order: 2, active: true, videoUrl: "/uploads/videos/sajek_cut_2-5s-mvwdk5om.mp4" },
    { id: 'slide-3', title: "St. Martin boat", order: 3, active: true, videoUrl: "/uploads/videos/sunamganj_short_16x10-mvwdaq9p.mp4" },
