    function extractRoomsFromContainer(containerId, defaultPropId) {
      const container = document.getElementById(containerId);
      if (!container) return [];
      const cards = container.querySelectorAll('.spotlight-room-admin-card');
      const rooms = [];

      cards.forEach((card, idx) => {
        const id = card.getAttribute('data-id') || `${defaultPropId}-room-${idx + 1}`;
        const name = card.querySelector('.room-name-input')?.value.trim() || `Room #${idx + 1}`;
        const subtitle = card.querySelector('.room-subtitle-input')?.value.trim() || '';
        const price = card.querySelector('.room-price-input')?.value.trim() || '৳ ৮,৫০০';
        const priceUnit = card.querySelector('.room-priceunit-input')?.value.trim() || 'প্রতি রাত';
        const description = card.querySelector('.room-desc-textarea')?.value.trim() || '';

        // Extract multiple photos
        const photoItems = card.querySelectorAll('.room-photo-item');
        const gallery = [];
        photoItems.forEach(item => {
          const src = item.getAttribute('data-src');
          if (src && !gallery.includes(src)) {
            gallery.push(src);
          }
        });

        const mainImg = gallery[0] || (defaultPropId === 'hb' ? '/uploads/images/obintehasan_pindown_io_1793483591-mvwxtycm.jpg' : '/2026/01/Couple-sitting-by-coast.jpg');

        rooms.push({
          id,
          name,
          subtitle,
          price,
          priceUnit,
          img: mainImg,
          gallery: gallery.length > 0 ? gallery : [mainImg],
          description,
          features: subtitle ? [subtitle, "অ্যাটাচড ওয়াশরুম", "২৪ ঘণ্টা বিদ্যুৎ"] : ["অ্যাটাচড ওয়াশরুম", "২৪ ঘণ্টা বিদ্যুৎ"]
        });
      });

      return rooms;
    }

