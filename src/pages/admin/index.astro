      showToast(`Day ${dIdx + 1}-এর জন্য ছবি আপলোড হচ্ছে...`);
      try {
        const formData = new FormData();
        formData.append('image', file);
        const res = await fetch('/api/admin/upload-image', {
          method: 'POST',
          body: formData
        });
        const data = await res.json();
        const uploadedUrl = data.fileUrl || data.url || data.imageUrl;
        if (data.success && uploadedUrl) {
          if (!currentSchedTourDays[dIdx].images) {
            currentSchedTourDays[dIdx].images = [];
          }
          currentSchedTourDays[dIdx].images.push(uploadedUrl);
