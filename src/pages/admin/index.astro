    async function savePrivacyPolicySettings() {
      const topBtn = document.getElementById('btn-save-privacy-top');
      const bottomBtn = document.getElementById('btn-save-privacy-bottom');

      if (topBtn) topBtn.disabled = true;
      if (bottomBtn) bottomBtn.disabled = true;

      try {
        const title = document.getElementById('privacy-policy-title')?.value?.trim() || 'PRIVACY POLICY';
        const lastUpdated = document.getElementById('privacy-policy-lastupdated')?.value?.trim() || 'Last updated: November 2026';

        const sectionCards = document.querySelectorAll('.policy-section-editor-card');
        const sections = [];

        sectionCards.forEach((card) => {
          const secTitle = card.querySelector('.policy-sec-title-input')?.value?.trim() || '';
          const secText = card.querySelector('.policy-sec-text-input')?.value?.trim() || '';
          const listRaw = card.querySelector('.policy-sec-list-input')?.value?.trim() || '';

          if (secTitle || secText || listRaw) {
            const listItems = [];
            if (listRaw) {
              const lines = listRaw.split('\n').map(l => l.trim()).filter(Boolean);
              lines.forEach(line => {
                const colonIdx = line.indexOf(':');
                if (colonIdx > 0 && colonIdx < line.length - 1) {
                  listItems.push({
                    label: line.substring(0, colonIdx).trim(),
                    desc: line.substring(colonIdx + 1).trim()
                  });
                } else {
                  listItems.push({ desc: line });
                }
              });
            }

            const secObj = { title: secTitle };
            if (secText) secObj.text = secText;
            if (listItems.length > 0) secObj.list = listItems;

            sections.push(secObj);
          }
        });

        // Fetch existing section_privacy_policy to preserve extra keys
        let currentVal = {};
        try {
          const getRes = await fetch('/api/admin/sections/section_privacy_policy');
          const getData = await getRes.json();
          if (getData && getData.value) {
            currentVal = getData.value;
          }
        } catch (e) {
          console.warn('Could not fetch existing section_privacy_policy:', e);
        }

        const payload = {
          ...currentVal,
          title,
          lastUpdated,
          sections
        };

        const postRes = await fetch('/api/admin/sections/section_privacy_policy', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
        const postData = await postRes.json();

        if (postData.success) {
          showToast('✓ Privacy Policy পেজ সফলভাবে সেভ হয়েছে এবং আপডেট সম্পন্ন!');
        } else {
          showToast('⚠️ সেভ ব্যর্থ হয়েছে: ' + (postData.error || 'Server error'));
        }
      } catch (err) {
        console.error('Save Privacy Policy error:', err);
        showToast('⚠️ সেভ করতে সমস্যা হয়েছে: ' + err.message);
      } finally {
        if (topBtn) topBtn.disabled = false;
        if (bottomBtn) bottomBtn.disabled = false;
      }
    }
  </script>

  <script is:inline>
    // -------------------------------------------------------------
    // Security Gate Login & Logout Handlers
    // -------------------------------------------------------------
    const loginForm = document.getElementById('admin-login-form');
    if (loginForm) {
      const passInput = document.getElementById('admin-passcode-input');
      const toggleBtn = document.getElementById('btn-toggle-pass');
      const eyeShow = document.getElementById('eye-icon-show');
      const eyeHide = document.getElementById('eye-icon-hide');
      const errorMsg = document.getElementById('login-error-msg');
      const submitBtn = document.getElementById('btn-submit-login');
      const spinnerText = document.getElementById('btn-login-spinner');
      const btnText = document.getElementById('btn-login-text');

      if (toggleBtn && passInput) {
        toggleBtn.addEventListener('click', () => {
          const isPass = passInput.type === 'password';
          passInput.type = isPass ? 'text' : 'password';
          if (eyeShow) eyeShow.style.display = isPass ? 'none' : 'block';
          if (eyeHide) eyeHide.style.display = isPass ? 'block' : 'none';
        });
      }

      loginForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const password = passInput?.value || '';
        if (!password) return;

        if (submitBtn) submitBtn.disabled = true;
        if (spinnerText) spinnerText.style.display = 'inline-block';
        if (btnText) btnText.textContent = 'যাচাই করা হচ্ছে...';
        if (errorMsg) errorMsg.style.display = 'none';

        try {
          const res = await fetch('/api/admin/login', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ password })
          });
          const data = await res.json();
          if (data.success) {
            if (data.token) {
              sessionStorage.setItem('bt_admin_token', data.token);
            }
            window.location.reload();
          } else {
            if (errorMsg) {
              errorMsg.textContent = data.error || 'ভুল পাসওয়ার্ড। আবার চেষ্টা করুন।';
              errorMsg.style.display = 'block';
            }
            const card = document.querySelector('.login-card-luxury');
            card?.classList.add('shake-anim');
            setTimeout(() => card?.classList.remove('shake-anim'), 500);
          }
        } catch (err) {
          if (errorMsg) {
            errorMsg.textContent = 'সার্ভার সংযোগ সমস্যা: ' + err.message;
            errorMsg.style.display = 'block';
          }
        } finally {
          if (submitBtn) submitBtn.disabled = false;
          if (spinnerText) spinnerText.style.display = 'none';
          if (btnText) btnText.textContent = 'স্টুডিও আনলক করুন';
        }
      });
    }

    // Logout Trigger
    document.getElementById('btn-logout-sidebar')?.addEventListener('click', async () => {
      sessionStorage.removeItem('bt_admin_token');
      await fetch('/api/admin/logout', { method: 'POST' });
      window.location.reload();
    });
  </script>
</body>
</html>
