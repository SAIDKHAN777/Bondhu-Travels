    async function handleCraftCardThumbUpload(event, cardIdx) {
      const file = event.target.files?.[0];
      if (!file) return;

      showToast('কার্ডের থাম্বনেইল ছবি আপলোড হচ্ছে...');
      try {
        const formData = new FormData();
        formData.append('image', file);
        const res = await fetch('/api/admin/upload-image', {
          method: 'POST',
          body: formData
        });
        const data = await res.json();
        const uploadedUrl = data.fileUrl || data.url || data.imageUrl;
        if (uploadedUrl) {
          const preview = document.getElementById(`craft-card-thumb-preview-${cardIdx}`);
          const valInput = document.getElementById(`craft-card-thumb-val-${cardIdx}`);
          const mockupImg = document.getElementById(`mockup-craft-img-${cardIdx}`);
          if (preview) preview.src = uploadedUrl;
          if (valInput) valInput.value = uploadedUrl;
          if (mockupImg) mockupImg.src = uploadedUrl;
          showToast('✓ থাম্বনেইল ছবি সফলভাবে আপলোড হয়েছে!');
        } else {
          showToast('⚠️ ছবি আপলোড ব্যর্থ হয়েছে: ' + (data.error || 'Server error'));
        }
      } catch (err) {
        console.error('Craft card thumb upload error:', err);
        showToast('⚠️ ছবি আপলোডে সমস্যা হয়েছে: ' + err.message);
      }
    }

