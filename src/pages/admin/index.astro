    // Toggle Hero Media Type (Photo vs Video)
    function setTourHeroMediaType(type) {
      const typeInput = document.getElementById('editor-hero-media-type');
      if (typeInput) typeInput.value = type;
      const btnPhoto = document.getElementById('btn-media-type-photo');
      const btnVideo = document.getElementById('btn-media-type-video');
      const photoControls = document.getElementById('hero-photo-controls');
      const videoControls = document.getElementById('hero-video-controls');

      if (type === 'video') {
        if (btnVideo) {
          btnVideo.style.background = '#2563EB';
          btnVideo.style.color = '#FFFFFF';
        }
        if (btnPhoto) {
          btnPhoto.style.background = 'transparent';
          btnPhoto.style.color = '#475569';
        }
        if (videoControls) videoControls.style.display = 'block';
        if (photoControls) photoControls.style.display = 'none';
      } else {
        if (btnPhoto) {
          btnPhoto.style.background = '#2563EB';
          btnPhoto.style.color = '#FFFFFF';
        }
        if (btnVideo) {
          btnVideo.style.background = 'transparent';
          btnVideo.style.color = '#475569';
        }
        if (photoControls) photoControls.style.display = 'block';
        if (videoControls) videoControls.style.display = 'none';
      }
    }

