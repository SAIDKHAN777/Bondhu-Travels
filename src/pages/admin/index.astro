  <!-- Client-side Interactive Navigation & State Management -->
  <script is:inline>
    // Tab aliases mapping
    const tabAliases = {
      'craft-schedule': 'craft-schedule',
      'craft-your-trip-schedule': 'craft-schedule',
      'schedule-cards': 'craft-schedule',
      'packages': 'explore-trips',
      'trips': 'explore-trips',
      'tours': 'explore-trips',
      'explore': 'explore-trips',
      'scheduled-tours': 'scheduled-tours',
      'scheduled': 'scheduled-tours',
      'schedule': 'scheduled-tours',
      'tour-schedule': 'scheduled-tours',
      'footer': 'footer-payments',
      'payments': 'footer-payments',
      'reviews': 'why-us',
      'testimonials': 'why-us',
      'videos': 'hero-videos',
      'hero': 'hero-videos',
      'journey': 'start-journey',
      'booking-overview': 'bookings',
      'private-trips': 'private-trips',
      'private-trip-requests': 'private-trips',
      'private-trip': 'private-trips',
      'craft-trip': 'craft-schedule',
      'craft-your-trip': 'craft-schedule',
      'about': 'about-us',
      'about-us': 'about-us',
      'aboutus': 'about-us',
      'privacy': 'privacy-policy',
      'privacy-policy': 'privacy-policy',
      'privacypolicy': 'privacy-policy',
      'policy': 'privacy-policy',
      'private': 'private-trips'
    };

    function resolveTabId(id) {
      if (!id) return '';
      const clean = id.toLowerCase().replace(/^#/, '').trim();
      return tabAliases[clean] || clean;
    }

    // Tab switching logic with persistence
    function switchTab(tabId, updateHistory = true) {
      const resolved = resolveTabId(tabId);
      if (!resolved) return;

      // 1. Update active nav item in sidebar
      document.querySelectorAll('.admin-sidebar .nav-item').forEach(item => {
        item.classList.remove('active');
        if (item.getAttribute('data-tab') === resolved) {
          item.classList.add('active');
        }
      });

      // If opening brand-letter, ensure submenu is expanded
      if (resolved === 'brand-letter') {
        const sub = document.getElementById('sidebar-brand-letter-sub');
        const arrow = document.getElementById('sidebar-hero-arrow');
        if (sub) sub.classList.remove('is-closed');
        if (arrow) arrow.classList.remove('is-collapsed');
      }

      // If opening any journey sub-item, ensure journey submenu is expanded
      if (['start-journey', 'by-traveller', 'by-month', 'spotlight'].includes(resolved)) {
        const jSub = document.getElementById('sidebar-journey-sub');
        const jArrow = document.getElementById('sidebar-journey-arrow');
        if (jSub) jSub.classList.remove('is-closed');
        if (jArrow) jArrow.classList.remove('is-collapsed');
      }

      // If opening any what-we-do sub-item, ensure submenu is expanded
      if (['what-we-do', 'feeling-section', 'luxury-guide'].includes(resolved)) {
        const wSub = document.getElementById('sidebar-whatwedo-sub');
        const wArrow = document.getElementById('sidebar-whatwedo-arrow');
        if (wSub) wSub.classList.remove('is-closed');
        if (wArrow) wArrow.classList.remove('is-collapsed');
      }

      // If opening any craft-schedule sub-item, ensure craft-schedule submenu is expanded
      if (['scheduled-tours', 'private-trips'].includes(resolved)) {
        const csSub = document.getElementById('sidebar-craft-schedule-sub');
        const csArrow = document.getElementById('sidebar-craft-schedule-arrow');
        if (csSub) csSub.classList.remove('is-closed');
        if (csArrow) csArrow.classList.remove('is-collapsed');
      }

      // 2. Hide all tab views
      document.querySelectorAll('.admin-tab-view').forEach(v => {
        v.style.display = 'none';
      });

      // 3. Show targeted view
      const targetView = document.getElementById(`view-${resolved}`);
      if (targetView) {
        targetView.style.display = 'block';
        if (resolved === 'scheduled-tours' && typeof initAdminScheduledTours === 'function') {
          initAdminScheduledTours();
        }
      } else {
        // Fallback generic view
        const fallback = document.getElementById('view-fallback-generic');
        if (fallback) {
          const prettyTitle = resolved.replace(/-/g, ' ').replace(/\b\w/g, l => l.toUpperCase());
          document.getElementById('fallback-view-title').textContent = prettyTitle;
          document.getElementById('fallback-view-subtitle').textContent = `${prettyTitle} সেকশন ডেটা এডিটর`;
          document.getElementById('fallback-panel-title').textContent = `${prettyTitle} Management Console`;
          fallback.style.display = 'block';
        }
      }

      // 4. Save to URL hash and localStorage so it persists across page reloads
      try {
        localStorage.setItem('admin_active_tab', resolved);
        if (updateHistory) {
          if (window.location.hash !== '#' + resolved) {
            history.replaceState(null, '', '#' + resolved);
          }
        }
      } catch (err) {
        console.warn('Tab persistence error:', err);
      }
    }

    // Auto-restore active tab on page reload or hash change
    function restoreActiveAdminTab() {
      const hashTab = resolveTabId(window.location.hash);
      const savedTab = resolveTabId(localStorage.getItem('admin_active_tab'));
      const activeTab = hashTab || savedTab || 'hero-videos';
      switchTab(activeTab, false);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', restoreActiveAdminTab);
    } else {
      restoreActiveAdminTab();
    }

    window.addEventListener('hashchange', () => {
      const hashTab = resolveTabId(window.location.hash);
      if (hashTab) switchTab(hashTab, false);
    });

    // Toggle Sidebar Brand Letter Accordion (Slides down/up on arrow click)
    function toggleSidebarBrandLetter(e) {
      if (e) e.stopPropagation();
      const sub = document.getElementById('sidebar-brand-letter-sub');
      const arrow = document.getElementById('sidebar-hero-arrow');
      if (sub) {
        const isClosed = sub.classList.contains('is-closed');
        if (isClosed) {
          sub.classList.remove('is-closed');
          if (arrow) arrow.classList.remove('is-collapsed');
        } else {
          sub.classList.add('is-closed');
          if (arrow) arrow.classList.add('is-collapsed');
        }
      }
    }

    // Toggle Sidebar Journey Accordion (Slides down/up on arrow click)
    function toggleSidebarJourney(e) {
      if (e) e.stopPropagation();
      const sub = document.getElementById('sidebar-journey-sub');
      const arrow = document.getElementById('sidebar-journey-arrow');
      if (sub) {
        const isClosed = sub.classList.contains('is-closed');
        if (isClosed) {
          sub.classList.remove('is-closed');
          if (arrow) arrow.classList.remove('is-collapsed');
        } else {
          sub.classList.add('is-closed');
          if (arrow) arrow.classList.add('is-collapsed');
        }
      }
    }

    // Toggle Sidebar What We Do Accordion (Slides down/up on arrow click)
    function toggleSidebarWhatWeDo(e) {
      if (e) e.stopPropagation();
      const sub = document.getElementById('sidebar-whatwedo-sub');
      const arrow = document.getElementById('sidebar-whatwedo-arrow');
      if (sub) {
        const isClosed = sub.classList.contains('is-closed');
        if (isClosed) {
          sub.classList.remove('is-closed');
          if (arrow) arrow.classList.remove('is-collapsed');
        } else {
          sub.classList.add('is-closed');
          if (arrow) arrow.classList.add('is-collapsed');
        }
      }
    }

    // Toggle Sidebar Craft Your Trip & Schedule Accordion (Slides down/up on arrow click)
    function toggleSidebarCraftSchedule(e) {
      if (e) e.stopPropagation();
      const sub = document.getElementById('sidebar-craft-schedule-sub');
      const arrow = document.getElementById('sidebar-craft-schedule-arrow');
      if (sub) {
        const isClosed = sub.classList.contains('is-closed');
        if (isClosed) {
          sub.classList.remove('is-closed');
          if (arrow) arrow.classList.remove('is-collapsed');
        } else {
          sub.classList.add('is-closed');
          if (arrow) arrow.classList.add('is-collapsed');
        }
      }
    }

    // Helper: Trigger file picker for any card image
    function triggerChangeImage(inputId) {
      const input = document.getElementById(inputId);
      if (input) {
        input.value = '';
        input.click();
      }
    }

    // Helper: Handle direct image upload for any card
    async function handleCardImageUpload(e, previewId, valInputId) {
      const file = e.target.files && e.target.files[0];
      if (!file) return;

      showToast('ছবি আপলোড হচ্ছে...');
      try {
        const formData = new FormData();
        formData.append('image', file);
        const res = await fetch('/api/admin/upload-image', {
          method: 'POST',
          body: formData
        });
        const data = await res.json();
        const uploadedUrl = data.fileUrl || data.url || data.imageUrl || data.videoUrl;
        if (data.success && uploadedUrl) {
          const preview = document.getElementById(previewId);
          const hiddenVal = document.getElementById(valInputId);
          if (preview) preview.src = uploadedUrl;
          if (hiddenVal) hiddenVal.value = uploadedUrl;
          showToast('✓ ছবি সফলভাবে পরিবর্তন হয়েছে!');
        } else {
          throw new Error(data.error || 'Upload failed');
        }
      } catch (err) {
        console.error('Image upload error:', err);
        alert('ছবি আপলোড করতে সমস্যা হয়েছে: ' + err.message);
      }
    }

    // Save By Traveller Changes
    async function saveByTravellerChanges() {
      const btn = document.getElementById('btn-save-by-traveller');
      if (btn) btn.disabled = true;

      try {
        const cards = [];
        for (let i = 0; i < 5; i++) {
          const title = document.getElementById(`traveller-title-${i}`)?.value?.trim() || '';
          const link = document.getElementById(`traveller-link-${i}`)?.value?.trim() || '';
          const img = document.getElementById(`traveller-img-val-${i}`)?.value || '';
          cards.push({ title, link, img });
        }

        const getRes = await fetch('/api/admin/sections/section_tour_sessions');
        const getData = await getRes.json();
        const currentVal = getData?.value || {};

        const updated = {
          ...currentVal,
          travellerCards: cards
        };

        const postRes = await fetch('/api/admin/sections/section_tour_sessions', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(updated)
        });
        const postData = await postRes.json();
        if (postData.success) {
          showToast('✓ By Traveller কার্ড সফলভাবে সেভ হয়েছে! হোমপেজে আপডেট সম্পন্ন।');
        } else {
          throw new Error(postData.error || 'Server error');
        }
      } catch (err) {
        console.error('Save traveller error:', err);
        alert('By Traveller সেভ করতে সমস্যা হয়েছে: ' + err.message);
      } finally {
        if (btn) btn.disabled = false;
      }
    }

