    // Helper: Persist exploreTripsList to DB
    async function persistExploreTripsToDB() {
      const res = await fetch('/api/admin/sections/section_explore_trips', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ trips: exploreTripsList })
      });
      const data = await res.json();
      if (!data.success) {
        throw new Error(data.error || 'Server error');
      }
      const holder = document.getElementById('raw-explore-trips-data-holder');
      if (holder) {
        holder.setAttribute('data-trips', JSON.stringify(exploreTripsList));
      }
      return data;
    }

