          const a = c.querySelector('input[type="text"]')?.value?.trim();
          if (q && a) remainingReviews.push({ quote: q, author: a });
        });

        const getRes = await fetch('/api/admin/sections/section_testimonials');
        const getData = await getRes.json();
        const currentVal = getData?.value || {};

        const updated = {
          ...currentVal,
          reviews: remainingReviews
        };

        const postRes = await fetch('/api/admin/sections/section_testimonials', {
