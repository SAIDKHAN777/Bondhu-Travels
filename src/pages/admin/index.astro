} catch (e: any) {
  console.warn('[Admin Page] DB intro load fallback:', e.message);
}

const introTitle = introConfig?.title || "Where Journeys End, Hearts Return";
const introBody = introConfig?.body || (introConfig?.paragraphs ? introConfig.paragraphs.join('\n\n') : "Some journeys leave us wearier than before. Hurried itineraries, crowded landmarks, and moments confined to a photograph rarely touch the soul. True travel is not about collecting pictures; it is about finding peace and feeling something new. A quiet dawn, a cup of tea among the mountains, a still evening beside someone dear: these are its real destinations.\n\nAt Bondhu Travel, we never offer copy-and-paste tours. Whether you travel as a couple, a family, a group of friends, or a solitary wanderer, we listen first to your tastes, your pace, and your dreams, then craft a journey that is entirely your own.\n\nFrom Sajek and Bandarban to the Sundarbans and Europe, our care goes with you: premium resorts, trusted personal guides, no hidden charges, and 24/7 support. Simply enjoy the journey; the rest is our promise, so you return home with memories worth treasuring.");

