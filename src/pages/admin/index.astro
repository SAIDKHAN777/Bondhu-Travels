      const btn = document.getElementById('btn-save-stats');
      if (btn) btn.disabled = true;

      try {
        const stats = [];
        for (let i = 0; i < 2; i++) {
          const value = document.getElementById(`stat-val-${i}`)?.value?.trim() || '';
          const unit = document.getElementById(`stat-unit-${i}`)?.value?.trim() || '';
          const label = document.getElementById(`stat-lbl-${i}`)?.value?.trim() || '';
          const desc = document.getElementById(`stat-desc-${i}`)?.value?.trim() || '';
          stats.push({ value, unit, label, desc });
        }

        const getRes = await fetch('/api/admin/sections/section_stats');
        const getData = await getRes.json();
        const currentVal = getData?.value || {};

        const updated = {
          ...currentVal,
          stats
        };

        const postRes = await fetch('/api/admin/sections/section_stats', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(updated)
        });
