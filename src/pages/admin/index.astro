            <span>Save Header / হেডলাইন সেভ করুন</span>
          </button>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem; margin-bottom: 1rem;">
          <div>
            <label class="form-label" style="font-weight: 600; color: #334155; margin-bottom: 0.4rem; display: block;">Main Headline / মূল শিরোনাম *</label>
            <input 
              type="text" 
              id="whyus-title-input" 
              class="form-input" 
              value={liveWhyUsTitle} 
              placeholder="e.g. WHY BLACK TOMATO? / WHY LUXURY TRAVEL" 
              required 
            />
            <span style="font-size: 11.5px; color: #94A3B8; margin-top: 4px; display: block;">হোমপেজের বড় বোল্ড টেক্সট হিসেবে শো করবে।</span>
          </div>
          <div>
            <label class="form-label" style="font-weight: 600; color: #334155; margin-bottom: 0.4rem; display: block;">Subtitle / উপ-শিরোনাম (ঐচ্ছিক)</label>
            <input 
              type="text" 
              id="whyus-subtitle-input" 
              class="form-input" 
              value={liveWhyUsSubtitle} 
              placeholder="e.g. Two decades of delivering the world's most inspiring..." 
            />
            <span style="font-size: 11.5px; color: #94A3B8; margin-top: 4px; display: block;">শিরোনামের নিচে ছোট ধূসর টেক্সট হিসেবে থাকবে।</span>
          </div>
        </div>

        <!-- Live Header Mockup Preview -->
        <div style="background: #F8FAFC; border: 1px dashed #CBD5E1; border-radius: 8px; padding: 1.25rem; text-align: center;">
          <div style="font-size: 11px; text-transform: uppercase; letter-spacing: 1px; color: #94A3B8; margin-bottom: 0.5rem; font-weight: 700;">Live Homepage Preview</div>
          <h3 id="preview-whyus-title" style="font-family: sans-serif; font-size: 24px; font-weight: 800; letter-spacing: 2px; text-transform: uppercase; color: #000000; margin: 0 0 0.35rem 0;">{liveWhyUsTitle}</h3>
          <p id="preview-whyus-subtitle" style="font-size: 13.5px; color: #64748B; margin: 0; max-width: 650px; margin-left: auto; margin-right: auto;">{liveWhyUsSubtitle}</p>
        </div>
      </div>

      <!-- PART 2: 2 STATS COUNTERS (EXPERIENCE & TRAVELERS SERVED) -->
      <div class="stats-section-wrapper" style="margin-bottom: 2.5rem;">
        <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 1rem;">
          <div>
            <h2 style="font-size: 16px; font-weight: 700; color: #1E293B; margin: 0;">২. অথরিটি ও অভিজ্ঞতার ২টি মেট্রিক্স (Experience & Trust Counters)</h2>
            <p style="font-size: 13px; color: #64748B; margin: 2px 0 0 0;">হোমপেজে প্রদর্শিত ২টি মূল সংখ্যা (বছর ও ট্রাভেলার সংখ্যা)</p>
          </div>
          <button type="button" class="btn-save-letter" onclick="saveStatsChanges()" id="btn-save-stats">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
            <span>Save Stats / মেট্রিক্স সেভ করুন</span>
          </button>
        </div>

        <!-- Grid of 2 Stat Cards -->
        <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.5rem;">
          <!-- Card 1: Experience -->
          <div class="brand-letter-full-card" style="padding: 1.35rem;">
            <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 1rem;">
              <div style="width: 28px; height: 28px; border-radius: 6px; background: #EFF6FF; color: #2563EB; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 13px;">1</div>
              <div style="font-weight: 700; font-size: 14px; color: #1E293B;">কত বছর এক্সপেরিয়েন্স</div>
            </div>
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-bottom: 0.75rem;">
              <div>
                <label class="form-label">Value (সংখ্যা) *</label>
                <input type="text" id="stat-val-0" class="form-input" value={liveStats[0]?.value || '20+'} placeholder="20+" required />
              </div>
              <div>
                <label class="form-label">Unit (ইউনিট) *</label>
                <input type="text" id="stat-unit-0" class="form-input" value={liveStats[0]?.unit || 'YEARS'} placeholder="YEARS" required />
              </div>
            </div>
            <div class="form-group" style="margin-bottom: 0.75rem;">
