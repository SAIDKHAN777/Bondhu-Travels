    // ============================================================
    // EXPLORE OUR TRIPS & TOUR DETAIL INTERFACE MANAGEMENT
    // ============================================================
    function getExploreTripsFromDOM() {
      try {
        const holder = document.getElementById('raw-explore-trips-data-holder');
        if (holder) {
          const raw = holder.getAttribute('data-trips') || holder.dataset?.trips;
          if (raw) {
            const parsed = JSON.parse(raw);
            if (Array.isArray(parsed) && parsed.length > 0) return parsed;
          }
        }
      } catch (e) {
        console.warn('DOM parse failed for explore trips:', e);
      }
      return null;
    }

    let exploreTripsList = getExploreTripsFromDOM() || [];
    let activeTourIdx = -1;
    let currentTourDays = [];

    // 1. Direct Thumbnail Upload on Card
    async function handleTourThumbnailUpload(e, idx) {
      const file = e.target.files && e.target.files[0];
      if (!file) return;

      showToast('থাম্বনেল ছবি আপলোড হচ্ছে...');
      try {
        const formData = new FormData();
        formData.append('image', file);
        const res = await fetch('/api/admin/upload-image', {
          method: 'POST',
          body: formData
        });
        const data = await res.json();
        const uploadedUrl = data.fileUrl || data.url || data.imageUrl;
        if (data.success && uploadedUrl) {
          const preview = document.getElementById(`tour-thumb-preview-${idx}`);
          if (preview) preview.src = uploadedUrl;
          if (exploreTripsList[idx]) {
            exploreTripsList[idx].img = uploadedUrl;
          }
          await persistExploreTripsToDB();
          showToast('✓ থাম্বনেল সফলভাবে পরিবর্তন ও সেভ হয়েছে!');
        } else {
          throw new Error(data.error || 'Upload failed');
        }
      } catch (err) {
        console.error('Thumbnail upload error:', err);
        alert('ছবি আপলোড করতে সমস্যা হয়েছে: ' + err.message);
      }
    }

    // 2. Open Tour Detail Editor
    async function openTourDetailEditor(idx) {
      if (!exploreTripsList || exploreTripsList.length === 0 || !exploreTripsList[idx]) {
        const domList = getExploreTripsFromDOM();
        if (domList && domList.length > 0) {
          exploreTripsList = domList;
        }
      }

      // If still empty or idx out of bounds, fetch from server API fallback
      if (!exploreTripsList || exploreTripsList.length === 0 || !exploreTripsList[idx]) {
        try {
          const res = await fetch('/api/admin/sections/section_explore_trips');
          const data = await res.json();
          if (data && data.success && data.value && Array.isArray(data.value.trips)) {
            exploreTripsList = data.value.trips;
          }
        } catch (err) {
          console.error('Fetch trips error in openTourDetailEditor:', err);
        }
      }

      if (!exploreTripsList || idx < 0 || idx >= exploreTripsList.length) {
        alert('ট্যুরের তথ্য লোড করা যায়নি। অনুগ্রহ করে পেজটি রিফ্রেশ দিয়ে আবার চেষ্টা করুন।');
        return;
      }

      activeTourIdx = idx;
      const tour = exploreTripsList[idx];

      const headingEl = document.getElementById('editor-tour-main-heading');
      if (headingEl) {
        headingEl.textContent = `Editing: ${tour.title || 'Tour Details'}`;
      }
      
      const liveLink = document.getElementById('editor-tour-live-link');
      if (liveLink) {
        liveLink.href = tour.link || (tour.slug ? `/destinations/${tour.slug}/` : `/destinations/${(tour.title || '').toLowerCase().replace(/[^a-z0-9]+/g, '-')}/`);
      }

      // Panel 1: Basic
      const elTitle = document.getElementById('editor-tour-title');
      const elCountry = document.getElementById('editor-tour-country');
      if (elTitle) elTitle.value = tour.title || '';
      if (elCountry) elCountry.value = tour.country || 'BANGLADESH';
      
      const thumbPreview = document.getElementById('editor-tour-thumb-preview');
      const thumbVal = document.getElementById('editor-tour-thumb-val');
      const thumbSrc = tour.img || tour.heroImage || '/2022/09/Utah-adventure-2-1-scaled.jpg';
      if (thumbPreview) thumbPreview.src = thumbSrc;
      if (thumbVal) thumbVal.value = thumbSrc;

      // Panel 2: Hero Section
      const mediaType = tour.heroMediaType || (tour.heroVideo ? 'video' : 'image');
      setTourHeroMediaType(mediaType);
      
      const heroPhotoPreview = document.getElementById('editor-hero-photo-preview');
      const heroPhotoVal = document.getElementById('editor-hero-photo-val');
      const heroPhotoSrc = tour.heroImage || tour.img || '/2022/09/Utah-adventure-2-1-scaled.jpg';
      if (heroPhotoPreview) heroPhotoPreview.src = heroPhotoSrc;
      if (heroPhotoVal) heroPhotoVal.value = heroPhotoSrc;

      const heroVideoPreview = document.getElementById('editor-hero-video-preview');
      const heroVideoVal = document.getElementById('editor-hero-video-val');
      const heroVideoSrc = tour.heroVideo || '';
      if (heroVideoPreview) heroVideoPreview.src = heroVideoSrc;
      if (heroVideoVal) heroVideoVal.value = heroVideoSrc;

      // Panel 3: Letter Section
      const elLead = document.getElementById('editor-tour-lead');
      const elStory = document.getElementById('editor-tour-story');
      if (elLead) elLead.value = tour.desc || tour.overviewLead || '';
      if (elStory) elStory.value = tour.overviewStory || '';

      // Panel 4: 3 Metrics
      const elWhen = document.getElementById('editor-tour-when');
      const elWhenSub = document.getElementById('editor-tour-whensub');
      const elPrice = document.getElementById('editor-tour-price');
      const elPriceSharing = document.getElementById('editor-tour-pricesharing');
      const elHowLong = document.getElementById('editor-tour-howlong');
      const elHowLongSub = document.getElementById('editor-tour-howlongsub');
      if (elWhen) elWhen.value = tour.when || 'All Year Round';
      if (elWhenSub) elWhenSub.value = tour.whenSub || 'Best Season';
      if (elPrice) elPrice.value = tour.price || '৳ 4,500 per person';
      if (elPriceSharing) elPriceSharing.value = tour.priceSharing || '(based on 2 ppl sharing)';
      if (elHowLong) elHowLong.value = tour.howLong || tour.nights || '3 Nights';
      if (elHowLongSub) elHowLongSub.value = tour.howLongSub || 'Ideal length';

      // Panel 5: Itinerary Days
      currentTourDays = Array.isArray(tour.days) ? JSON.parse(JSON.stringify(tour.days)) : [];
      if (currentTourDays.length === 0) {
        currentTourDays = [
          {
            day: "Day 1",
            title: "VIP Arrival & Welcome Reception",
            desc: "VIP airport reception, private luxury transfer to your oceanfront suite, followed by a welcome dinner prepared by our private chef.",
            images: [thumbSrc],
            stay: "Boutique Luxury Resort — Suite",
            dining: "Artisanal Welcome Dinner"
          }
        ];
      }
      renderEditorDaysList();

      // Show editor, hide list
      const listView = document.getElementById('explore-trips-list-view');
      const detailEditor = document.getElementById('explore-trip-detail-editor');
      if (listView) listView.style.display = 'none';
      if (detailEditor) detailEditor.style.display = 'block';
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

