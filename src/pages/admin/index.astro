import prisma from '../../lib/prisma.js';
import { validateAdminToken } from '../../lib/adminAuth.js';

export const prerender = false;

// Security Gate: Validate Admin Session Token from cookie
const sessionCookie = Astro.cookies.get('bt_admin_session')?.value;
