    function updateRoomCountBadge(propKey) {
      const containerId = propKey === 'houseboat' ? 'houseboat-rooms-list' : 'resort-rooms-list';
      const badgeId = propKey === 'houseboat' ? 'hb-room-count-badge' : 'resort-room-count-badge';
      const count = document.querySelectorAll(`#${containerId} .spotlight-room-admin-card`).length;
      const badge = document.getElementById(badgeId);
      if (badge) {
        badge.textContent = `${count} টি ${propKey === 'houseboat' ? 'রুম' : 'কটেজ'}`;
      }
    }

    function deleteSpotlightRoomCard(btn) {
      const card = btn.closest('.spotlight-room-admin-card');
      if (!card) return;
      const title = card.querySelector('.room-name-input')?.value || 'এই রুম';
      const propKey = card.getAttribute('data-property') || 'houseboat';
      if (confirm(`আপনি কি "${title}" মুছে ফেলতে চান?`)) {
        card.remove();
        updateRoomCountBadge(propKey);
        markSpotlightDirty(propKey);
        showToast('রুম মুছে ফেলা হয়েছে। পরিবর্তন স্থায়ী করতে "Save" বাটনে ক্লিক করুন।');
      }
    }

    function updateRoomCardDisplayTitle(input) {
      const card = input.closest('.spotlight-room-admin-card');
      if (!card) return;
      const displayTitle = card.querySelector('.room-card-display-title');
      if (displayTitle) {
        displayTitle.textContent = input.value.trim() || 'রুম নাম';
      }
      const propKey = card.getAttribute('data-property') || 'houseboat';
      markSpotlightDirty(propKey, card);
    }

    function removeRoomPhoto(btn) {
      const photoItem = btn.closest('.room-photo-item');
      if (!photoItem) return;
      const card = btn.closest('.spotlight-room-admin-card');
      const propKey = card ? card.getAttribute('data-property') : 'houseboat';
      const strip = photoItem.closest('.room-photos-strip');
      photoItem.remove();
      if (strip) {
        const remaining = strip.querySelectorAll('.room-photo-item');
        remaining.forEach((item, idx) => {
          let badge = item.querySelector('span');
          if (idx === 0) {
            if (!badge) {
              const span = document.createElement('span');
              span.style.cssText = 'position: absolute; bottom: 0; left: 0; right: 0; background: rgba(15,23,42,0.85); color: #FFF; font-size: 8px; text-align: center; padding: 1px 0; font-weight: 700;';
              span.textContent = 'Main';
              item.appendChild(span);
            }
          } else if (badge) {
            badge.remove();
          }
        });
      }
      markSpotlightDirty(propKey, card);
      showToast('ছবি সরানো হয়েছে।');
    }

    async function handleRoomPhotosUpload(event, inputEl) {
      const files = event.target.files;
      if (!files || files.length === 0) return;

      const card = inputEl.closest('.spotlight-room-admin-card');
      const strip = card ? card.querySelector('.room-photos-strip') : null;
      if (!strip) return;
      const propKey = card ? card.getAttribute('data-property') : 'houseboat';

      showToast(`${files.length}টি ছবি আপলোড হচ্ছে...`);

      for (let i = 0; i < files.length; i++) {
        const file = files[i];
        try {
          const formData = new FormData();
          formData.append('image', file);
          const res = await fetch('/api/admin/upload-image', {
            method: 'POST',
            body: formData
          });
          const data = await res.json();
          if (data.success && data.url) {
            const hasExisting = strip.querySelectorAll('.room-photo-item').length > 0;
            const photoDiv = document.createElement('div');
            photoDiv.className = 'room-photo-item';
            photoDiv.setAttribute('data-src', data.url);
            photoDiv.style.cssText = 'position: relative; width: 85px; height: 65px; border-radius: 6px; overflow: hidden; border: 1px solid #CBD5E1; background: #0F172A;';
            photoDiv.innerHTML = `
              <img src="${data.url}" alt="Room Photo" style="width: 100%; height: 100%; object-fit: cover; display: block;" />
              <button 
                type="button" 
                onclick="removeRoomPhoto(this)"
                title="ছবি মুছুন"
                style="position: absolute; top: 2px; right: 2px; width: 18px; height: 18px; background: rgba(220,38,38,0.9); color: #FFF; border: none; border-radius: 50%; font-size: 11px; line-height: 1; cursor: pointer; display: flex; align-items: center; justify-content: center; padding: 0;"
              >
                ×
              </button>
              ${!hasExisting ? '<span style="position: absolute; bottom: 0; left: 0; right: 0; background: rgba(15,23,42,0.85); color: #FFF; font-size: 8px; text-align: center; padding: 2px 0; font-weight: 700;">Main</span>' : ''}
            `;
            strip.appendChild(photoDiv);
          }
        } catch (err) {
          console.error('Room photo upload error:', err);
        }
      }

      inputEl.value = '';
      markSpotlightDirty(propKey, card);
      showToast('✓ ছবি যোগ সম্পন্ন হয়েছে! উপরে সেভ বাটনে চাপ দিন।');
    }

    // Save Houseboat Property & Rooms
    async function saveHouseboatProperty() {
      const btn = document.getElementById('btn-save-houseboat');
      if (btn) btn.disabled = true;

      try {
        const cardHeadline = document.getElementById('houseboat-card-headline')?.value?.trim();
        const thumbnailImg = document.getElementById('houseboat-thumbnail-img-val')?.value?.trim() || '/uploads/images/obintehasan_pindown_io_1793483591-mvwxtycm.jpg';
        const bengaliTitle = document.getElementById('houseboat-bengali-title')?.value?.trim();
        const englishTitle = document.getElementById('houseboat-english-title')?.value?.trim();
        const price = document.getElementById('houseboat-price')?.value?.trim();
        const img = document.getElementById('houseboat-img-val')?.value || thumbnailImg;
        const video = document.getElementById('houseboat-video-val')?.value?.trim() || '';

        const rooms = extractRoomsFromContainer('houseboat-rooms-list', 'hb');

        const getRes = await fetch('/api/admin/sections/section_spotlight');
        const getData = await getRes.json();
        const currentVal = getData?.value || {};

        const updatedHouseboat = {
          ...(currentVal.houseboat || {}),
          id: 'houseboat',
          cardHeadline: cardHeadline || bengaliTitle,
          bengaliTitle,
          title: englishTitle,
          englishTitle,
          startingPrice: price,
          thumbnailImg,
          heroImg: img,
          heroVideo: video,
          rooms: rooms
        };

        const updatedSpotlight = {
          ...currentVal,
          houseboat: updatedHouseboat
        };

        // 1. Save to section_spotlight
        await fetch('/api/admin/sections/section_spotlight', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(updatedSpotlight)
        });

        // 2. Also save to section_houseboat for 100% backward compatibility
        await fetch('/api/admin/sections/section_houseboat', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(updatedHouseboat)
        });

        showToast(`✓ টাঙ্গুয়ার হাওড় হাউস বোট, হোমপেজ কার্ড এবং ${rooms.length}টি রুম সফলভাবে সেভ হয়েছে!`);
        markSpotlightClean('houseboat');
