    async function saveScheduledTourFromFullEditor() {
      const origDate = document.getElementById('sched-editor-orig-date').value;
      const targetDate = document.getElementById('sched-editor-tour-date').value;
      const tourId = document.getElementById('sched-editor-tour-id').value || `tour-${Date.now()}`;
      const title = document.getElementById('sched-editor-tour-title').value.trim();
      const destination = document.getElementById('sched-editor-tour-destination').value.trim();

      if (!targetDate) {
        alert('ভ্রমণের তারিখ নির্ধারণ করুন!');
        return;
      }
      if (!title) {
        alert('ট্যুরের নাম প্রদান করুন!');
        return;
      }
      if (!destination) {
        alert('গন্তব্যের নাম প্রদান করুন!');
        return;
      }

      const thumbImg = document.getElementById('sched-editor-tour-thumb-val').value.trim() || '/uploads/images/obintehasan_pindown_io_1793483591-mvwxtycm.jpg';
      const heroType = document.getElementById('sched-editor-hero-media-type').value || 'image';
      const heroPhoto = document.getElementById('sched-editor-hero-photo-val').value.trim() || thumbImg;
      const heroVideo = document.getElementById('sched-editor-hero-video-val').value.trim() || '';

      const lead = document.getElementById('sched-editor-tour-lead').value.trim();
      const story = document.getElementById('sched-editor-tour-story').value.trim();

      const when = document.getElementById('sched-editor-tour-when').value.trim() || 'Oct - Mar';
      const whenSub = document.getElementById('sched-editor-tour-whensub').value.trim() || 'Best Season';
      const price = document.getElementById('sched-editor-tour-price').value.trim() || '৳ 18,500 per person';
      const priceSharing = document.getElementById('sched-editor-tour-pricesharing').value.trim() || '(based on 2 ppl sharing)';
      const duration = document.getElementById('sched-editor-tour-howlong').value.trim() || '3 Nights';
      const howLongSub = document.getElementById('sched-editor-tour-howlongsub').value.trim() || 'Ideal length';

      const time = document.getElementById('sched-editor-tour-time').value.trim() || '6:00 AM';
      const seats = document.getElementById('sched-editor-tour-seats').value.trim() || '4 SEATS LEFT';
      const status = document.getElementById('sched-editor-tour-status').value || 'available';

      const tourData = {
        id: tourId,
        title,
        destination,
        img: thumbImg,
        time,
        duration,
        seats,
        status,
        price,
        desc: lead || (currentSchedTourDays[0]?.desc || ''),
        overviewLead: lead,
        overviewStory: story,
        heroMediaType: heroType,
        heroImage: heroPhoto,
        heroVideo,
        when,
        whenSub,
        priceSharing,
        howLong: duration,
        howLongSub,
        days: currentSchedTourDays
      };

      // If editing and date changed: remove from origDate
      if (origDate && origDate !== targetDate) {
        if (adminScheduledTours[origDate]) {
          adminScheduledTours[origDate] = adminScheduledTours[origDate].filter(t => t.id !== tourId);
          if (adminScheduledTours[origDate].length === 0) {
            delete adminScheduledTours[origDate];
          }
        }
      }

      // Add or update in targetDate
      if (!adminScheduledTours[targetDate]) {
        adminScheduledTours[targetDate] = [];
      }

      const existingIdx = adminScheduledTours[targetDate].findIndex(t => t.id === tourId);
      if (existingIdx >= 0) {
        adminScheduledTours[targetDate][existingIdx] = tourData;
      } else {
        adminScheduledTours[targetDate].push(tourData);
      }

      // Update calendar year/month to match target date
      const [ty, tm] = targetDate.split('-');
      adminCalYear = parseInt(ty, 10);
      adminCalMonth = parseInt(tm, 10) - 1;
      adminSelectedDate = targetDate;

      // Close full editor and show calendar view
      closeScheduledTourFullEditor();
      renderAdminCalendar();
      openAdminDateInspector(targetDate);

      // Auto save to DB
      await saveAllScheduledToursToServer(true);
    }

    async function deleteAdminScheduledTour(dateKey, tourId) {
      if (!confirm('আপনি কি নিশ্চিত যে এই ট্যুরটি শিডিউল থেকে মুছে ফেলতে চান?')) {
        return;
      }

      if (adminScheduledTours[dateKey]) {
        adminScheduledTours[dateKey] = adminScheduledTours[dateKey].filter(t => (t.id !== tourId && String(t.id) !== String(tourId)));
        if (adminScheduledTours[dateKey].length === 0) {
          delete adminScheduledTours[dateKey];
        }
      }

      renderAdminCalendar();
      openAdminDateInspector(dateKey);

      await saveAllScheduledToursToServer(true);
    }

    async function saveAllScheduledToursToServer(showNotification = true) {
      const btn = document.getElementById('btn-save-all-schedules');
      if (btn) btn.disabled = true;

      try {
        const res = await fetch('/api/admin/sections/section_tour_schedule', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ tours: adminScheduledTours })
        });
        const result = await res.json();
        if (result.success) {
          if (showNotification) {
            showToast('✓ শিডিউল ট্যুর ক্যালেন্ডার ডাটাবেজে সফলভাবে সংরক্ষিত হয়েছে!');
          }
          return true;
        } else {
          throw new Error(result.error || 'Server save failed');
        }
      } catch (err) {
        console.error('Error saving scheduled tours:', err);
        alert('শিডিউল ট্যুর সেভ করতে সমস্যা হয়েছে: ' + err.message);
        return false;
      } finally {
        if (btn) btn.disabled = false;
      }
    }

