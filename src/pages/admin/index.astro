    // Direct Video Upload Flow (No bulky modal - opens file manager directly)
    let pendingVideoFile = null;

    function triggerDirectVideoUpload() {
      const input = document.getElementById('direct-video-file-input');
      if (input) {
        input.value = '';
        input.click();
      }
    }

    function handleDirectFileSelect(e) {
      const file = e.target.files && e.target.files[0];
      if (!file) return;

      pendingVideoFile = file;

      // Update UI preview bar
      const nameElem = document.getElementById('selected-file-name');
      const sizeElem = document.getElementById('selected-file-size');
      const barElem = document.getElementById('direct-upload-bar');

      if (nameElem) nameElem.textContent = file.name;
      if (sizeElem) {
        const sizeMb = (file.size / (1024 * 1024)).toFixed(1);
        sizeElem.textContent = `${sizeMb} MB • প্রস্তুত (Save-এ ক্লিক করুন)`;
      }
      if (barElem) {
        barElem.style.display = 'flex';
      }
    }

    function cancelDirectUpload() {
      pendingVideoFile = null;
      const input = document.getElementById('direct-video-file-input');
      if (input) input.value = '';
      const barElem = document.getElementById('direct-upload-bar');
      if (barElem) barElem.style.display = 'none';
    }

    function formatCleanTitle(filename) {
      if (!filename) return 'New Hero Video';
      let clean = filename.replace(/\.[^/.]+$/, "").replace(/[-_]+/g, " ").trim();
      return clean.replace(/\b\w/g, l => l.toUpperCase()) || 'New Hero Video';
    }

    async function saveDirectUploadedVideo() {
      if (!pendingVideoFile) return;

      const btnSave = document.getElementById('btn-direct-save');
      const btnText = document.getElementById('btn-direct-save-text');

      if (btnSave) btnSave.disabled = true;
      if (btnText) btnText.textContent = 'Saving...';

      try {
        // 1. Upload video file via /api/admin/upload-video
        const formData = new FormData();
        formData.append('video', pendingVideoFile);
        const upRes = await fetch('/api/admin/upload-video?save=false', {
          method: 'POST',
          body: formData
        });
        const upData = await upRes.json();
        if (!upData.success || !upData.videoUrl) {
          throw new Error(upData.error || 'ভিডিও আপলোড সম্পন্ন হয়নি');
        }

        const finalVideoUrl = upData.videoUrl;
        const finalTitle = formatCleanTitle(pendingVideoFile.name);

        // 2. Fetch current slides and append new slide
        const res = await fetch('/api/admin/slides');
        const data = await res.json();
        const currentSlides = (data && Array.isArray(data.slides)) ? data.slides : [];

        const newSlide = {
          id: `slide-${Date.now()}`,
          title: finalTitle,
          order: currentSlides.length + 1,
          videoUrl: finalVideoUrl,
          active: true,
          createdAt: new Date().toISOString()
        };

        const updatedSlides = [...currentSlides, newSlide];
        await fetch('/api/admin/slides', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ slides: updatedSlides })
        });

        // 3. Append new card to UI
        const container = document.getElementById('hero-videos-container');
        if (container) {
          const newCard = document.createElement('div');
          newCard.className = 'video-card-row';
          newCard.setAttribute('data-id', newSlide.id);
          newCard.setAttribute('data-url', newSlide.videoUrl);
          newCard.innerHTML = `
            <div class="drag-handle" title="Drag to reorder">
              <svg width="14" height="18" viewBox="0 0 24 24" fill="currentColor">
                <circle cx="8" cy="4" r="2"></circle><circle cx="16" cy="4" r="2"></circle>
                <circle cx="8" cy="12" r="2"></circle><circle cx="16" cy="12" r="2"></circle>
                <circle cx="8" cy="20" r="2"></circle><circle cx="16" cy="20" r="2"></circle>
              </svg>
            </div>
            <div class="play-icon-box" title="Video: ${newSlide.videoUrl}">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor">
                <polygon points="5 3 19 12 5 21 5 3"></polygon>
              </svg>
            </div>
            <div class="video-info">
              <div class="video-title">${newSlide.title}</div>
              <div class="video-order">Order ${newSlide.order}</div>
            </div>
            <span class="badge-status badge-active" onclick="toggleSlideActive('${newSlide.id}')" title="Click to toggle status">Active</span>
            <button type="button" class="btn-replace" onclick="openReplaceModal('${newSlide.id}', '${newSlide.title}', '${newSlide.videoUrl}')">Replace</button>
            <button type="button" class="btn-delete-slide" onclick="deleteHeroSlide('${newSlide.id}')" title="Delete video slide">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
              <span>Delete</span>
            </button>
          `;
          container.appendChild(newCard);
        }

        // 4. Clean up and show toast
        cancelDirectUpload();
        showToast('✓ নতুন ভিডিও সফলভাবে সেভ হয়েছে!');
      } catch (err) {
        console.error('Error saving direct video:', err);
        alert('ভিডিও সেভ করতে সমস্যা হয়েছে: ' + err.message);
      } finally {
        if (btnSave) btnSave.disabled = false;
        if (btnText) btnText.textContent = 'Save';
      }
    }

    // Toggle Active / Hidden status in PostgreSQL
    async function toggleSlideActive(slideId) {
      const row = document.querySelector(`.video-card-row[data-id="${slideId}"]`);
      if (!row) return;

      const badge = row.querySelector('.badge-status');
      const isCurrentlyActive = badge.classList.contains('badge-active');
      const nextActive = !isCurrentlyActive;

      // Update UI optimistically
      if (nextActive) {
        badge.classList.remove('badge-hidden');
        badge.classList.add('badge-active');
        badge.textContent = 'Active';
      } else {
        badge.classList.remove('badge-active');
        badge.classList.add('badge-hidden');
        badge.textContent = 'Hidden';
      }

      try {
        // Fetch current slides
        const res = await fetch('/api/admin/slides');
        const data = await res.json();
        if (data && Array.isArray(data.slides)) {
          const updatedSlides = data.slides.map(s => {
            if (s.id === slideId) {
              return { ...s, active: nextActive };
            }
            return s;
          });
          await fetch('/api/admin/slides', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ slides: updatedSlides })
          });
          showToast(nextActive ? '✓ Video set to Active' : '✓ Video set to Hidden');
        }
      } catch (err) {
        console.error('Error toggling status:', err);
        showToast('Status updated locally');
      }
    }

    // Delete Hero Slide from PostgreSQL & UI immediately
    async function deleteHeroSlide(slideId) {
      if (!confirm('আপনি কি এই হিরো ভিডিওটি মুছে ফেলতে চান?')) return;

      const row = document.querySelector(`.video-card-row[data-id="${slideId}"]`);
      
      try {
        const res = await fetch(`/api/admin/slides/${encodeURIComponent(slideId)}`, {
          method: 'DELETE'
        });
        const data = await res.json();

        if (data.success) {
          if (row) row.remove();
          // Update order numbering on remaining rows
          document.querySelectorAll('.video-card-row').forEach((r, idx) => {
            const orderEl = r.querySelector('.video-order');
            if (orderEl) orderEl.textContent = `Order ${idx + 1}`;
          });
          showToast('✓ ভিডিওটি সফলভাবে মুছে ফেলা হয়েছে এবং লাইভ ওয়েবসাইটে আপডেট সম্পন্ন!');
        } else {
          showToast('⚠️ ভিডিও ডিলিট ব্যর্থ হয়েছে: ' + (data.error || 'Server error'));
        }
      } catch (err) {
        console.error('Delete hero slide error:', err);
        showToast('⚠️ ভিডিও ডিলিট করতে সমস্যা হয়েছে: ' + err.message);
      }
    }


    // Replace Video Form Submit
    async function handleReplaceVideoSubmit(e) {
      e.preventDefault();
      const slideId = document.getElementById('replace-slide-id').value;
      const fileInput = document.getElementById('replace-video-file');
      const urlInput = document.getElementById('replace-video-url').value.trim();
      const submitBtn = document.getElementById('btn-submit-replace-video');

      if (!fileInput.files.length && !urlInput) {
        alert('দয়া করে একটি নতুন ভিডিও ফাইল দিন অথবা লিঙ্ক দিন।');
        return;
      }

      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Updating...';
      }

      try {
        let finalVideoUrl = urlInput;
        if (fileInput.files.length > 0) {
          const formData = new FormData();
          formData.append('video', fileInput.files[0]);
          const upRes = await fetch('/api/admin/upload-video?save=false', {
            method: 'POST',
            body: formData
          });
          const upData = await upRes.json();
          if (upData.success && upData.videoUrl) {
            finalVideoUrl = upData.videoUrl;
          } else {
            throw new Error(upData.error || 'Upload failed');
          }
        }

        const res = await fetch('/api/admin/slides');
        const data = await res.json();
        if (data && Array.isArray(data.slides)) {
          const updatedSlides = data.slides.map(s => {
            if (s.id === slideId) {
              return { ...s, videoUrl: finalVideoUrl };
            }
            return s;
          });
          await fetch('/api/admin/slides', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ slides: updatedSlides })
          });

          const row = document.querySelector(`.video-card-row[data-id="${slideId}"]`);
          if (row) {
            row.setAttribute('data-url', finalVideoUrl);
          }
        }

        closeModal('modal-replace-video');
        document.getElementById('form-replace-video').reset();
        showToast('✓ Video replaced & updated successfully!');
      } catch (err) {
        console.error('Error replacing video:', err);
        alert('ভিডিও আপডেট করতে সমস্যা হয়েছে: ' + err.message);
      } finally {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = 'Update Video';
        }
      }
    }

    // Save Brand Letter (Core function called by both Accordion and Full Page)
    async function saveBrandLetterData(title, body) {
      if (!title || !body) {
        alert('দয়া করে শিরোনাম এবং বক্তব্য উভয় ফিল্ড পূরণ করুন।');
        return false;
      }

      const paragraphs = body.split(/\n\s*\n/).map(s => s.trim()).filter(Boolean);

      try {
        const payload = {
          title: title,
          body: body,
          paragraphs: paragraphs
        };

        const res = await fetch('/api/admin/sections/section_intro', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });

        const data = await res.json();
        if (data && data.success) {
          const pageTitle = document.getElementById('page-letter-title');
          const pageBody = document.getElementById('page-letter-body');
          if (pageTitle) pageTitle.value = title;
          if (pageBody) pageBody.value = body;

          showToast('✓ ব্র্যান্ড লেটার সফলভাবে সেভ হয়েছে! হোমপেজে আপডেট সম্পন্ন।');
          return true;
        } else {
          throw new Error(data.error || 'Server error');
        }
      } catch (err) {
        console.error('Save brand letter error:', err);
        alert('ব্র্যান্ড লেটার সেভ করতে সমস্যা হয়েছে: ' + err.message);
        return false;
      }
    }

