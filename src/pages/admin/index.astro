                  onclick="triggerChangeImage('day-photo-upload-${dIdx}')"
                  style="padding: 0.35rem 0.85rem; background: #EFF6FF; color: #2563EB; border: 1px solid #BFDBFE; border-radius: 4px; font-size: 12px; font-weight: 600; cursor: pointer; display: inline-flex; align-items: center; gap: 4px;"
                >
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                  <span>+ Add Photo / ছবি যোগ করুন</span>
                </button>
              </div>

              <!-- Photos Grid -->
              <div style="display: flex; flex-wrap: wrap; gap: 10px; min-height: 75px; background: #FFFFFF; border: 1px dashed #CBD5E1; border-radius: 6px; padding: 8px; align-items: center;">
                ${imagesList.length === 0 ? `
                  <p style="font-size: 12px; color: #94A3B8; margin: 0; padding: 0.5rem;">কোনো ছবি নেই। '+ Add Photo' বাটনে ক্লিক করে এক বা একাধিক ছবি যুক্ত করুন।</p>
                ` : imagesList.map((imgUrl, pIdx) => `
                  <div style="position: relative; width: 95px; height: 70px; border-radius: 6px; overflow: hidden; border: 1px solid #E2E8F0; box-shadow: 0 1px 2px rgba(0,0,0,0.05);">
                    <img src="${imgUrl}" alt="Day Photo" style="width: 100%; height: 100%; object-fit: cover; display: block;" />
                    <button 
                      type="button" 
                      onclick="deleteDayPhoto(${dIdx}, ${pIdx})" 
                      style="position: absolute; top: 3px; right: 3px; width: 18px; height: 18px; border-radius: 50%; background: rgba(220,38,38,0.9); color: #FFF; border: none; font-size: 11px; font-weight: 700; cursor: pointer; display: flex; align-items: center; justify-content: center;"
                      title="Remove this photo"
                    >
                      ✕
                    </button>
                  </div>
                `).join('')}
              </div>
            </div>

            <!-- Optional Extra Metadata -->
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; width: 100%; box-sizing: border-box;">
              <div>
                <label class="form-label" style="font-size: 11px; font-weight: 600; color: #64748B; margin-bottom: 4px; display: block;">🏨 Accommodation / হোটেল বা রিসোর্ট (ঐচ্ছিক)</label>
                <input 
                  type="text" 
                  class="form-input" 
                  value="${d.stay || ''}" 
                  placeholder="যেমন: Resort RungRang — Cloud Suite" 
                  style="width: 100%; font-size: 12.5px; padding: 0.5rem 0.75rem; border: 1px solid #CBD5E1; border-radius: 6px; box-sizing: border-box;"
                  onchange="syncDayField(${dIdx}, 'stay', this.value)"
                />
              </div>
              <div>
                <label class="form-label" style="font-size: 11px; font-weight: 600; color: #64748B; margin-bottom: 4px; display: block;">🍽️ Dining / খাবার ব্যবস্থা (ঐচ্ছিক)</label>
                <input 
                  type="text" 
                  class="form-input" 
                  value="${d.dining || ''}" 
                  placeholder="যেমন: Traditional Bamboo Chicken Dinner" 
                  style="width: 100%; font-size: 12.5px; padding: 0.5rem 0.75rem; border: 1px solid #CBD5E1; border-radius: 6px; box-sizing: border-box;"
                  onchange="syncDayField(${dIdx}, 'dining', this.value)"
                />
              </div>
            </div>
          </div>
        `;
      }).join('');
    }

    // Helper: Sync field in currentTourDays
    function syncDayField(dIdx, field, val) {
      if (currentTourDays[dIdx]) {
        currentTourDays[dIdx][field] = val;
      }
    }

    // Add New Day
    function addDayToCurrentTour() {
      const nextDayNum = currentTourDays.length + 1;
      currentTourDays.push({
        day: `Day ${nextDayNum}`,
        title: '',
        desc: '',
        images: [],
        stay: '',
        dining: ''
      });
      renderEditorDaysList();
    }

    // Delete Day
    function deleteDayFromTour(dIdx) {
      if (!confirm('আপনি কি এই দিনটি মুছে ফেলতে চান?')) return;
      currentTourDays.splice(dIdx, 1);
      renderEditorDaysList();
      showToast('দিনটি মুছে ফেলা হয়েছে।');
    }

    // Upload Photo for a specific Day
    async function handleDayPhotoUpload(e, dIdx) {
      const file = e.target.files && e.target.files[0];
      if (!file) return;

      showToast('ছবি আপলোড হচ্ছে...');
      try {
        const formData = new FormData();
        formData.append('image', file);
        const res = await fetch('/api/admin/upload-image', {
          method: 'POST',
          body: formData
        });
        const data = await res.json();
        const uploadedUrl = data.fileUrl || data.url || data.imageUrl;
        if (data.success && uploadedUrl) {
          if (!currentTourDays[dIdx].images) {
            currentTourDays[dIdx].images = currentTourDays[dIdx].image ? [currentTourDays[dIdx].image] : [];
          }
          currentTourDays[dIdx].images.push(uploadedUrl);
          currentTourDays[dIdx].image = currentTourDays[dIdx].images[0];
          renderEditorDaysList();
          showToast('✓ নতুন ছবি সফলভাবে যুক্ত হয়েছে!');
        } else {
          throw new Error(data.error || 'Upload failed');
        }
      } catch (err) {
        console.error('Day photo upload error:', err);
        alert('ছবি আপলোড করতে সমস্যা হয়েছে: ' + err.message);
      }
    }

    // Delete Photo from a specific Day
    function deleteDayPhoto(dIdx, pIdx) {
      if (!currentTourDays[dIdx]) return;
      let images = Array.isArray(currentTourDays[dIdx].images) 
        ? currentTourDays[dIdx].images 
        : (currentTourDays[dIdx].image ? [currentTourDays[dIdx].image] : []);
      images.splice(pIdx, 1);
      currentTourDays[dIdx].images = images;
      currentTourDays[dIdx].image = images[0] || '';
      renderEditorDaysList();
      showToast('ছবি সরানো হয়েছে।');
    }

    // Save Active Tour Details
    async function saveCurrentTourDetails() {
      if (activeTourIdx < 0) return;

      const title = document.getElementById('editor-tour-title')?.value?.trim();
      const country = document.getElementById('editor-tour-country')?.value?.trim();
      const thumb = document.getElementById('editor-tour-thumb-val')?.value?.trim() || document.getElementById('editor-tour-thumb-preview')?.src;
      const existingTour = exploreTripsList[activeTourIdx] || {};
      const autoSlug = (title || 'tour').toLowerCase().replace(/[^a-z0-9]+/g, '-');
      const link = existingTour.link || `/destinations/${autoSlug}/`;
      const tagline = existingTour.tagline || '';

      const heroMediaType = document.getElementById('editor-hero-media-type')?.value || 'image';
      const heroImage = document.getElementById('editor-hero-photo-val')?.value?.trim() || thumb;
      const heroVideo = document.getElementById('editor-hero-video-val')?.value?.trim();

      const overviewLead = document.getElementById('editor-tour-lead')?.value?.trim();
      const overviewStory = document.getElementById('editor-tour-story')?.value?.trim();

      const when = document.getElementById('editor-tour-when')?.value?.trim();
      const whenSub = document.getElementById('editor-tour-whensub')?.value?.trim();
      const price = document.getElementById('editor-tour-price')?.value?.trim();
      const priceSharing = document.getElementById('editor-tour-pricesharing')?.value?.trim();
      const howLong = document.getElementById('editor-tour-howlong')?.value?.trim();
      const howLongSub = document.getElementById('editor-tour-howlongsub')?.value?.trim();

      if (!title) {
        alert('ট্যুরের নাম খালি রাখা যাবে না।');
        return;
      }

      // Collect updated day values from DOM in case onchange hasn't fired
      const dayCards = document.querySelectorAll('.tour-day-editor-card');
      dayCards.forEach((c, idx) => {
        if (currentTourDays[idx]) {
          const l = c.querySelector('.day-label-input')?.value?.trim();
          const t = c.querySelector('.day-title-input')?.value?.trim();
          const d = c.querySelector('.day-desc-textarea')?.value?.trim();
          if (l) currentTourDays[idx].day = l;
          if (t !== undefined) currentTourDays[idx].title = t;
          if (d !== undefined) currentTourDays[idx].desc = d;
        }
      });

      const updatedTour = {
        ...(exploreTripsList[activeTourIdx] || {}),
        title,
        country: country || 'BANGLADESH',
        tagline: tagline || '',
        link: link || `/destinations/${title.toLowerCase().replace(/[^a-z0-9]+/g, '-')}/`,
        img: thumb,
        heroMediaType,
        heroImage,
        heroVideo: heroMediaType === 'video' ? heroVideo : '',
        desc: overviewLead,
        overviewLead,
        overviewStory: overviewStory || overviewLead,
        when: when || 'All Year Round',
        whenSub: whenSub || 'Best Season',
        price: price || '৳ 4,500 per person',
        priceSharing: priceSharing || '(based on 2 ppl sharing)',
        howLong: howLong || '3 Nights',
        nights: howLong || '3 Nights',
        howLongSub: howLongSub || 'Ideal length',
        days: currentTourDays
      };

      exploreTripsList[activeTourIdx] = updatedTour;

      const btnTop = document.getElementById('btn-save-tour-top');
      const btnBottom = document.getElementById('btn-save-tour-bottom');
      if (btnTop) btnTop.disabled = true;
      if (btnBottom) btnBottom.disabled = true;

      try {
        await persistExploreTripsToDB();
        showToast('✓ সম্পূর্ণ ট্যুর সফলভাবে সেভ হয়েছে এবং লাইভ ওয়েবসাইটে আপডেট সম্পন্ন!');
        refreshExploreTripsGridDOM();
        closeTourDetailEditor();
      } catch (err) {
        console.error('Save tour error:', err);
        alert('ট্যুর সেভ করতে সমস্যা হয়েছে: ' + err.message);
      } finally {
        if (btnTop) btnTop.disabled = false;
        if (btnBottom) btnBottom.disabled = false;
      }
    }

    // Delete Tour Card
    async function deleteTourCard(idx) {
      if (!confirm('আপনি কি এই ট্যুরটি সম্পূর্ণ মুছে ফেলতে চান?')) return;

      exploreTripsList.splice(idx, 1);
      try {
        await persistExploreTripsToDB();
        refreshExploreTripsGridDOM();
        showToast('✓ ট্যুরটি স্থায়ীভাবে মুছে ফেলা হয়েছে এবং লাইভ ওয়েবসাইট আপডেট সম্পন্ন!');
      } catch (err) {
        console.error('Delete tour error:', err);
        showToast('⚠️ ট্যুর মুছতে সমস্যা হয়েছে: ' + err.message);
      }
    }

