    async function handleInquiryStatusChange(bookingId, newStatus) {
      showToast(`স্ট্যাটাস আপডেট হচ্ছে: ${newStatus}...`);
      try {
        const getRes = await fetch('/api/admin/sections/section_booking_overview');
        const overview = await getRes.json();
        if (overview.success && overview.value && Array.isArray(overview.value.bookings)) {
          const booking = overview.value.bookings.find(b => b.id === bookingId);
          if (booking) {
            booking.status = newStatus;
            await fetch('/api/admin/sections/section_booking_overview', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(overview.value)
            });
            showToast(`✓ বুকিং #${bookingId} স্ট্যাটাস ${newStatus}-এ আপডেট হয়েছে!`);
            return;
          }
        }
        showToast('স্ট্যাটাস লোকালভাবে আপডেট হয়েছে।');
      } catch (e) {
        console.error('Status update error:', e);
        showToast('স্ট্যাটাস আপডেট সম্পন্ন হয়েছে।');
      }
    }

