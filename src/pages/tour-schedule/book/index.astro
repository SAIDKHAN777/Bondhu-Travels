        </header>

        <!-- Clean White Form Card (60% White Rule, Exact to User Picture) -->
        <div class="book-form-card" id="book-form-card">
          <form class="book-form" id="tour-booking-form">
            
            <div class="form-fields-grid">
              
              <!-- Full Name -->
              <div class="form-group">
                <label for="input-full-name" class="form-label">
                  FULL NAME <span class="req">*</span>
                </label>
                <input 
                  type="text" 
                  id="input-full-name" 
                  name="customerName" 
                  class="form-control" 
                  placeholder="e.g. Said Khan" 
                  required 
                />
              </div>

              <!-- Number -->
              <div class="form-group">
                <label for="input-phone" class="form-label">
                  NUMBER <span class="req">*</span>
                </label>
                <input 
                  type="tel" 
                  id="input-phone" 
                  name="phone" 
                  class="form-control" 
                  placeholder="e.g. 01700-000000" 
                  required 
                />
              </div>

              <!-- Email Address -->
              <div class="form-group">
                <label for="input-email" class="form-label">
                  EMAIL ADDRESS
                </label>
                <input 
                  type="email" 
                  id="input-email" 
                  name="email" 
                  class="form-control" 
                  placeholder="e.g. said@example.com" 
                />
              </div>

              <!-- Number of Travelers -->
              <div class="form-group">
                <label for="input-travelers" class="form-label">
                  NUMBER OF TRAVELERS <span class="req">*</span>
                </label>
                <input 
                  type="text" 
                  id="input-travelers" 
                  name="travelers" 
                  class="form-control" 
                  placeholder="e.g. 2, 4, or 6 people" 
                  required 
                />
              </div>

              <!-- Departure Date -->
              <div class="form-group">
                <label for="input-departure-date" class="form-label">
                  DEPARTURE DATE <span class="req">*</span>
                </label>
                <input 
                  type="text" 
                  id="input-departure-date" 
                  name="travelDate" 
                  class="form-control dest-input-large" 
                  value={dateParam} 
                  placeholder="e.g. 2026-11-14" 
                  required 
                />
              </div>

              <!-- Selected Tour -->
              <div class="form-group">
                <label for="input-tour-title" class="form-label">
                  SELECTED TOUR <span class="req">*</span>
                </label>
                <input 
                  type="text" 
                  id="input-tour-title" 
                  name="tourTitle" 
                  class="form-control dest-input-large" 
                  value={finalTourTitle} 
                  placeholder="e.g. Sajek Valley Luxury Cloud Resort" 
                  required 
                />
              </div>

              <!-- Notes / Special Requests -->
              <div class="form-group full-span">
                <label for="input-booking-notes" class="form-label">
                  NOTES / SPECIAL REQUESTS
                </label>
                <textarea 
                  id="input-booking-notes" 
                  name="notes" 
                  rows="4" 
                  class="form-textarea" 
                  placeholder="Any special requests, preferred seats, dietary requirements, or room preferences..."
                ></textarea>
              </div>

            </div>

            <!-- Submit Button Row: Solid Black Classic Button -->
            <div class="form-submit-row">
              <button type="submit" class="btn-submit" id="btn-submit-action">
                <span id="btn-submit-text">SUBMIT</span>
              </button>
            </div>

          </form>

          <!-- Clean Success Card -->
