// Match Key from URL
const lookupKey = (destParam || tourParam || '').toLowerCase();
let dest = DESTINATIONS_CATALOG.sajek;

if (lookupKey.includes('bandarban')) {
  dest = DESTINATIONS_CATALOG.bandarban;
} else if (lookupKey.includes('cox') || lookupKey.includes('bazar')) {
  dest = DESTINATIONS_CATALOG.coxsbazar;
} else if (lookupKey.includes('sylhet') || lookupKey.includes('sreemangal')) {
  dest = DESTINATIONS_CATALOG.sylhet;
} else if (lookupKey.includes('tanguar') || lookupKey.includes('haor') || lookupKey.includes('houseboat')) {
  dest = DESTINATIONS_CATALOG.tanguar;
} else if (lookupKey.includes('kuakata')) {
  dest = DESTINATIONS_CATALOG.kuakata;
}

// Custom overrides from DB
try {
  const exploreSetting = await prisma.systemSetting.findUnique({
    where: { key: 'section_explore_trips' }
  });
  if (exploreSetting && Array.isArray(exploreSetting.value?.trips)) {
    const dbTrips = exploreSetting.value.trips;
    const dbMatch = dbTrips.find((t: any) => 
      (t.title && dest.title.toLowerCase().includes(t.title.toLowerCase())) ||
      (t.title && destParam.toLowerCase().includes(t.title.toLowerCase()))
    );
    if (dbMatch) {
      if (dbMatch.heroImage) dest.heroImage = dbMatch.heroImage;
      if (dbMatch.desc) dest.overviewLead = dbMatch.desc;
      if (dbMatch.price) dest.price = dbMatch.price;
      if (dbMatch.nights) dest.howLong = dbMatch.nights;
    }
  }
} catch (e: any) {
  // DB fallback
}

const finalTourTitle = tourParam || dest.fullTitle || dest.title;
---

<BaseLayout 
  title={`${dest.title}: A Luxury Trip to ${dest.country} | Bondhu Travel`} 
  description={dest.overviewLead}
  theme="light"
>
  <Header enquireText="ENQUIRE NOW" enquireLink="#booking-section" />

  <main class="tour-detail-master-page">
    
    <!-- 1. HERO BANNER (Clean high-resolution scenery banner without text overlay) -->
    <section class="section section--hero-banner section--hero-banner--single_image section--hero-banner--full section--hero-banner--image section--hero-banner--fixed">
      <div class="banner__image" style={`background-image: url(${dest.heroImage});`}></div>
    </section>

    <!-- 2. STICKY SUBNAV BAR (Overview, Destination Stop, Booking & Enquiry - Clean without Book Now button) -->
    <section class="section section--subnav" id="subnav-sticky-bar">
      <nav class="section__nav section__nav--scroll" role="navigation">
        <div class="container">
          <div class="row row--flex v-align-center justify-content-center">
            <div class="col col--lg-12 col--md-12 col--sm-12 col--xs-12 d-flex v-align-center justify-content-center p-relative">
              <div class="scroller">
                <ul class="list text-sm-xs letter-spaced-md">
                  <li><a class="anchor-offset text-headings active" href="#overview">Overview</a></li>
                  {dest.stops.map((stop: any) => (
                    <li><a class="anchor-offset text-headings" href={`#${stop.id}`}>{stop.name}</a></li>
                  ))}
                  <li><a class="anchor-offset text-headings" href="#booking-section">Booking & Enquiry</a></li>
                </ul>
              </div>
            </div>
          </div>
        </div>
      </nav>
    </section>

    <!-- 3. EDITORIAL OVERVIEW CONTENT -->
    <section class="section section--content text-base background-custom py- pt-md-sm pb-xl" id="overview" style="background-color: #FFFFFF !important;">
      <div class="container">
        <div class="row">
          <div class="col col--lg-8 col--md-8 col--sm-12 col--xs-12 col--lg-offset-2 col--md-offset-2">
            <h2 class="align-text-center mb-xs font-chronicle section-title-main">
              {finalTourTitle}
            </h2>
            <div class="text-danger strong uppercase text-brand text-md mb-md align-text-center">
              {dest.title} • {dest.country}
            </div>
            <div class="text-base text-lg font-chronicle mb-lg text-editorial-lead align-text-center">
              <p>{dest.overviewLead}</p>
            </div>
            {dest.overviewStory && (
              <div class="text-grey text-md line-height-lg align-text-center overview-story-paragraph">
                <p>{dest.overviewStory}</p>
              </div>
            )}
          </div>
        </div>
      </div>
    </section>

    <!-- 5. DELICATE DIVIDER -->
    <section class="section section--divider mb-md" style="background-color: #FFFFFF !important;">
      <div class="container">
        <div class="row">
          <div class="col col--lg-8 col--md-8 col--lg-offset-2 col--md-offset-2">
            <hr class="luxury-gold-divider" />
          </div>
        </div>
      </div>
    </section>

    <!-- 6. EXPERIENCE FACTS (WHEN, PRICE, HOW LONG) -->
    <section class="section section--experience-facts" style="background-color: #FFFFFF !important;">
      <div class="container">
        <div class="row">
          <div class="col col--lg-8 col--md-8 col--sm-12 col--xs-12 col--lg-offset-2 col--md-offset-2">
            <div class="experience__facts mb-xl">
              <div class="row row--flex justify-content-center">
                <!-- When -->
                <div class="col col--lg-4 col--md-4 col--sm-4 col--xs-12 fact-col-box">
                  <h3 class="text-danger font-heading mb-xs align-text-center fact-header">When</h3>
                  <div class="text-base italic align-text-center fact-value-strong">{formattedDate}</div>
                  <div class="text-base italic align-text-center text-xs-lg fact-sub">{dest.whenSub || 'Guaranteed Departure'}</div>
                </div>

                <!-- Price -->
                <div class="col col--lg-4 col--md-4 col--sm-4 col--xs-12 fact-col-box">
                  <h3 class="text-success font-heading mb-xs align-text-center fact-header">Price</h3>
                  <div class="text-base italic align-text-center fact-value-strong">
                    {dest.price}
                  </div>
                  <div class="align-text-center text-base italic text-xs-lg fact-sub">
                    {dest.priceSharing || '(based on 2 ppl sharing)'}
                  </div>
                </div>

                <!-- How long -->
                <div class="col col--lg-4 col--md-4 col--sm-4 col--xs-12 fact-col-box">
                  <h3 class="text-info font-heading mb-xs align-text-center fact-header">How long</h3>
                  <div class="text-base italic align-text-center fact-value-strong">{dest.howLong}</div>
                  <div class="text-base italic align-text-center text-xs-lg fact-sub">{dest.howLongSub || 'Ideal length'}</div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 7. DESTINATION STOPS & ALTERNATING EXPERIENCE SLIDES -->
    {dest.stops.map((stop: any) => (
      <section class="section section--destination bg-light" id={stop.id}>
        <div class="container py-lg container--turquoise">
          <div class="row relative z-2">
            <div class="col col--lg-12 col--md-12 col--sm-12 col--xs-12">
              <div class="section section--destination__wrapper">
                
                <!-- Destination Stop Header -->
                <div class="section--destination__heading mb-xl">
                  <div class="text-turquoise strong uppercase text-brand text-md mb-xs">{stop.daysTag}</div>
                  <h2 class="font-chronicle stop-heading-title">{stop.name}</h2>
                  <div class="mb-lg max-width-lg mx-none stop-description-para">
                    <p>{stop.description}</p>
                  </div>
                </div>

                <!-- Alternating Experience Slides (Spacious, Luxury Black Tomato Signature Split Cards) -->
                <div class="experience-slides-wrapper">
                  {stop.slides.map((slide: any, slideIdx: number) => (
                    <div class={`flex experience-slide flex-col lg:flex-row ${slideIdx % 2 === 0 ? 'experience-slide--reverse' : ''} experience-slide--turquoise`}>
                      
                      <!-- Slide Media -->
                      <div class="experience-slide__media relative shrink-0 overflow-hidden">
                        <img 
                          src={slide.image} 
                          alt={slide.title} 
                          class="slide-media-element" 
                          loading="lazy" 
                        />
                      </div>

                      <!-- Slide Content Box -->
                      <div class="experience-slide__content bg-white overflow-hidden">
                        <div class="uppercase text-xs strong text-turquoise mb-xs slide-day-tag">{slide.day}</div>
                        <h3 class="slide-title-heading">{slide.title}</h3>
                        <div class="slide-desc-para">
                          <p>{slide.desc}</p>
                        </div>

                        {slide.stay && (
                          <div class="stay-highlight-box">
                            <span class="meta-label-tag">🏨 ACCOMMODATION:</span>
                            <span class="meta-val-text">{slide.stay}</span>
                          </div>
                        )}

                        {slide.dining && (
                          <div class="dining-highlight-box">
                            <span class="meta-label-tag">🍽️ DINING:</span>
                            <span class="meta-val-text">{slide.dining}</span>
                          </div>
                        )}
                      </div>

                    </div>
                  ))}
                </div>

              </div>
            </div>
          </div>
        </div>
      </section>
    ))}

    <!-- 8. THE EXACT CLASSIC BOOKING FORM (AT THE VERY END AS REQUESTED) -->
    <section class="section classic-book-section py-xxl" id="booking-section">
      <div class="book-page-container">
        
        <!-- Clean Classic Section Title & Selected Pill -->
        <header class="book-header-center">
          <h2 class="book-main-title">CONFIRM YOUR BOOKING</h2>
          <div class="book-selected-pill">
            <span class="pill-dot"></span>
