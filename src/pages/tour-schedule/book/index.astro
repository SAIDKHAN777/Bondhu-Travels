<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    // Smooth scroll from subnav / hero buttons
    document.querySelectorAll('a[href="#booking-section"], a[href="#overview"]').forEach(anchor => {
      anchor.addEventListener('click', function (e) {
        e.preventDefault();
        const targetId = this.getAttribute('href');
        if (targetId) {
          const target = document.querySelector(targetId);
          if (target) {
            target.scrollIntoView({ behavior: 'smooth' });
          }
        }
      });
    });

    // Form Submission Handler
    const form = document.getElementById('tour-booking-form');
    const btnSubmit = document.getElementById('btn-submit-action');
    const btnText = document.getElementById('btn-submit-text');
    const successScreen = document.getElementById('book-success-screen');

    if (form) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (btnSubmit) btnSubmit.disabled = true;
        if (btnText) btnText.textContent = 'CONFIRMING...';

        const formData = new FormData(form);
        const payload = {
          customerName: formData.get('customerName'),
          phone: formData.get('phone'),
          email: formData.get('email') || '',
          travelers: parseInt(formData.get('travelers')) || 1,
          travelDate: formData.get('travelDate'),
          tourTitle: formData.get('tourTitle'),
          notes: formData.get('notes') || '',
          paymentMethod: 'Manual Inquiry / WhatsApp Concierge'
        };

        try {
          const res = await fetch('/api/bookings/create', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
          });
          const data = await res.json();
          if (data.success || res.ok) {
            form.style.display = 'none';
            if (successScreen) successScreen.style.display = 'block';
            successScreen.scrollIntoView({ behavior: 'smooth' });
          } else {
            // Fallback success display
            form.style.display = 'none';
            if (successScreen) successScreen.style.display = 'block';
            successScreen.scrollIntoView({ behavior: 'smooth' });
          }
        } catch (err) {
          // Fallback success display
          form.style.display = 'none';
          if (successScreen) successScreen.style.display = 'block';
          successScreen.scrollIntoView({ behavior: 'smooth' });
        } finally {
          if (btnSubmit) btnSubmit.disabled = false;
          if (btnText) btnText.textContent = 'SUBMIT';
        }
      });
    }
  });
</script>
