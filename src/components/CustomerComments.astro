---
// Authentic Black Tomato Customer Testimonials Slider
// 100% Exact match to user screenshot (media_1793349442582_d8bffcc1.png)
interface Review {
  quote: string;
  author: string;
  destination?: string;
}

interface Props {
  reviews?: Review[];
}

const defaultReviews: Review[] = [
  {
    quote: "BLACK TOMATO WILL CHANGE THE WAY YOU TRAVEL",
    author: "Micah, Egypt"
  },
  {
    quote: "GLAMPING, HIKING, ICEBERGS, GOURMET FOOD. NOT SURE HOW MY TRIP COULD HAVE BEEN ANY BETTER",
    author: "Jimmy, Greenland"
  },
  {
    quote: "A DREAM COME TRUE – FROM SMALL RIADS TO A MOUNTAIN FORTRESS AND A DESERT OASIS. BLACK TOMATO DELIVERED",
    author: "Kim, Morocco"
  },
  {
    quote: "HIGHLY RECOMMEND BLACK TOMATO’S HELP IN PLANNING AN ADVENTUROUS FAMILY-FRIENDLY HOLIDAY",
    author: "Susan, Sweden"
  },
  {
    quote: "HANDS DOWN IT WAS THE MOST AMAZING EXPERIENCE OUR FAMILY HAS EVER DONE",
    author: "Brett, Middle East"
  },
  {
    quote: "WE HAVE EXPLORED SOME INCREDIBLE PLACES AND HAD UNIQUE ADVENTURES THAT COULD HAVE ONLY BEEN MADE POSSIBLE WITH BLACK TOMATO’S GUIDANCE",
    author: "Ike and Alexa, Italy"
  },
  {
    quote: "WONDERFUL, WONDERFUL, WONDERFUL. BLACK TOMATO IS TOP NOTCH – YOU WILL NOT BE DISAPPOINTED",
    author: "Wendy, Morocco"
  },
  {
    quote: "BLACK TOMATO DELIVERED A ONCE IN A LIFETIME EXPERIENCE THAT MY FAMILY AND I WILL FOREVER CHERISH",
    author: "Adrienne, Italy"
  }
];

const {
  reviews = defaultReviews
} = Astro.props;

const activeReviews = reviews && reviews.length > 0 ? reviews : defaultReviews;
---

<div class="client-comments-carousel" id="client-comments-carousel">
  <!-- Slider Controls & Viewport -->
  <div class="slider-outer-container">
    <!-- Prev Arrow Button -->
    <button class="carousel-nav-btn prev-btn" id="comments-prev" aria-label="Previous testimonials">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="15 18 9 12 15 6"></polyline>
      </svg>
    </button>

    <!-- Scroll Viewport -->
    <div class="comments-viewport" id="comments-viewport">
      <div class="comments-track" id="comments-track">
        {activeReviews.map((r, i) => (
          <article class="comment-item" data-index={i}>
            <!-- Green Quotation Icon (Exact match to screenshot) -->
            <div class="quote-icon-box">
              <svg class="icon--success" width="16" height="13" viewBox="0 0 14 11" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M10.6117 10.44C12.0467 10.44 13.1317 9.39 13.1317 8.095C13.1317 6.8 12.0467 5.785 10.7867 5.785C10.1917 5.785 9.73673 5.96 9.70173 5.96C9.73673 3.51 11.6967 2.005 12.0817 1.69C12.3267 1.48 12.3967 1.13 12.1867 0.885L11.6617 0.395C11.4167 0.114999 11.1367 0.149999 10.8567 0.359998C9.94673 1.165 7.70673 3.3 7.70673 6.695C7.70673 9.565 9.35173 10.44 10.6117 10.44ZM3.85673 10.44C5.29173 10.44 6.37673 9.39 6.37673 8.095C6.37673 6.8 5.29173 5.785 4.03173 5.785C3.43673 5.785 3.01673 5.96 2.94673 5.96C2.98173 3.51 4.94173 2.005 5.32673 1.69C5.60673 1.48 5.64173 1.13 5.43173 0.885L4.90673 0.395C4.66173 0.114999 4.41673 0.149999 4.13673 0.359998C3.22673 1.165 0.986729 3.3 0.986729 6.695C0.986729 9.565 2.59673 10.44 3.85673 10.44Z" fill="#10B981"/>
              </svg>
            </div>

            <!-- Uppercase Quote Text (Exact Typography) -->
            <div class="quote-text-wrap">
              <p class="comment-quote-text">{r.quote}</p>
            </div>

            <!-- Green Italic Author -->
            <p class="comment-author-text">
              <em>{r.author}{r.destination ? `, ${r.destination}` : ''}</em>
            </p>
          </article>
        ))}
      </div>
    </div>

    <!-- Next Arrow Button -->
    <button class="carousel-nav-btn next-btn" id="comments-next" aria-label="Next testimonials">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="9 18 15 12 9 6"></polyline>
      </svg>
    </button>
  </div>

  <!-- Pagination Indicators -->
  <div class="carousel-dots-wrap" id="comments-dots">
    {activeReviews.map((_, idx) => (
      <button class={`dot-pill ${idx === 0 ? 'is-active' : ''}`} data-dot-index={idx} aria-label={`Go to slide ${idx + 1}`}></button>
    ))}
  </div>
</div>

<style>
  .client-comments-carousel {
    width: 100%;
    margin-top: 3.5rem;
    padding-top: 3.5rem;
    border-top: 1px solid #F1F5F9;
    position: relative;
  }

  .slider-outer-container {
    max-width: 1360px;
    margin: 0 auto;
    position: relative;
    display: flex;
    align-items: center;
  }

  /* Viewport with hardware accelerated scrolling */
  .comments-viewport {
    width: 100%;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    cursor: grab;
    user-select: none;
    padding: 0.5rem 0.25rem;
  }

  .comments-viewport::-webkit-scrollbar {
    display: none;
  }

  .comments-viewport.is-dragging {
    cursor: grabbing;
    scroll-behavior: auto;
  }

  /* Track layout: 4 items visible across desktop (Exact match to screenshot 2) */
  .comments-track {
    display: flex;
    gap: 2.75rem;
    align-items: flex-start;
    padding: 0 0.5rem;
    transition: transform 0.4s ease;
  }

  /* Individual Comment Slide */
  .comment-item {
    flex: 0 0 calc((100% - (3 * 2.75rem)) / 4);
    min-width: 250px;
    max-width: 320px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    box-sizing: border-box;
    scroll-snap-align: start;
    transition: transform 0.3s ease, opacity 0.3s ease;
  }

  /* Green Quote Icon (Exact match to screenshot 2) */
  .quote-icon-box {
    margin-bottom: 1.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 18px;
  }

  .icon--success {
    display: block;
    width: 16px;
    height: 13px;
  }

  /* Uppercase Quote Text (Exact Typography) */
  .quote-text-wrap {
    min-height: 85px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1rem;
    width: 100%;
  }

  .comment-quote-text {
    font-family: 'Brandon Grotesque', 'Cabin', 'Josefin Sans', -apple-system, sans-serif;
    font-size: 0.95rem;
    font-weight: 500;
    line-height: 1.55;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #64748B;
    margin: 0;
  }

  /* Green Italic Author */
  .comment-author-text {
    font-family: 'Brandon Grotesque', 'Cabin', 'Josefin Sans', sans-serif;
    font-size: 0.9rem;
    font-style: italic;
    color: #059669;
    font-weight: 500;
    letter-spacing: 0.04em;
    margin: 0;
  }

  /* Floating Modern Nav Arrows */
  .carousel-nav-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: #FFFFFF;
    border: 1px solid #E2E8F0;
    color: #0F172A;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 10;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.08);
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .carousel-nav-btn:hover {
    background: #0F172A;
    color: #FFFFFF;
    border-color: #0F172A;
    transform: translateY(-50%) scale(1.08);
  }

  .prev-btn {
    left: -20px;
  }

  .next-btn {
    right: -20px;
  }

  /* Dots indicator */
  .carousel-dots-wrap {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 8px;
    margin-top: 3rem;
  }

  .dot-pill {
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: #CBD5E1;
    border: none;
    padding: 0;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .dot-pill.is-active {
    width: 24px;
    background: #10B981;
  }

  /* Responsive Design */
  @media (max-width: 1200px) {
    .comment-item {
      flex: 0 0 calc((100% - (2 * 2rem)) / 3);
      max-width: none;
    }
    .comments-track {
      gap: 2rem;
    }
    .prev-btn { left: -10px; }
    .next-btn { right: -10px; }
  }

  @media (max-width: 900px) {
    .comment-item {
      flex: 0 0 calc((100% - 1.5rem) / 2);
    }
    .comments-track {
      gap: 1.5rem;
    }
  }

  @media (max-width: 600px) {
    .comment-item {
      flex: 0 0 100%;
      min-width: 100%;
    }
    .comments-track {
      gap: 1rem;
    }
    .carousel-nav-btn {
      width: 36px;
      height: 36px;
    }
    .prev-btn { left: 4px; }
    .next-btn { right: 4px; }
  }
</style>

<script>
  function initCommentsCarousel() {
    const viewport = document.getElementById('comments-viewport');
    const track = document.getElementById('comments-track');
    const prevBtn = document.getElementById('comments-prev');
    const nextBtn = document.getElementById('comments-next');
    const dotsWrap = document.getElementById('comments-dots');

    if (!viewport || !track) return;

    const items = track.querySelectorAll('.comment-item');
    if (!items.length) return;

    function getScrollStep() {
      const firstItem = items[0] as HTMLElement;
      if (!firstItem) return 300;
      const style = window.getComputedStyle(track);
      const gap = parseFloat(style.gap) || 32;
      return firstItem.offsetWidth + gap;
    }

    // Scroll forward (Slides next comments in from the right)
    function scrollNext() {
      const step = getScrollStep();
      const maxScroll = viewport.scrollWidth - viewport.clientWidth;
      if (viewport.scrollLeft >= maxScroll - 10) {
        viewport.scrollTo({ left: 0, behavior: 'smooth' });
      } else {
        viewport.scrollBy({ left: step, behavior: 'smooth' });
      }
    }

    // Scroll backward
    function scrollPrev() {
      const step = getScrollStep();
      if (viewport.scrollLeft <= 10) {
        viewport.scrollTo({ left: viewport.scrollWidth, behavior: 'smooth' });
      } else {
        viewport.scrollBy({ left: -step, behavior: 'smooth' });
      }
    }

    if (nextBtn) nextBtn.addEventListener('click', scrollNext);
    if (prevBtn) prevBtn.addEventListener('click', scrollPrev);

    // Update active dot on scroll
    function updateDots() {
      if (!dotsWrap) return;
      const step = getScrollStep();
      const currentIdx = Math.round(viewport.scrollLeft / step);
      const dots = dotsWrap.querySelectorAll('.dot-pill');
      dots.forEach((dot, idx) => {
        if (idx === currentIdx % items.length) {
          dot.classList.add('is-active');
        } else {
          dot.classList.remove('is-active');
        }
      });
    }

    viewport.addEventListener('scroll', updateDots, { passive: true });

    // Allow clicking on dots
    if (dotsWrap) {
      dotsWrap.querySelectorAll('.dot-pill').forEach((dot, idx) => {
        dot.addEventListener('click', () => {
          const step = getScrollStep();
          viewport.scrollTo({ left: idx * step, behavior: 'smooth' });
        });
      });
    }

    // Touch & Mouse Drag to slide
    let isDown = false;
    let startX = 0;
    let scrollLeft = 0;

    viewport.addEventListener('mousedown', (e) => {
      isDown = true;
      viewport.classList.add('is-dragging');
      startX = e.pageX - viewport.offsetLeft;
      scrollLeft = viewport.scrollLeft;
    });

    viewport.addEventListener('mouseleave', () => {
      isDown = false;
      viewport.classList.remove('is-dragging');
    });

    viewport.addEventListener('mouseup', () => {
      isDown = false;
      viewport.classList.remove('is-dragging');
    });

    viewport.addEventListener('mousemove', (e) => {
      if (!isDown) return;
      e.preventDefault();
      const x = e.pageX - viewport.offsetLeft;
      const walk = (x - startX) * 1.5;
      viewport.scrollLeft = scrollLeft - walk;
    });

    // Gentle Auto-Slide every 6 seconds (pauses when hovering)
    let autoSlideInterval = setInterval(scrollNext, 6000);
    const container = document.getElementById('client-comments-carousel');
    if (container) {
      container.addEventListener('mouseenter', () => clearInterval(autoSlideInterval));
      container.addEventListener('mouseleave', () => {
        clearInterval(autoSlideInterval);
        autoSlideInterval = setInterval(scrollNext, 6000);
      });
    }
  }

  // Initialize on load and on Astro page transitions
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCommentsCarousel);
  } else {
    initCommentsCarousel();
  }
  document.addEventListener('astro:page-load', initCommentsCarousel);
</script>
