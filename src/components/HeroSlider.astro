---
export interface Slide {
  id?: string;
  title: string;
  tagline?: string;
  videoUrl: string;
  poster?: string;
  btnText?: string;
  btnLink?: string;
  buttonText?: string;
  buttonLink?: string;
  secondaryBtnText?: string;
  secondaryBtnLink?: string;
  active?: boolean;
}

interface Props {
  slides?: Slide[];
}

const defaultSlides: Slide[] = [
  {
    id: "slide-coxs-bazar",
    title: "Coxs Bazar Sunset Odyssey",
    tagline: "LONGEST NATURAL SEA BEACH & OCEAN SUNSET",
    videoUrl: "/uploads/videos/coxs_bazar_sunset_odyssey.mp4",
    poster: "/2024/04/Website-Homepage-V9.00_00_00_00.Still002.jpg",
    btnText: "Explore Cox's Bazar",
    btnLink: "/destinations/coxs-bazar/",
    active: true
  },
  {
    id: "slide-sunamganj",
    title: "sunamganj short 16x10",
    tagline: "PRISTINE TANGUAR HAOR & STARLIT CRUISES",
    videoUrl: "/uploads/videos/sunamganj_short_16x10-mvwdaq9p.mp4",
    poster: "/2024/04/Website-Homepage-V9.00_00_00_00.Still002.jpg",
    btnText: "Explore Haor",
    btnLink: "/destinations/sylhet/",
    active: true
  },
  {
    id: "slide-bandarban",
    title: "bandarban short 16x10 no logo 1",
    tagline: "ANCIENT MOUNTAINS & SACRED TRAILS",
    videoUrl: "/uploads/videos/bandarban_short_16x10_no_logo__1_-mvwdic7l.mp4",
    poster: "/2024/02/Atlas-mountains-morocco-landscape.jpg",
    btnText: "Explore Bandarban",
    btnLink: "/destinations/bandarban/",
    active: true
  },
  {
    id: "slide-sajek",
    title: "sajek cut 2-5s",
    tagline: "KINGDOM OF CLOUDS & LUXURY RESORTS",
    videoUrl: "/uploads/videos/sajek_cut_2-5s-mvwdk5om.mp4",
    poster: "/2022/09/Utah-adventure-2-1-scaled.jpg",
    btnText: "Explore Sajek",
    btnLink: "/destinations/sajek/",
    active: true
  }
];

const { slides = defaultSlides } = Astro.props;
const activeSlides = slides.filter(s => s.active !== false);
---

<section class="hero-container" id="hero-slider" aria-label="Hero Video Carousel">
  <div class="slides-viewport">
    {activeSlides.map((slide, idx) => (
      <div 
        class={`hero-slide ${idx === 0 ? 'is-active' : ''}`}
        data-slide-index={idx}
        data-slide-title={slide.title}
      >
        <video 
          class="hero-video" 
          muted 
          playsinline 
          preload={idx === 0 ? "auto" : "metadata"}
          poster={slide.poster || ""}
        >
          <source src={slide.videoUrl} type={slide.videoUrl.endsWith('.webm') ? 'video/webm' : 'video/mp4'} />
        </video>

        <!-- Subtle Top Ambient Vignette for Header Contrast (Video remains 100% clean and unobstructed) -->
        <div class="hero-overlay"></div>
      </div>
    ))}
  </div>

  <!-- Bottom Navigation & Indicators (Displayed only when multiple slides exist) -->
  {activeSlides.length > 1 && (
    <div class="hero-controls">
      <div class="hero-indicators">
        {activeSlides.map((slide, idx) => (
          <button 
            type="button" 
            class={`indicator-bar ${idx === 0 ? 'is-active' : ''}`} 
            data-target-index={idx}
            aria-label={`Jump to slide ${idx + 1}: ${slide.title}`}
          >
            <span class="indicator-progress"></span>
          </button>
        ))}
      </div>

      <div class="hero-arrows">
        <button type="button" class="arrow-btn" id="hero-prev-btn" aria-label="Previous Slide">
          ‹
        </button>
        <button type="button" class="arrow-btn" id="hero-next-btn" aria-label="Next Slide">
          ›
        </button>
      </div>
    </div>
  )}
</section>

<style>
  .hero-container {
    position: relative;
    width: 100vw;
    height: calc(100vh - 85px);
    min-height: 520px;
    max-height: 860px;
    overflow: hidden;
    background-color: #070A0E;
  }

  .slides-viewport {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .hero-slide {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 1.0s cubic-bezier(0.16, 1, 0.3, 1), visibility 1.0s;
    z-index: 1;
    display: flex;
    align-items: center;
  }

  .hero-slide.is-active {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    z-index: 2;
  }

  .hero-video {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
    transform: translateZ(0);
    -webkit-transform: translateZ(0);
    will-change: transform;
    backface-visibility: hidden;
  }

  .hero-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(180deg, rgba(7, 10, 14, 0.32) 0%, rgba(7, 10, 14, 0.05) 18%, transparent 40%);
    pointer-events: none;
    z-index: 2;
  }

  .hero-content-wrapper {
    position: relative;
    z-index: 5;
    width: 100%;
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 2.5rem;
  }

  .hero-content {
    max-width: 820px;
  }

  .hero-tagline {
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: #E82E72;
    margin-bottom: 1rem;
  }

  .hero-title {
    font-family: 'Chronicle Display', serif;
    font-size: 4rem;
    line-height: 1.1;
    color: #FFFFFF;
    margin-bottom: 2rem;
    letter-spacing: -0.01em;
    font-weight: 400;
  }

  .hero-cta-group {
    display: flex;
    gap: 1.25rem;
    align-items: center;
    flex-wrap: wrap;
  }

  .btn-hero {
    display: inline-block;
    padding: 0.9rem 2.2rem;
    font-size: 0.875rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    font-weight: 600;
    border-radius: 999px;
    text-decoration: none;
    transition: all 0.25s ease;
  }

  .btn-hero--primary {
    background: #E82E72;
    color: #FFFFFF;
    border: 1px solid #E82E72;
    box-shadow: 0 4px 20px rgba(232, 46, 114, 0.35);
  }

  .btn-hero--primary:hover {
    background: #D02060;
    border-color: #D02060;
    transform: translateY(-2px);
  }

  .btn-hero--secondary {
    background: rgba(255, 255, 255, 0.08);
    color: #FFFFFF;
    border: 1px solid rgba(255, 255, 255, 0.35);
    backdrop-filter: blur(8px);
  }

  .btn-hero--secondary:hover {
    background: rgba(255, 255, 255, 0.2);
    border-color: #FFFFFF;
  }

  .hero-controls {
    position: absolute;
    bottom: 3rem;
    left: 0;
    width: 100%;
    z-index: 10;
    max-width: 1440px;
    left: 50%;
    transform: translateX(-50%);
    padding: 0 2.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .hero-indicators {
    display: flex;
    gap: 0.75rem;
    align-items: center;
  }

  .indicator-bar {
    width: 44px;
    height: 4px;
    background: rgba(255, 255, 255, 0.25);
    border: none;
    border-radius: 2px;
    cursor: pointer;
    padding: 0;
    overflow: hidden;
    position: relative;
    transition: background 0.3s, width 0.3s;
  }

  .indicator-bar.is-active {
    width: 68px;
    background: #E82E72;
  }

  .hero-arrows {
    display: flex;
    gap: 0.75rem;
  }

  .arrow-btn {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: rgba(15, 23, 36, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: #FFF;
    font-size: 1.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    backdrop-filter: blur(8px);
    transition: all 0.2s;
  }

  .arrow-btn:hover {
    background: #E82E72;
    border-color: #E82E72;
  }

  @media (max-width: 768px) {
    .hero-title {
      font-size: 2.5rem;
    }
    .hero-container {
      height: calc(100vh - 75px);
      min-height: 480px;
    }
    .btn-hero {
      padding: 0.75rem 1.5rem;
      width: 100%;
      text-align: center;
    }
  }
</style>

<script>
  // Ultra-Smooth 60fps Native Sequential Video Controller
  function initHeroSlider() {
    const slides = Array.from(document.querySelectorAll('.hero-slide')) as HTMLElement[];
    const indicators = Array.from(document.querySelectorAll('.indicator-bar')) as HTMLElement[];
    const prevBtn = document.getElementById('hero-prev-btn');
    const nextBtn = document.getElementById('hero-next-btn');

    if (slides.length === 0) return;

    let currentIndex = 0;
    let isTransitioning = false;

    function playVideoAt(index: number) {
      currentIndex = index;

      slides.forEach((slide, idx) => {
        const video = slide.querySelector('video') as HTMLVideoElement | null;
        if (!video) return;

        if (idx === index) {
          slide.classList.add('is-active');
          video.currentTime = 0;
          const playPromise = video.play();
          if (playPromise !== undefined) {
            playPromise.catch(() => {
              // Browser autoplay policy graceful fallback
              video.muted = true;
              video.play().catch(() => {});
            });
          }
        } else {
          slide.classList.remove('is-active');
          video.pause();
          video.currentTime = 0;
        }
      });

      // Preload next video so transition is instant with zero buffering
      if (slides.length > 1) {
        const nextIndex = (index + 1) % slides.length;
        const nextVid = slides[nextIndex]?.querySelector('video') as HTMLVideoElement | null;
        if (nextVid && nextVid.preload !== 'auto') {
          nextVid.preload = 'auto';
        }
      }

      // Update indicator bars
      indicators.forEach((ind, idx) => {
        if (idx === index) {
          ind.classList.add('is-active');
        } else {
          ind.classList.remove('is-active');
        }
      });
    }

    function goToSlide(newIndex: number) {
      if (isTransitioning) return;
      isTransitioning = true;
      currentIndex = (newIndex + slides.length) % slides.length;
      playVideoAt(currentIndex);
      setTimeout(() => { isTransitioning = false; }, 600);
    }

    // Attach 'ended' listener and timeupdate check to every video
    slides.forEach((slide, idx) => {
      const video = slide.querySelector('video') as HTMLVideoElement | null;
      if (video) {
        // 1. Natural video end transition
        video.addEventListener('ended', () => {
          if (idx === currentIndex) {
            goToSlide(idx + 1);
          }
        });

        // 2. Fail-safe timeupdate: triggers right when reaching the end
        video.addEventListener('timeupdate', () => {
          if (idx === currentIndex && !isTransitioning && video.duration > 0.5) {
            if (video.currentTime >= video.duration - 0.25) {
              goToSlide(idx + 1);
            }
          }
        });

        // 3. Fallback on video error: advance to next slide instead of stalling
        video.addEventListener('error', () => {
          if (idx === currentIndex) {
            console.warn(`Video #${idx + 1} error, skipping to next...`);
            setTimeout(() => goToSlide(idx + 1), 1000);
          }
        });
      }
    });

    // Indicator bar clicks
    indicators.forEach((bar, idx) => {
      bar.addEventListener('click', () => goToSlide(idx));
    });

    // Arrow controls
    if (prevBtn) prevBtn.addEventListener('click', () => goToSlide(currentIndex - 1));
    if (nextBtn) nextBtn.addEventListener('click', () => goToSlide(currentIndex + 1));

    // Start with Slide 0
    playVideoAt(0);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHeroSlider);
  } else {
    initHeroSlider();
  }
  document.addEventListener('astro:page-load', initHeroSlider);
</script>
