<script>
  function initFooterAuth() {
    const createBtn = document.getElementById('footer-btn-create');
    const signinBtn = document.getElementById('footer-btn-signin');
    const nameInput = document.getElementById('footer-auth-name') as HTMLInputElement | null;
    const emailInput = document.getElementById('footer-auth-email') as HTMLInputElement | null;
    const toast = document.getElementById('footer-auth-toast');

    function isValidEmail(val: string) {
      return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(val);
    }

    // Immediately remove red highlight when user interacts or types in the field
    [nameInput, emailInput].forEach(inp => {
      if (inp) {
        inp.addEventListener('input', () => {
          inp.classList.remove('field-error-red');
        });
        inp.addEventListener('focus', () => {
          inp.classList.remove('field-error-red');
        });
      }
    });

    function showSuccessToast(msg: string) {
      if (!toast) return;
      toast.innerText = msg;
      toast.className = 'footer-auth-toast success';
      toast.style.display = 'block';
      setTimeout(() => {
        if (toast) toast.style.display = 'none';
      }, 4000);
    }

    // CREATE ACCOUNT Click: Validate fields, turn missing/invalid boxes RED, no error banner text!
    if (createBtn) {
      createBtn.addEventListener('click', () => {
        const nameVal = nameInput?.value.trim() || '';
        const emailVal = emailInput?.value.trim() || '';

        let hasError = false;

        // If Name is empty, highlight name input red
        if (!nameVal) {
          nameInput?.classList.add('field-error-red');
          hasError = true;
        }

        // If Email is empty or invalid, highlight email input red
        if (!emailVal || !isValidEmail(emailVal)) {
          emailInput?.classList.add('field-error-red');
          hasError = true;
        }

        // If error exists, focus the first red box and STOP. Absolutely NO error banner message!
        if (hasError) {
          if (!nameVal && nameInput) {
            nameInput.focus();
          } else if (emailInput) {
            emailInput.focus();
          }
          return;
        }

        // Success - Save profile and auto-login with authentic Google Profile photo
        const realGoogleAvatar = "/uploads/users/said_google_avatar.png";
        const profile = {
          name: nameVal || "Said Khan",
          email: emailVal,
          avatar: (emailVal.toLowerCase().includes('said') || !emailVal) 
            ? realGoogleAvatar 
            : `https://ui-avatars.com/api/?name=${encodeURIComponent(nameVal || 'User')}&background=1A73E8&color=fff&size=128&bold=true`
        };

        localStorage.setItem('bt_user_profile', JSON.stringify(profile));
        window.dispatchEvent(new Event('bt_auth_changed'));

        if (nameInput) nameInput.value = '';
        if (emailInput) emailInput.value = '';

        showSuccessToast(`🎉 স্বাগতম ${profile.name}! আপনার অ্যাকাউন্ট সফলভাবে তৈরি হয়েছে।`);
      });
    }

    // SIGN IN Click: Validate email, turn invalid box RED, no error banner text!
    if (signinBtn) {
      signinBtn.addEventListener('click', () => {
        const nameVal = nameInput?.value.trim() || '';
        const emailVal = emailInput?.value.trim() || '';

        // For sign-in, email is required and must be valid
        if (!emailVal || !isValidEmail(emailVal)) {
          emailInput?.classList.add('field-error-red');
          emailInput?.focus();
          return;
        }

        const realGoogleAvatar = "/uploads/users/said_google_avatar.png";
        const profile = {
          name: nameVal || (emailVal.toLowerCase().includes('said') ? "Said Khan" : emailVal.split('@')[0]),
          email: emailVal,
          avatar: (emailVal.toLowerCase().includes('said') || !emailVal)
            ? realGoogleAvatar
            : `https://ui-avatars.com/api/?name=${encodeURIComponent(nameVal || emailVal.split('@')[0])}&background=1A73E8&color=fff&size=128&bold=true`
        };

        localStorage.setItem('bt_user_profile', JSON.stringify(profile));
        window.dispatchEvent(new Event('bt_auth_changed'));

        if (nameInput) nameInput.value = '';
        if (emailInput) emailInput.value = '';

        showSuccessToast(`✅ স্বাগতম ${profile.name}! আপনি সফলভাবে সাইন ইন করেছেন।`);
      });
    }

    // Smooth scroll for footer "Home" link if on the homepage
    document.querySelectorAll('.footer-column a').forEach((link) => {
      const text = link.textContent?.trim().toLowerCase();
      const href = link.getAttribute('href');
      if (text === 'home' || href === '/') {
        link.addEventListener('click', (e) => {
          if (window.location.pathname === '/' || window.location.pathname === '') {
            e.preventDefault();
            window.scrollTo({ top: 0, behavior: 'smooth' });
          }
        });
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initFooterAuth);
  } else {
    initFooterAuth();
  }
  document.addEventListener('astro:page-load', initFooterAuth);
</script>
