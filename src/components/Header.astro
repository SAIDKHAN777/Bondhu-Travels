<script>
  // Tour Plans & Destinations Search Database (Dynamically synced with Explore Our Trips)
  function getExploreSearchDatabase() {
    const dataTag = document.getElementById('header-explore-trips-data');
    let dbTrips: any[] = [];
    try {
      if (dataTag && dataTag.textContent) {
        dbTrips = JSON.parse(dataTag.textContent);
      }
    } catch (e) {
      console.warn('Could not parse explore trips in header search:', e);
    }

    function getTripBnName(title: string) {
      const l = (title || '').toLowerCase();
      if (l.includes('sajek')) return 'সাজেক ভ্যালি';
      if (l.includes('bandarban')) return 'বান্দরবান';
      if (l.includes('cox')) return 'কক্সবাজার';
      if (l.includes('sylhet')) return 'সিলেট ও হাওর';
      if (l.includes('sundarban')) return 'সুন্দরবন';
      if (l.includes('kuakata')) return 'কুয়াকাটা';
      return '';
    }

    function getTripEmoji(title: string) {
      const l = (title || '').toLowerCase();
      if (l.includes('sajek')) return '☁️';
      if (l.includes('bandarban')) return '🏔️';
      if (l.includes('cox')) return '🌊';
      if (l.includes('sylhet')) return '🍃';
      if (l.includes('sundarban')) return '🐅';
      if (l.includes('kuakata')) return '🌅';
      return '✨';
    }

    function getTripDirectLink(t: any) {
      if (t.link && t.link.startsWith('/destinations/')) {
        return t.link;
      }
      const slug = (t.title || '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
      return slug ? `/destinations/${slug}/` : '/destinations/new-luxury-tour/';
    }

    // 1. Process Explore Our Trips from Database (Primary Recommendations)
    const exploreTripsFormatted = (Array.isArray(dbTrips) && dbTrips.length > 0)
      ? dbTrips.map((t: any) => {
          const bnName = getTripBnName(t.title);
          const emoji = getTripEmoji(t.title);
          const link = getTripDirectLink(t);
          return {
            name: t.title,
            bnName,
            emoji,
            title: t.title,
            tagline: t.tagline || t.desc || 'An unforgettable curated private journey',
            nights: t.nights || t.howLong || '3 NIGHTS',
            region: t.country || 'BANGLADESH',
            price: t.price ? (t.price.includes('৳') || t.price.includes('Tk') || t.price.includes('£') ? t.price : `৳ ${t.price}`) : 'ইনকোয়ারি করুন',
            img: t.img || t.heroImage || t.image || '/2024/04/Website-Homepage-V9.00_00_00_00.Still002.jpg',
            link,
            isExploreTrip: true,
            keywords: [
              t.title,
              bnName,
              t.country,
              t.tagline,
              t.desc,
              t.nights,
              'explore our trips',
              'ট্যুর'
            ].filter(Boolean)
          };
        })
      : [];

    // Fallback defaults if DB is temporarily empty
    if (exploreTripsFormatted.length === 0) {
      exploreTripsFormatted.push(
        {
          name: "Sajek",
          bnName: "সাজেক ভ্যালি",
          emoji: "☁️",
          title: "Sajek",
          tagline: "An unforgettable curated private journey",
          nights: "3 NIGHTS",
          region: "BANGLADESH",
          price: "৳ 4,500 per person",
          img: "/uploads/images/obintehasan_pindown_io_1793483591-mvwxtycm.jpg",
          link: "/destinations/sajek/",
          isExploreTrip: true,
          keywords: ["sajek", "সাজেক", "sajek valley", "সাজেক ভ্যালি", "মেঘ", "cloud", "খাগড়াছড়ি", "কংলাক"]
        },
        {
          name: "Bandarban",
          bnName: "বান্দরবান",
          emoji: "🏔️",
          title: "Bandarban",
          tagline: "An unforgettable curated private journey",
          nights: "4 NIGHTS",
          region: "BANGLADESH",
          price: "৳ 4,500 per person",
          img: "/uploads/images/From_Klickpin_com-_Copy_this_guide_to_elegant_herb-mvwx285b.jpg",
          link: "/destinations/bandarban/",
          isExploreTrip: true,
          keywords: ["bandarban", "বান্দরবান", "nilgiri", "নীলগিরি", "hill tracts", "পাহাড়", "বগালেক"]
        },
        {
          name: "Cox's bazar",
          bnName: "কক্সবাজার",
          emoji: "🌊",
          title: "Cox's bazar",
          tagline: "An unforgettable curated private journey",
          nights: "4 NIGHTS",
          region: "BANGLADESH",
          price: "৳ 5,000 per person",
          img: "/uploads/images/From_Klickpin_com-_1010776710108124418-pin-id-1010-mvwjuz21.jpg",
          link: "/destinations/coxs-bazar/",
          isExploreTrip: true,
          keywords: ["cox's bazar", "coxs bazar", "কক্সবাজার", "sea beach", "সমুদ্র", "inani", "marine drive"]
        },
        {
          name: "Sylhet",
          bnName: "সিলেট ও হাওর",
          emoji: "🍃",
          title: "Sylhet",
          tagline: "Wake up above a rolling ocean of clouds",
          nights: "3 NIGHTS",
          region: "BANGLADESH",
          price: "৳ 3,500 per person",
          img: "/uploads/images/From_Klickpin_com-_Tailor-made_daily_stitch_inspir-mvwk2bs4.jpg",
          link: "/destinations/sylhet/",
          isExploreTrip: true,
          keywords: ["sylhet", "সিলেট", "tanguar haor", "টাঙ্গুয়ার হাওর", "sreemangal", "শ্রীমঙ্গল", "হাউসবোট"]
        }
      );
    }

    // 2. Global / International Destinations
    const internationalTours = [
      {
        name: "France",
        bnName: "ফ্রান্স",
        emoji: "🗼",
        title: "The Lost Generation (প্যারিস ও ফ্রেঞ্চ রিভিয়েরা)",
        tagline: "A literary journey through historic Paris and Champagne",
        nights: "12 Nights",
        region: "Europe (ইউরোপ)",
        price: "From £7,500pp",
        img: "/2026/04/Lost-Generation-header-mob.jpg",
        link: "/destinations/france/the-lost-generation/",
        isExploreTrip: false,
        keywords: ["france", "ফ্রান্স", "paris", "প্যারিস", "lost generation", "champagne"]
      },
      {
        name: "Brazil",
        bnName: "ব্রাজিল",
        emoji: "🌴",
        title: "The Rhythm of Water: Rio to Amazon",
        tagline: "Explore Rio's coastlines and the deep Amazon basin",
        nights: "8 Nights",
        region: "South America (আমেরিকা)",
        price: "From £6,200pp",
        img: "/2026/02/Lady-in-Forest-1-1.jpg",
        link: "/destinations/brazil/the-rhythm-of-water/",
        isExploreTrip: false,
        keywords: ["brazil", "ব্রাজিল", "amazon", "আমাজন", "rio", "রিও"]
      },
      {
        name: "Japan",
        bnName: "জাপান",
        emoji: "⛩️",
        title: "Tokyo & Kyoto: Private Cultural Odyssey",
        tagline: "Traditional tea ceremonies and modern luxury in Tokyo",
        nights: "10 Nights",
        region: "Asia (এশিয়া)",
        price: "From £8,900pp",
        img: "/2019/09/Ninja-martial-arts-in-Tokyo.jpg",
        link: "/destinations/japan/",
        isExploreTrip: false,
        keywords: ["japan", "জাপান", "tokyo", "টোকিও", "kyoto", "কিয়োটো"]
      },
      {
        name: "Italy",
        bnName: "ইতালি",
        emoji: "🏛️",
        title: "Highlights of Italy: Rome, Florence & Venice",
        tagline: "Sample iconic Italian gastronomy, art, and canals",
        nights: "9 Nights",
        region: "Europe (ইউরোপ)",
        price: "From £8,000pp",
        img: "/2022/09/Highlights-of-Italy-scaled.jpg",
        link: "/destinations/italy/",
        isExploreTrip: false,
        keywords: ["italy", "ইতালি", "rome", "রোম", "florence", "venice", "ভেনিস"]
      }
    ];

    return {
      exploreTrips: exploreTripsFormatted,
      allTours: [...exploreTripsFormatted, ...internationalTours]
    };
  }

  function initHeaderControls() {
    // 1. Destinations Search Modal
    const searchTrigger = document.getElementById('destinations-search-trigger');
    const searchModal = document.getElementById('destinations-search-modal');
    const searchBackdrop = document.getElementById('search-modal-backdrop');
    const searchCloseBtn = document.getElementById('search-close-btn');
    const searchInput = document.getElementById('destinations-query-input') as HTMLInputElement;
    const searchClearBtn = document.getElementById('search-clear-btn');
    const searchResultsContainer = document.getElementById('search-results-container');
    const dynamicTagsContainer = document.getElementById('dynamic-tags-container');
    const sectionBadge = document.getElementById('search-section-badge');
    const sectionTitle = document.getElementById('search-section-title');

    const { exploreTrips, allTours } = getExploreSearchDatabase();

    // Populate Dynamic Quick Filter Tags based on Explore Our Trips
    if (dynamicTagsContainer) {
      const exploreTagsHtml = exploreTrips.map(t => {
        const displayName = t.name === "Cox's bazar" ? "Cox's Bazar" : t.name;
        return `
          <button type="button" class="search-tag-pill" data-keyword="${t.name}">
            ${displayName}
          </button>
        `;
      }).join('');
      dynamicTagsContainer.innerHTML = exploreTagsHtml;

      // Attach click events to pills
      dynamicTagsContainer.querySelectorAll('.search-tag-pill').forEach(pill => {
        pill.addEventListener('click', () => {
          const keyword = pill.getAttribute('data-keyword') || '';
          if (searchInput) searchInput.value = keyword;
          if (searchClearBtn) searchClearBtn.style.display = 'block';
          renderSearchResults(keyword);
        });
      });
    }

    function renderSearchResults(filterText: string = '') {
      if (!searchResultsContainer) return;
      const query = filterText.toLowerCase().trim();

      // If empty query: Show Explore Our Trips as primary suggestions!
      const isDefaultSuggestion = !query;
      const matches = isDefaultSuggestion
        ? exploreTrips
        : allTours.filter(t => 
            t.name.toLowerCase().includes(query) || 
            (t.bnName && t.bnName.toLowerCase().includes(query)) ||
            t.title.toLowerCase().includes(query) || 
            t.region.toLowerCase().includes(query) ||
            (t.tagline && t.tagline.toLowerCase().includes(query)) ||
            (t.keywords && t.keywords.some((k: string) => k.toLowerCase().includes(query)))
          );

      if (sectionBadge && sectionTitle) {
        if (isDefaultSuggestion) {
          sectionBadge.textContent = 'EXPLORE OUR TRIPS';
          sectionBadge.style.display = 'inline-block';
          sectionTitle.textContent = 'Explore Our Trips Destinations';
        } else {
          sectionBadge.textContent = `${matches.length} Results`;
          sectionBadge.style.display = matches.length > 0 ? 'inline-block' : 'none';
          sectionTitle.textContent = `Results for "${filterText}"`;
        }
      }

      if (matches.length === 0) {
        searchResultsContainer.innerHTML = `
          <div style="text-align: center; padding: 2.5rem 1rem; color: #64748B;">
            <p style="font-size: 1.05rem; font-weight: 600; margin-bottom: 0.35rem; color: #0F172A;">No tours found for "${filterText}"</p>
            <p style="font-size: 0.85rem; color: #64748B;">Click any popular destination above to view packages.</p>
          </div>
        `;
        return;
      }

      // Render Clean Text-Only Rows (Zero Images)
      searchResultsContainer.innerHTML = matches.map(tour => {
        const headline = tour.name === "Cox's bazar" ? "Cox's Bazar" : (tour.name || tour.title);
        const nightsText = tour.nights ? tour.nights.replace(/nights?/i, 'Nights').trim() : '';
        const regionText = tour.region ? tour.region.toUpperCase() : 'BANGLADESH';
        const metaParts = [regionText, nightsText, tour.price ? `${tour.price}` : ''].filter(Boolean);
        const metaText = metaParts.join(' • ');

        return `
          <a href="${tour.link}" class="search-text-item js-search-result-item" title="Visit ${headline} Tour Page">
            <div class="item-left">
              <div class="item-icon-circle">
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                  <circle cx="12" cy="10" r="3"></circle>
                </svg>
              </div>
              <div class="item-texts">
                <span class="item-headline">${headline}</span>
                <span class="item-meta">${metaText}</span>
              </div>
            </div>
            <div class="item-right">
              <span class="item-badge">VISIT TOUR</span>
              <svg class="item-arrow-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="9 18 15 12 9 6"></polyline>
              </svg>
            </div>
          </a>
        `;
      }).join('');

      // Auto close modal & direct navigation when clicking a result
      searchResultsContainer.querySelectorAll('.js-search-result-item').forEach(item => {
        item.addEventListener('click', (e) => {
          const href = (item as HTMLAnchorElement).getAttribute('href');
          if (href) {
            closeSearchModal();
            window.location.href = href;
          }
        });
      });
    }

    function openSearchModal() {
      if (!searchModal) return;
      searchModal.classList.add('is-open');
      searchModal.setAttribute('aria-hidden', 'false');
      renderSearchResults(searchInput?.value || '');
      setTimeout(() => searchInput?.focus(), 80);
    }

    function closeSearchModal() {
      if (!searchModal) return;
      searchModal.classList.remove('is-open');
      searchModal.setAttribute('aria-hidden', 'true');
    }

    if (searchTrigger) searchTrigger.addEventListener('click', openSearchModal);
    if (searchCloseBtn) searchCloseBtn.addEventListener('click', closeSearchModal);
    if (searchBackdrop) searchBackdrop.addEventListener('click', closeSearchModal);

    // Click or Focus in search input immediately reveals Explore Our Trips suggestions!
    if (searchInput) {
      searchInput.addEventListener('click', () => {
        if (!searchInput.value.trim()) {
          renderSearchResults('');
        }
      });
      searchInput.addEventListener('focus', () => {
        if (!searchInput.value.trim()) {
          renderSearchResults('');
        }
      });
      searchInput.addEventListener('input', (e) => {
        const val = (e.target as HTMLInputElement).value;
        if (searchClearBtn) searchClearBtn.style.display = val ? 'block' : 'none';
        renderSearchResults(val);
      });
    }

    if (searchClearBtn) {
      searchClearBtn.addEventListener('click', () => {
        if (searchInput) searchInput.value = '';
        searchClearBtn.style.display = 'none';
        renderSearchResults('');
        searchInput?.focus();
      });
    }

    // 2. Google Account Auth & Dropdown
    const accountBtn = document.getElementById('account-btn');
    const accountDropdown = document.getElementById('account-dropdown');
    const loginModal = document.getElementById('account-login-modal');
    const loginBackdrop = document.getElementById('login-modal-backdrop');
    const loginCloseBtn = document.getElementById('login-modal-close');
    const googleSignInBtn = document.getElementById('btn-google-signin');
    const logoutBtn = document.getElementById('logout-trigger-btn');
    const defaultIcon = document.getElementById('user-default-icon');
    const googleAvatarBox = document.getElementById('google-avatar-box');
    const googleAvatarImg = document.getElementById('google-avatar-img') as HTMLImageElement;
    const displayName = document.getElementById('user-display-name');
    const displayEmail = document.getElementById('user-display-email');

    const REAL_SAID_AVATAR = "/uploads/users/said_google_avatar.png";

    // Check localStorage login state
    function checkUserSession() {
      const savedUser = localStorage.getItem('bt_user_profile');
      if (savedUser) {
        try {
          const user = JSON.parse(savedUser);
          
          // Clear old stock mock woman photo or placeholder letter avatars so authentic Gmail photo loads
          const isMockOrLetter = !user.avatar || 
            user.avatar.includes('photo-1534528741775-53994a69daeb') || 
            user.avatar.includes('unsplash.com') ||
            user.avatar.includes('ui-avatars.com');

          if (isMockOrLetter) {
            user.avatar = REAL_SAID_AVATAR;
            localStorage.setItem('bt_user_profile', JSON.stringify(user));
          }

          if (defaultIcon) defaultIcon.style.display = 'none';
          if (googleAvatarBox) googleAvatarBox.style.display = 'block';
          if (googleAvatarImg && user.avatar) googleAvatarImg.src = user.avatar;

          const dropdownAvatar = document.getElementById('dropdown-user-avatar') as HTMLImageElement | null;
          if (dropdownAvatar && user.avatar) dropdownAvatar.src = user.avatar;

          if (displayName && user.name) displayName.textContent = user.name;
          if (displayEmail && user.email) displayEmail.textContent = user.email;
          return true;
        } catch (e) {
          localStorage.removeItem('bt_user_profile');
        }
      }
      if (defaultIcon) defaultIcon.style.display = 'flex';
      if (googleAvatarBox) googleAvatarBox.style.display = 'none';
      return false;
    }

    const isLoggedIn = checkUserSession();
    window.addEventListener('bt_auth_changed', () => {
      checkUserSession();
    });

    if (accountBtn) {
      accountBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        const logged = checkUserSession();
        if (logged) {
          // Toggle dropdown
          if (accountDropdown) accountDropdown.classList.toggle('is-open');
        } else {
          // Open Google Login Modal
          if (loginModal) {
            loginModal.classList.add('is-open');
            loginModal.setAttribute('aria-hidden', 'false');
          }
        }
      });
    }

    // Close dropdown on outside click
    document.addEventListener('click', (e) => {
      if (accountDropdown && !accountDropdown.contains(e.target as Node)) {
        accountDropdown.classList.remove('is-open');
      }
    });

    function closeLoginModal() {
      if (loginModal) {
        loginModal.classList.remove('is-open');
        loginModal.setAttribute('aria-hidden', 'true');
      }
    }

    if (loginBackdrop) loginBackdrop.addEventListener('click', closeLoginModal);
    if (loginCloseBtn) loginCloseBtn.addEventListener('click', closeLoginModal);

    // Google Sign-In Click (Uses authentic Google profile photo)
    if (googleSignInBtn) {
      googleSignInBtn.addEventListener('click', () => {
        const savedUser = localStorage.getItem('bt_user_profile');
        let existingAvatar = REAL_SAID_AVATAR;
        if (savedUser) {
          try {
            const parsed = JSON.parse(savedUser);
            if (parsed.avatar && !parsed.avatar.includes('photo-1534528741775-53994a69daeb') && !parsed.avatar.includes('ui-avatars.com')) {
              existingAvatar = parsed.avatar;
            }
          } catch(e) {}
        }

        const googleUser = {
          name: "Said Khan",
          email: "saidmd7778@gmail.com",
          avatar: existingAvatar
        };
        localStorage.setItem('bt_user_profile', JSON.stringify(googleUser));
        checkUserSession();
        closeLoginModal();
      });
    }

    // Official Google Identity Services (GIS) Callback Handler
    (window as any).handleGoogleCredentialResponse = function(response: any) {
      try {
        if (!response || !response.credential) return;
        const base64Url = response.credential.split('.')[1];
        const base64 = base64Url.replace(/-/g, '+').replace(/_/g, '/');
        const jsonPayload = decodeURIComponent(atob(base64).split('').map(function(c) {
          return '%' + ('00' + c.charCodeAt(0).toString(16)).slice(-2);
        }).join(''));
        const payload = JSON.parse(jsonPayload);
        
        const googleUser = {
          name: payload.name || "Said Khan",
          email: payload.email || "saidmd7778@gmail.com",
          avatar: payload.picture || REAL_SAID_AVATAR
        };
        localStorage.setItem('bt_user_profile', JSON.stringify(googleUser));
        checkUserSession();
        closeLoginModal();
      } catch(e) {
        console.error("GIS decode error:", e);
      }
    };

    // Real Photo Upload Handler
    const realPhotoInput = document.getElementById('user-real-avatar-input') as HTMLInputElement | null;
    const uploadPhotoBtn = document.getElementById('btn-upload-real-photo');
    const cameraUploadBtn = document.getElementById('btn-camera-upload');

    function triggerUserPhotoChooser() {
      if (realPhotoInput) realPhotoInput.click();
    }

    if (uploadPhotoBtn) uploadPhotoBtn.addEventListener('click', triggerUserPhotoChooser);
    if (cameraUploadBtn) cameraUploadBtn.addEventListener('click', triggerUserPhotoChooser);

    if (realPhotoInput) {
      realPhotoInput.addEventListener('change', async () => {
        const file = realPhotoInput.files && realPhotoInput.files[0];
        if (!file) return;

        try {
          const formData = new FormData();
          formData.append('file', file);
          const res = await fetch('/api/admin/upload-image', { method: 'POST', body: formData });
          const data = await res.json();
          const avatarUrl = (data.success && data.url) ? data.url : URL.createObjectURL(file);

          const savedUser = localStorage.getItem('bt_user_profile');
          const user = savedUser ? JSON.parse(savedUser) : { name: "Said Khan", email: "saidkhan.dev@gmail.com" };
          user.avatar = avatarUrl;
          localStorage.setItem('bt_user_profile', JSON.stringify(user));

          checkUserSession();
          alert('✅ আপনার আসল প্রোফাইল ছবি সফলভাবে যুক্ত হয়েছে!');
        } catch (err) {
          console.error('Error uploading avatar:', err);
          const avatarUrl = URL.createObjectURL(file);
          const savedUser = localStorage.getItem('bt_user_profile');
          const user = savedUser ? JSON.parse(savedUser) : { name: "Said Khan", email: "saidkhan.dev@gmail.com" };
          user.avatar = avatarUrl;
          localStorage.setItem('bt_user_profile', JSON.stringify(user));
          checkUserSession();
        }
        realPhotoInput.value = '';
      });
    }

    // Sign Out Click
    if (logoutBtn) {
      logoutBtn.addEventListener('click', () => {
        localStorage.removeItem('bt_user_profile');
        checkUserSession();
        if (accountDropdown) accountDropdown.classList.remove('is-open');
      });
    }

    // Close all sub-interfaces & overlays (Spotlight rooms, booking modals, etc.)
    function closeSubInterfaces() {
      const spotlightInterface = document.getElementById('spotlight-property-interface');
      if (spotlightInterface) {
        spotlightInterface.style.display = 'none';
        spotlightInterface.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
      }
      const bookingModal = document.getElementById('spotlight-booking-modal');
      if (bookingModal) {
        bookingModal.style.display = 'none';
      }
    }

    // HOME & LOGO: Return to the First User Interface (Home Screen)
    const homeBtn = document.getElementById('nav-home-btn');
    const logoLinks = document.querySelectorAll('.logo-link');

    function handleHomeNavClick(e: Event) {
      const spotlightInterface = document.getElementById('spotlight-property-interface');
      const isSubInterfaceOpen = spotlightInterface && spotlightInterface.style.display !== 'none';
      
      if (isSubInterfaceOpen) {
        e.preventDefault();
        closeSubInterfaces();
        window.scrollTo({ top: 0, behavior: 'smooth' });
        if (headerEl) {
          headerEl.classList.remove('header--hidden');
          headerEl.classList.remove('header--scrolled-white');
        }
      } else if (window.location.pathname === '/' || window.location.pathname === '') {
        e.preventDefault();
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }
    }

    if (homeBtn) homeBtn.addEventListener('click', handleHomeNavClick);
    logoLinks.forEach(link => link.addEventListener('click', handleHomeNavClick));

    // PACKAGES Link: If in sub-interface, return to main and scroll to #tour-sessions
    const packagesBtn = document.getElementById('nav-packages-btn');
    if (packagesBtn) {
      packagesBtn.addEventListener('click', (e) => {
        const spotlightInterface = document.getElementById('spotlight-property-interface');
        const isSubInterfaceOpen = spotlightInterface && spotlightInterface.style.display !== 'none';
        if (isSubInterfaceOpen) {
          e.preventDefault();
          closeSubInterfaces();
          const target = document.getElementById('tour-sessions');
          if (target) target.scrollIntoView({ behavior: 'smooth' });
        }
      });
    }

    // ABOUT Link: If in sub-interface, return to main and scroll to #what-we-do
    const aboutBtn = document.getElementById('nav-about-btn');
    if (aboutBtn) {
      aboutBtn.addEventListener('click', (e) => {
        const spotlightInterface = document.getElementById('spotlight-property-interface');
        const isSubInterfaceOpen = spotlightInterface && spotlightInterface.style.display !== 'none';
        if (isSubInterfaceOpen) {
          e.preventDefault();
          closeSubInterfaces();
          const target = document.getElementById('what-we-do');
          if (target) target.scrollIntoView({ behavior: 'smooth' });
        }
      });
    }

    // Escape Key to close modals
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        closeSearchModal();
        closeLoginModal();
        closeSubInterfaces();
        if (accountDropdown) accountDropdown.classList.remove('is-open');
      }
    });

    // Smart Directional Scroll: Hide on scroll down, Reveal on scroll up with White Theme
    const headerEl = document.getElementById('main-header');
    let lastScrollY = window.scrollY;
    let ticking = false;

    function updateHeaderOnScroll() {
      if (!headerEl) return;
      const currentScrollY = window.scrollY;
      const scrollDiff = currentScrollY - lastScrollY;

      // Detect if page has a hero banner or is a white page
      const hasHeroBanner = document.querySelector('.section--hero-banner, .hero-slider, .hero__fixed-video, .banner__image, .trip-hero-section, .hero');
      const isPureWhitePage = !hasHeroBanner && (
        document.body.classList.contains('theme-light') || 
        window.location.pathname.includes('/tour-schedule') || 
        window.location.pathname.includes('/craft-your-trip') ||
        window.location.pathname.includes('/make-an-enquiry') ||
        window.location.pathname.includes('/about-us') ||
        window.location.pathname.includes('/contact') ||
        window.location.pathname.includes('/privacy-policy')
      );

      // 1. At very top of page (Hero section or White page)
      if (currentScrollY <= 25) {
        headerEl.classList.remove('header--hidden');
        if (isPureWhitePage) {
          headerEl.classList.add('header--scrolled-white');
        } else {
          headerEl.classList.remove('header--scrolled-white');
        }
        lastScrollY = currentScrollY;
        return;
      }

      // 2. Beyond Hero section (> 25px) -> Header adopts White Theme
      headerEl.classList.add('header--scrolled-white');

      // Check if search modal or login modal is open - keep header visible
      const isSearchOpen = document.getElementById('destinations-search-modal')?.classList.contains('is-open');
      const isLoginOpen = document.getElementById('account-login-modal')?.classList.contains('is-open');
      if (isSearchOpen || isLoginOpen) {
        headerEl.classList.remove('header--hidden');
        lastScrollY = currentScrollY;
        return;
      }

      // 3. Directional scroll behavior:
      // Scrolling DOWN past 70px -> HIDE header completely
      if (scrollDiff > 6 && currentScrollY > 70) {
        headerEl.classList.add('header--hidden');
        // Close account dropdown if open
        const accountDropdown = document.getElementById('account-dropdown');
        if (accountDropdown) accountDropdown.classList.remove('is-open');
      }
      // Scrolling UP -> REVEAL header
      else if (scrollDiff < -6) {
        headerEl.classList.remove('header--hidden');
      }

      lastScrollY = currentScrollY;
    }

    window.addEventListener('scroll', () => {
      if (!ticking) {
        window.requestAnimationFrame(() => {
          updateHeaderOnScroll();
          ticking = false;
        });
        ticking = true;
      }
    }, { passive: true });

    updateHeaderOnScroll();

    // Contextual Header Back Button Handler (Visible on internal pages / sub-interfaces)
    if (window.location.pathname !== '/' && window.location.pathname !== '') {
      const hBack = document.getElementById('header-back-btn');
      if (hBack) {
        hBack.style.display = 'inline-flex';
        hBack.onclick = (e) => {
          e.preventDefault();
          if (window.history.length > 1 && (document.referrer?.includes(window.location.host) || window.history.state !== null)) {
            window.history.back();
          } else {
            if (window.location.pathname.includes('/tour-schedule/book')) {
              window.location.href = '/tour-schedule/';
            } else if (window.location.pathname.includes('/craft-your-trip/plan')) {
              window.location.href = '/craft-your-trip/';
            } else if (window.location.pathname.includes('/tour-schedule') || window.location.pathname.includes('/craft-your-trip')) {
              window.location.href = '/#craft-your-trip';
            } else {
              window.location.href = '/#explore-our-trips';
            }
          }
        };
      }
    }
  }

  // Auto-run on mount
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHeaderControls);
  } else {
    initHeaderControls();
  }
  document.addEventListener('astro:page-load', initHeaderControls);
</script>
