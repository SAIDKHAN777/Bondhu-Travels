---
// Authentic Luxury Fixed Topbar Header
// Left: Brand Logo | Center: DESTINATIONS (Search), PACKAGES, ABOUT | Right: Phone, User Profile (Google Account) & CONTACT
import prisma from '../lib/prisma.js';

interface Props {
  phone?: string;
  enquireText?: string;
  enquireLink?: string;
}

const {
  phone = "+44 207 426 9888",
  enquireText = "ENQUIRE NOW",
  enquireLink = "/make-an-enquiry/"
} = Astro.props;

// Fetch live Explore Our Trips from PostgreSQL to power real-time search suggestions
let exploreTripsData: any[] = [];
try {
  const exploreSetting = await prisma.systemSetting.findUnique({
    where: { key: 'section_explore_trips' }
  });
  if (exploreSetting && Array.isArray(exploreSetting.value?.trips)) {
    exploreTripsData = exploreSetting.value.trips;
  }
} catch (e: any) {
  console.warn('[Header] Failed to fetch explore trips for search:', e.message);
}
---

<header role="banner" class="header header--fixed-luxury" id="main-header">
  <div class="header__inner">
    <!-- 1. Left: Brand Logo (Bondhu Travel) & Contextual Back Button -->
    <div class="header__left">
      <a href="/" class="logo-link" aria-label="Bondhu Travel Home">
        <img 
          src="/img/bondhu-travel-logo.png" 
          alt="Bondhu Travel" 
          class="logo-img" 
          width="48" 
          height="61" 
        />
      </a>

      <!-- Smart Header Back Button (Visible on internal pages / sub-interfaces) -->
      <button 
        type="button" 
        class="header-back-btn" 
        id="header-back-btn" 
        aria-label="Back to Previous Page"
        style="display: none;"
      >
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="19" y1="12" x2="5" y2="12"></line>
          <polyline points="12 19 5 12 12 5"></polyline>
        </svg>
        <span>BACK</span>
      </button>
    </div>

    <!-- 2. Center: 4 Navigation Items: HOME, DESTINATIONS (Search Trigger), PACKAGES, ABOUT -->
    <nav class="header__center" aria-label="Main Navigation">
      <!-- HOME -->
      <a href="/" class="nav-item nav-item--home" id="nav-home-btn">
        <span>HOME</span>
      </a>

      <!-- DESTINATIONS (Interactive Search Trigger) -->
      <button 
        type="button" 
        class="nav-destinations-btn" 
        id="destinations-search-trigger"
        aria-label="Search destinations and tour plans"
      >
        <svg class="search-mini-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <span>DESTINATIONS</span>
      </button>

      <!-- PACKAGES -->
      <a href="#tour-sessions" class="nav-item" id="nav-packages-btn">
        <span>PACKAGES</span>
      </a>

      <!-- ABOUT -->
      <a href="/about-us/" class="nav-item" id="nav-about-btn">
        <span>ABOUT</span>
      </a>
    </nav>

    <!-- 3. Right: Phone, Customer Account (Google Profile) & ENQUIRE NOW Button -->
    <div class="header__right">
      <!-- Phone Helpline (Desktop matching luxury spec) -->
      {phone && (
        <a href={`tel:${phone.replace(/\s+/g, '')}`} class="header-phone-link">
          <span>{phone}</span>
        </a>
      )}

      <!-- Customer Account Button (Switches to Google Avatar when logged in) -->
      <div class="account-menu-wrapper" id="account-wrapper">
        <button 
          type="button" 
          class="nav-account-btn" 
          id="account-btn" 
          aria-label="Customer account and profile"
          aria-haspopup="true"
        >
          <!-- Default State: Sleek Luxury User Icon -->
          <span class="user-default-icon" id="user-default-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
              <circle cx="12" cy="7" r="4"></circle>
            </svg>
          </span>

          <!-- Logged-in State: Google Avatar Image (hidden by default, shown via JS) -->
          <div class="google-avatar-box" id="google-avatar-box" style="display: none;">
            <img 
              id="google-avatar-img" 
              src="/uploads/users/said_google_avatar.png" 
              alt="Google Profile Avatar" 
              class="google-profile-img" 
            />
            <span class="avatar-online-dot"></span>
          </div>
        </button>

        <!-- Account Dropdown Menu (When Logged In) -->
        <div class="account-dropdown-menu" id="account-dropdown">
          <div class="dropdown-header">
            <div class="dropdown-avatar-wrap">
              <img id="dropdown-user-avatar" class="dropdown-avatar-img" src="/uploads/users/said_google_avatar.png" alt="Said Khan" />
              <button type="button" class="btn-avatar-camera" id="btn-camera-upload" title="আপনার আসল ছবি আপলোড করুন">
                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path><circle cx="12" cy="13" r="4"></circle></svg>
              </button>
            </div>
            <div class="user-info">
              <span class="user-name" id="user-display-name">Said Khan</span>
              <span class="user-email" id="user-display-email">saidkhan.dev@gmail.com</span>
            </div>
          </div>
          <div class="dropdown-items">
            <!-- 1-Click Upload Real Profile Photo -->
            <button type="button" class="drop-item" id="btn-upload-real-photo" style="width: 100%; border: none; background: transparent; cursor: pointer; text-align: left; color: #38BDF8; font-weight: 600;">
              <span class="drop-icon">📸</span> আপনার আসল ছবি আপলোড করুন
            </button>
            <input type="file" id="user-real-avatar-input" accept="image/*" style="display: none;" />

            <a href="#tour-sessions" class="drop-item">
              <span class="drop-icon">📦</span> My Tour Bookings
            </a>
            <a href="#explore-our-trips" class="drop-item">
              <span class="drop-icon">🤍</span> Saved Destinations
            </a>
            <a href="/admin" class="drop-item" style="color: #E82E72; font-weight: 600;">
              <span class="drop-icon">⚙️</span> Admin Studio
            </a>
            <hr class="drop-divider" />
            <button type="button" class="drop-logout-btn" id="logout-trigger-btn">
              <span class="drop-icon">🚪</span> Sign Out
            </button>
          </div>
        </div>
      </div>

      <!-- CONTACT / ENQUIRE NOW Button -->
      <a href={enquireLink} class="nav-contact-btn" id="header-contact-btn">
        {enquireText}
      </a>
    </div>
  </div>

  <!-- Hidden JSON payload with live Explore Our Trips data from DB -->
  <script id="header-explore-trips-data" type="application/json" set:html={JSON.stringify(exploreTripsData)}></script>

  <!-- ============================================================== -->
  <!-- INTERACTIVE DESTINATIONS SEARCH OVERLAY MODAL -->
  <!-- ============================================================== -->
  <div class="destinations-search-modal" id="destinations-search-modal" aria-hidden="true">
    <div class="search-modal-backdrop" id="search-modal-backdrop"></div>
    <div class="search-modal-card">
      <div class="search-modal-header">
        <div class="search-input-wrap">
          <svg class="search-input-icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <input 
            type="text" 
            id="destinations-query-input" 
            class="destinations-query-input" 
            placeholder="Search tours & destinations (e.g. Sajek, Bandarban, Cox's Bazar)..." 
            autocomplete="off"
          />
          <button type="button" class="search-clear-btn" id="search-clear-btn" aria-label="Clear search">&times;</button>
        </div>
        <button type="button" class="search-close-btn" id="search-close-btn" aria-label="Close search">
          <span>ESC</span>
        </button>
      </div>

      <!-- Popular Search Suggestions Quick Pills -->
      <div class="popular-tags-row" id="popular-tags-row">
        <span class="popular-tags-label">Popular Destinations:</span>
        <div id="dynamic-tags-container" style="display: contents;">
          <!-- Dynamically populated from Explore Our Trips via JS -->
        </div>
      </div>

      <!-- Live Search Results Header Bar -->
      <div class="search-section-bar" id="search-section-bar">
        <span class="search-section-badge" id="search-section-badge">EXPLORE OUR TRIPS</span>
        <span class="search-section-title" id="search-section-title">Explore Our Trips Destinations</span>
      </div>

      <!-- Live Search Results Grid (Text-only) -->
      <div class="search-results-container" id="search-results-container">
        <!-- Results dynamically rendered via JS -->
      </div>
    </div>
  </div>

  <!-- ============================================================== -->
  <!-- GOOGLE ACCOUNT SIGN-IN MODAL (When not logged in) -->
  <!-- ============================================================== -->
  <div class="account-login-modal" id="account-login-modal" aria-hidden="true">
    <div class="login-modal-backdrop" id="login-modal-backdrop"></div>
    <div class="login-modal-card">
      <button type="button" class="login-modal-close" id="login-modal-close">&times;</button>
      <div class="login-modal-header">
        <img src="/img/bondhu-travel-logo.png" alt="Bondhu Travel" class="login-brand-logo" width="56" height="72" />
        <h3 class="login-title">Customer Account Access</h3>
        <p class="login-subtitle">Sign in with your Google account to manage tailor-made itineraries, private bookings, and custom quotes.</p>
      </div>

      <div class="login-actions">
        <!-- Google One-Click Sign-In Button -->
        <button type="button" class="btn-google-auth" id="btn-google-signin">
          <svg class="google-svg" width="20" height="20" viewBox="0 0 24 24">
            <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
            <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
            <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
            <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
          </svg>
          <span>Continue with Google</span>
        </button>
      </div>

      <p class="login-privacy-note">
        By continuing, you agree to Black Tomato's <a href="/booking-conditions/">Booking Terms</a> and <a href="/privacy-policy/">Privacy Policy</a>.
      </p>
    </div>
  </div>
</header>

<style>
  /* Seamless Floating Topbar Header (Ultra-sleek, hides on scroll down, reveals on scroll up) */
  .header--fixed-luxury {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 100000;
    background: transparent;
    border-bottom: 1px solid transparent;
    box-shadow: none;
    transform: translateY(0);
    transition: transform 0.32s cubic-bezier(0.16, 1, 0.3, 1),
                background-color 0.28s ease,
                border-color 0.28s ease,
                box-shadow 0.28s ease;
  }

  /* When scrolling down: smoothly hide completely off-screen */
  .header--fixed-luxury.header--hidden {
    transform: translateY(-100%);
  }

  /* Seamless ambient top vignette - protects text contrast over dark hero videos/images */
  .header--fixed-luxury::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 125%;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.45) 0%, rgba(0, 0, 0, 0.12) 60%, transparent 100%);
    pointer-events: none;
    z-index: 1;
    transition: opacity 0.3s ease;
  }

  /* WHITE THEME WHEN SCROLLED (blends seamlessly into white page background) */
  .header--fixed-luxury.header--scrolled-white {
    background-color: #FFFFFF;
    border-bottom: 1px solid rgba(0, 0, 0, 0.05);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
  }

  .header--fixed-luxury.header--scrolled-white::before {
    opacity: 0;
  }

  /* Ultra Sleek & Slim Header Bar Inner Container */
  .header__inner {
    position: relative;
    z-index: 2;
    max-width: 1560px;
    margin: 0 auto;
    padding: 0.55rem 2.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    transition: padding 0.25s ease;
  }

  /* 1. Left: Brand Logo */
  .header__left {
    display: flex;
    align-items: center;
  }

  .logo-link {
    display: inline-flex;
    align-items: center;
    line-height: 1;
    text-decoration: none;
  }

  /* Contextual Header Back Button (Crisp Square Shape, Dynamic Contrast) */
  .header-back-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding: 0.42rem 0.85rem;
    border-radius: 0px !important; /* Full crisp square shape as requested */
    cursor: pointer;
    transition: all 0.22s ease;
    margin-left: 1rem;
    line-height: 1;

    /* Over Dark Picture / Transparent Header state (White text & border) */
    color: #FFFFFF;
    background: rgba(0, 0, 0, 0.45);
    border: 1px solid rgba(255, 255, 255, 0.45);
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.8);
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.25);
  }

  .header-back-btn svg {
    stroke: #FFFFFF;
    transition: transform 0.2s ease, stroke 0.2s ease;
  }

  .header-back-btn:hover {
    background: #FFFFFF;
    color: #000000;
    border-color: #FFFFFF;
    text-shadow: none;
    transform: translateX(-3px);
  }

  .header-back-btn:hover svg {
    stroke: #000000;
    transform: translateX(-2px);
  }

  /* In White Header state / White Pages: Crisp Square Back Button turns Black */
  .header--fixed-luxury.header--scrolled-white .header-back-btn {
    color: #111111;
    background: rgba(0, 0, 0, 0.04);
    border: 1px solid rgba(0, 0, 0, 0.25);
    text-shadow: none;
    box-shadow: none;
  }

  .header--fixed-luxury.header--scrolled-white .header-back-btn svg {
    stroke: #111111;
  }

  .header--fixed-luxury.header--scrolled-white .header-back-btn:hover {
    background: #000000;
    color: #FFFFFF;
    border-color: #000000;
    text-shadow: none;
    transform: translateX(-3px);
  }

  .header--fixed-luxury.header--scrolled-white .header-back-btn:hover svg {
    stroke: #FFFFFF;
    transform: translateX(-2px);
  }

  .logo-img {
    height: 34px;
    width: auto;
    display: block;
    filter: drop-shadow(0 2px 6px rgba(0, 0, 0, 0.65));
    transition: opacity 0.2s ease, transform 0.2s ease, filter 0.28s ease, height 0.25s ease;
  }

  .logo-link:hover .logo-img {
    opacity: 0.95;
    transform: scale(1.03);
  }

  /* In White Header state: logo turns sleek solid black */
  .header--fixed-luxury.header--scrolled-white .logo-img {
    filter: brightness(0);
    opacity: 0.92;
  }

  /* 2. Center: 3 Navigation Items */
  .header__center {
    display: flex;
    align-items: center;
    gap: 2.25rem;
  }

  /* DESTINATIONS (Search Trigger Button) */
  .nav-destinations-btn {
    position: relative;
    background: transparent;
    border: none;
    color: #FFFFFF;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    font-size: 0.73rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.35rem 0.15rem;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.8), 0 2px 8px rgba(0, 0, 0, 0.5);
    transition: color 0.25s ease;
  }

  /* Animated underline line that emerges on hover */
  .nav-destinations-btn::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 100%;
    height: 2px;
    background-color: #E82E72;
    transform: scaleX(0);
    transform-origin: center;
    transition: transform 0.25s cubic-bezier(0.25, 1, 0.5, 1);
    border-radius: 2px;
  }

  .nav-destinations-btn:hover {
    color: #FFFFFF;
  }

  .nav-destinations-btn:hover::after,
  .nav-destinations-btn:focus::after {
    transform: scaleX(1);
  }

  .search-mini-icon {
    stroke: currentColor;
    opacity: 0.92;
    filter: drop-shadow(0 1px 3px rgba(0, 0, 0, 0.8));
    transition: transform 0.25s ease, stroke 0.25s ease;
  }

  .nav-destinations-btn:hover .search-mini-icon {
    transform: scale(1.12);
    stroke: #E82E72;
  }

  /* PACKAGES & ABOUT */
  .nav-item {
    position: relative;
    color: #FFFFFF;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    font-size: 0.73rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: none;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    padding: 0.35rem 0.15rem;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.8), 0 2px 8px rgba(0, 0, 0, 0.5);
    transition: color 0.25s ease;
  }

  .nav-item::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 100%;
    height: 2px;
    background-color: #E82E72;
    transform: scaleX(0);
    transform-origin: center;
    transition: transform 0.25s cubic-bezier(0.25, 1, 0.5, 1);
    border-radius: 2px;
  }

  .nav-item:hover {
    color: #FFFFFF;
  }

  .nav-item:hover::after,
  .nav-item:focus::after {
    transform: scaleX(1);
  }

  /* In White Header state: Nav links turn sleek dark/black */
  .header--fixed-luxury.header--scrolled-white .nav-destinations-btn,
  .header--fixed-luxury.header--scrolled-white .nav-item {
    color: #111111;
    text-shadow: none;
  }

  .header--fixed-luxury.header--scrolled-white .nav-destinations-btn:hover,
  .header--fixed-luxury.header--scrolled-white .nav-item:hover {
    color: #E82E72;
  }

  .header--fixed-luxury.header--scrolled-white .search-mini-icon {
    stroke: #111111;
    filter: none;
  }

  .header--fixed-luxury.header--scrolled-white .nav-destinations-btn:hover .search-mini-icon {
    stroke: #E82E72;
  }

  /* 3. Right: Phone, Customer Account & CONTACT */
  .header__right {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  /* Phone Helpline (Desktop) */
  .header-phone-link {
    color: #FFFFFF;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    font-size: 0.73rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-decoration: none;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.8);
    transition: color 0.25s ease;
    white-space: nowrap;
  }

  .header-phone-link:hover {
    color: #E82E72;
  }

  .header--fixed-luxury.header--scrolled-white .header-phone-link {
    color: #111111;
    text-shadow: none;
  }

  .header--fixed-luxury.header--scrolled-white .header-phone-link:hover {
    color: #E82E72;
  }

  .account-menu-wrapper {
    position: relative;
  }

  .nav-account-btn {
    position: relative;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0.35rem 0.2rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #FFFFFF;
    transition: color 0.25s ease;
  }

  .nav-account-btn::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 100%;
    height: 2px;
    background-color: #E82E72;
    transform: scaleX(0);
    transform-origin: center;
    transition: transform 0.25s cubic-bezier(0.25, 1, 0.5, 1);
    border-radius: 2px;
  }

  .nav-account-btn:hover::after {
    transform: scaleX(1);
  }

  .user-default-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    color: #FFFFFF;
    filter: drop-shadow(0 1px 4px rgba(0, 0, 0, 0.8));
    transition: color 0.25s ease, transform 0.2s ease;
  }

  .nav-account-btn:hover .user-default-icon {
    color: #E82E72;
    transform: scale(1.12);
  }

  .header--fixed-luxury.header--scrolled-white .user-default-icon {
    color: #111111;
    filter: none;
  }

  .header--fixed-luxury.header--scrolled-white .nav-account-btn:hover .user-default-icon {
    color: #E82E72;
  }

  /* Google Profile Avatar Box */
  .google-avatar-box {
    position: relative;
    width: 30px;
    height: 30px;
  }

  .google-profile-img {
    width: 30px;
    height: 30px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid #10B981;
    display: block;
  }

  .avatar-online-dot {
    position: absolute;
    bottom: -1px;
    right: -1px;
    width: 8px;
    height: 8px;
    background-color: #10B981;
    border: 2px solid #FFFFFF;
    border-radius: 50%;
  }

  /* Account Dropdown Menu */
  .account-dropdown-menu {
    position: absolute;
    top: calc(100% + 10px);
    right: 0;
    width: 250px;
    background: #0C1017;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 8px;
    box-shadow: 0 12px 35px rgba(0, 0, 0, 0.7);
    padding: 0.85rem 0;
    display: none;
    z-index: 1100;
  }

  .header--fixed-luxury.header--scrolled-white .account-dropdown-menu {
