---
// Craft Your Trip & Schedule Section with Interactive Departure Calendar
// Features Messenger-style chat-head avatars on tour dates & date-specific schedule drawer

interface CardItem {
  tag: string;
  badge?: string;
  title: string;
  desc: string;
  img: string;
  link: string;
  btnText: string;
}

interface Props {
  title?: string;
  subtitle?: string;
  bgImage?: string;
  cards?: CardItem[];
}

const {
  title = "Craft Your Trip & Schedule",
  bgImage = "/2022/08/BG-1-1.jpg",
  cards = [
    {
      tag: "WEEKLY DEPARTURES",
      title: "REGULAR SCHEDULED TOURS",
      desc: "Join our curated luxury weekend batches to Sajek, Bandarban & Sylhet with guaranteed departures and boutique stays.",
      img: "/2024/05/Tom-Marchant-Values-Film-scaled-1.jpg",
      link: "/tour-schedule/",
      btnText: "VIEW DATES & BOOK"
    },
    {
      tag: "BESPOKE PLANNING",
      title: "CRAFT YOUR PRIVATE TRIP",
      desc: "Plan an exclusive private itinerary for your family, friends, or corporate group with our senior travel designers.",
      img: "/2025/08/Left-right-Hor.jpg",
      link: "/craft-your-trip/",
      btnText: "START CONSULTATION"
    }
  ]
} = Astro.props;
---

<section 
  class="craft-schedule-section" 
  style={`background-image: linear-gradient(135deg, rgba(194, 94, 56, 0.94) 0%, rgba(139, 58, 28, 0.94) 100%), url(${bgImage});`}
  id="craft-your-trip"
  aria-label={title}
>
  <div class="craft-schedule-container">
    
    <!-- Section Header: Single Clean Centered Title -->
    <header class="craft-header">
      <h2 class="craft-title">{title}</h2>
    </header>

    <!-- 2 Cards Grid: Exact Dimensions of ExploreOurTrips (295px × 520px) -->
    <div class="craft-cards-grid">
      {cards.slice(0, 2).map((card, idx) => {
        const isScheduleCard = idx === 0 || card.title.toLowerCase().includes('scheduled') || card.tag.toLowerCase().includes('weekly');
        const targetUrl = isScheduleCard ? '/tour-schedule/' : '/craft-your-trip/';
        return (
          <article 
            class={`craft-card ${isScheduleCard ? 'is-schedule-trigger' : 'is-private-trigger'}`}
            style={`background-image: url(${card.img});`}
            tabindex="0"
            role="article"
            aria-label={card.title}
            onclick={`window.location.href='${targetUrl}';`}
          >
            <!-- Full Card Clickable Overlay Link to Dedicated Full Interface -->
            <a 
              href={targetUrl} 
              class="craft-card-link-overlay" 
              aria-label={`${card.title} - ${card.tag}`}
            ></a>

            <!-- Dark Gradient Overlay for optimal contrast -->
            <div class="craft-card-gradient"></div>

            <!-- Bottom Card Content -->
            <div class="craft-card-content">
              <span class="craft-card-tag">{card.tag}</span>
              <h3 class="craft-card-title">
                <a href={targetUrl} style="color: inherit; text-decoration: none;">
                  {card.title}
                </a>
              </h3>
              <p class="craft-card-desc">{card.desc}</p>
              
              <div class="craft-action-wrap">
                <a 
                  href={targetUrl} 
                  class="btn-craft-action"
                >
                  <span>{card.btnText}</span>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="9 18 15 12 9 6"></polyline>
                  </svg>
                </a>
              </div>
            </div>
          </article>
        );
      })}
    </div>
  </div>
</section>

<style is:global>
  /* ------------------------------------------------------------- */
  /* Main Section with Warm Terracotta Background                  */
  /* ------------------------------------------------------------- */
  .craft-schedule-section {
    scroll-margin-top: 100px;
    background-size: cover;
    background-position: center center;
    background-repeat: no-repeat;
    padding: 3.5rem 1.5rem;
    position: relative;
    overflow: hidden;
    color: #FFFFFF;
    box-shadow: inset 0 8px 30px rgba(0, 0, 0, 0.25), inset 0 -8px 30px rgba(0, 0, 0, 0.25);
  }

  .craft-schedule-container {
    max-width: 1200px;
    margin: 0 auto;
    width: 100%;
  }

  /* Single Centered Clean Header */
  .craft-header {
    text-align: center;
    max-width: 800px;
    margin: 0 auto 2rem auto;
  }

  .craft-title {
    font-family: 'AlternateGotNo1D', 'Alternate Gothic', 'League Gothic', sans-serif;
    font-size: clamp(2.2rem, 3.2vw, 3.2rem);
    font-weight: 400;
    line-height: 1.05;
    color: #FFFFFF;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    margin: 0;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.3);
  }

  /* Cards Grid: Perfectly Centered 2 Cards matching ExploreOurTrips Size */
  .craft-cards-grid {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 2.5rem;
    flex-wrap: wrap;
  }

  /* Card Container: Exact Size of ExploreOurTrips (295px width × 520px height) */
  .craft-card {
    width: 295px;
    height: 520px;
    flex-shrink: 0;
    border-radius: 2px;
    overflow: hidden;
    position: relative;
    background-size: cover;
    background-position: center center;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 1.6rem 1.4rem;
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.45);
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.35s ease;
    cursor: pointer;
    border: 1px solid rgba(255, 255, 255, 0.15);
  }

  .craft-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 24px 48px rgba(0, 0, 0, 0.65);
    border-color: rgba(255, 255, 255, 0.35);
  }

  /* Clickable Overlay Link covering whole card */
  .craft-card-link-overlay {
    position: absolute;
    inset: 0;
    z-index: 5;
    text-decoration: none;
    background: transparent;
    border: none;
    padding: 0;
    margin: 0;
    cursor: pointer;
    width: 100%;
    height: 100%;
  }

  /* Top Badge */
  .craft-card-badge {
    position: absolute;
    top: 1.25rem;
    left: 1.25rem;
    background: rgba(11, 13, 18, 0.75);
    backdrop-filter: blur(8px);
    color: #FFFFFF;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 0.35rem 0.75rem;
    border-radius: 2px;
    border: 1px solid rgba(255, 255, 255, 0.2);
    z-index: 4;
  }

  /* Cinematic Gradient Overlay */
  .craft-card-gradient {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(0, 0, 0, 0) 0%,
      rgba(0, 0, 0, 0.15) 45%,
      rgba(10, 12, 16, 0.82) 78%,
      rgba(6, 8, 12, 0.96) 100%
    );
    z-index: 2;
    transition: opacity 0.3s ease;
  }

  .craft-card:hover .craft-card-gradient {
    background: linear-gradient(
      180deg,
      rgba(0, 0, 0, 0.05) 0%,
      rgba(0, 0, 0, 0.25) 45%,
      rgba(10, 12, 16, 0.88) 75%,
      rgba(6, 8, 12, 0.98) 100%
    );
  }

  /* Card Content */
  .craft-card-content {
    position: relative;
    z-index: 3;
    display: flex;
    flex-direction: column;
  }

  .craft-card-tag {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #E29547;
    margin-bottom: 0.35rem;
    display: block;
  }

  .craft-card-title {
    font-family: 'AlternateGotNo1D', 'Alternate Gothic', 'League Gothic', sans-serif;
    font-size: 1.75rem;
    font-weight: 400;
    line-height: 1.1;
    color: #FFFFFF;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin: 0 0 0.65rem 0;
  }

  .craft-card-desc {
    font-size: 0.85rem;
    color: #D1D5DB;
    line-height: 1.45;
    margin: 0 0 1.25rem 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Action CTA Pill */
  .craft-action-wrap {
    margin-top: auto;
  }

  .btn-craft-action {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background-color: #FFFFFF;
    color: #0F1218;
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 0.65rem 1.15rem;
    border-radius: 0px !important;
    border: none;
    cursor: pointer;
    font-family: inherit;
    transition: all 0.25s ease;
  }

  .craft-card:hover .btn-craft-action,
  .btn-craft-action:hover,
  .btn-craft-action:active,
  .btn-craft-action:focus {
    background: linear-gradient(135deg, rgba(194, 94, 56, 0.98) 0%, rgba(139, 58, 28, 0.98) 100%) !important;
    background-color: #C25E38 !important;
    color: #FFFFFF !important;
    border: 1px solid rgba(255, 255, 255, 0.3) !important;
    transform: translateX(4px);
    box-shadow: 0 4px 16px rgba(139, 58, 28, 0.5) !important;
  }

  /* ------------------------------------------------------------- */
  /* INTERFACE 1 & 2: CALENDAR MODAL STYLES                       */
  /* ------------------------------------------------------------- */
  </style>

<script is:inline>
  // Dedicated Full Page Routing Helpers
  function openCalendarModal() {
    window.location.href = '/tour-schedule/';
  }

  function openPrivateTripModal() {
    window.location.href = '/craft-your-trip/';
  }

  window.openCalendarModal = openCalendarModal;
  window.openPrivateTripModal = openPrivateTripModal;

  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.is-schedule-trigger, .js-open-calendar-trigger').forEach(el => {
      el.addEventListener('click', () => {
        window.location.href = '/tour-schedule/';
      });
    });
    document.querySelectorAll('.is-private-trigger, .js-open-private-trigger').forEach(el => {
      el.addEventListener('click', () => {
        window.location.href = '/craft-your-trip/';
      });
    });
  });
</script>