---
export interface PackageItem {
  id?: string;
  title: string;
  destination?: string;
  duration?: string;
  price?: number | string;
  imageUrl?: string;
  description?: string;
  slug?: string;
}

interface Props {
  packages?: PackageItem[];
}

const defaultPackages: PackageItem[] = [
  {
    title: "Serengeti Migration & Zanzibar Shores",
    destination: "Tanzania & Zanzibar",
    duration: "11 Days / 10 Nights",
    price: "From $9,450 pp",
    imageUrl: "/2026/01/Girl-running-in-farm-1.jpg",
    description: "Witness the Great Migration across the endless plains before retreating to a private ocean villa.",
    slug: "serengeti-migration"
  },
  {
    title: "Patagonia Fjords & Glacial Wilderness",
    destination: "Chile & Argentina",
    duration: "14 Days / 13 Nights",
    price: "From $12,800 pp",
    imageUrl: "/2026/01/Couple-sitting-by-coast.jpg",
    description: "Navigate ice-carved fjords, hike ancient moraines, and relax in architectural eco-lodges.",
    slug: "patagonia-fjords"
  },
  {
    title: "Nordic Aurora & Arctic Archipelago",
    destination: "Norway & Svalbard",
    duration: "9 Days / 8 Nights",
    price: "From $8,200 pp",
    imageUrl: "/2026/01/Group-canoeing-1.jpg",
    description: "Chase celestial light shows across silent fjords and experience remote dog-sledding expeditions.",
    slug: "nordic-aurora"
  }
];

const { packages = defaultPackages } = Astro.props;
---

<section class="packages-section" id="featured-packages" aria-label="Curated Bespoke Itineraries">
  <div class="packages-container">
    <div class="packages-header">
      <span class="packages-badge">Bespoke Itineraries</span>
      <h2 class="packages-title">Curated Journeys for 2026</h2>
      <p class="packages-subtitle">Every itinerary is custom designed from scratch by our destination specialists.</p>
    </div>

    <div class="packages-grid">
      {packages.map((pkg) => (
        <article class="package-card">
          <div class="card-media">
            <img 
              src={pkg.imageUrl || "/2026/01/Couple-sitting-by-coast.jpg"} 
              alt={pkg.title}
              loading="lazy" 
              class="card-img"
            />
            <div class="card-gradient"></div>
            {pkg.duration && (
              <span class="card-pill">{pkg.duration}</span>
            )}
          </div>

          <div class="card-content">
            <p class="card-dest">{pkg.destination || "Worldwide"}</p>
            <h3 class="card-title">{pkg.title}</h3>
            {pkg.description && (
              <p class="card-desc">{pkg.description}</p>
            )}
            <div class="card-footer">
              <span class="card-price">{pkg.price || "Custom Quote"}</span>
              <a href="/make-an-enquiry/" class="card-cta">Explore Itinerary →</a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .packages-section {
    padding: 6rem 2rem;
    background-color: #070A0E;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }

  .packages-container {
    max-width: 1440px;
    margin: 0 auto;
  }

  .packages-header {
    text-align: center;
    max-width: 720px;
    margin: 0 auto 4rem;
  }

  .packages-badge {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: #E82E72;
    margin-bottom: 1rem;
    display: inline-block;
  }

  .packages-title {
    font-family: 'Chronicle Display', serif;
    font-size: 3rem;
    color: #FFFFFF;
    margin-bottom: 1rem;
    font-weight: 400;
  }

  .packages-subtitle {
    font-size: 1.1rem;
    color: #94A3B8;
  }

  .packages-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .package-card {
    background: #0C1017;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 1rem;
    overflow: hidden;
    transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
    display: flex;
    flex-direction: column;
  }

  .package-card:hover {
    transform: translateY(-6px);
    border-color: rgba(232, 46, 114, 0.5);
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.6);
  }

  .card-media {
    position: relative;
    width: 100%;
    height: 280px;
    overflow: hidden;
  }

  .card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .package-card:hover .card-img {
    transform: scale(1.05);
  }

  .card-gradient {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 40%, rgba(12, 16, 23, 0.9) 100%);
  }

  .card-pill {
    position: absolute;
    top: 1rem;
    right: 1rem;
    padding: 0.35rem 0.85rem;
    background: rgba(12, 16, 23, 0.75);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 600;
    color: #FFFFFF;
    letter-spacing: 0.05em;
  }

  .card-content {
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .card-dest {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: #E82E72;
    margin-bottom: 0.5rem;
  }

  .card-title {
    font-family: 'Chronicle Display', serif;
    font-size: 1.5rem;
    color: #FFFFFF;
    line-height: 1.3;
    margin-bottom: 0.75rem;
    font-weight: 400;
  }

  .card-desc {
    font-size: 0.95rem;
    color: #94A3B8;
    line-height: 1.6;
    margin-bottom: 1.5rem;
    flex: 1;
  }

  .card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    padding-top: 1.25rem;
  }

  .card-price {
    font-size: 0.95rem;
    font-weight: 600;
    color: #F1F5F9;
  }

  .card-cta {
    font-size: 0.85rem;
    font-weight: 600;
    color: #E82E72;
    text-decoration: none;
    letter-spacing: 0.05em;
    transition: transform 0.2s;
  }

  .card-cta:hover {
    transform: translateX(4px);
  }

  @media (max-width: 1024px) {
    .packages-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .packages-grid {
      grid-template-columns: 1fr;
    }
    .packages-title {
      font-size: 2.2rem;
    }
  }
</style>
