---
// Travel Agency Heritage & Stats Section
// Fully customizable via PostgreSQL / Admin Studio
interface StatItem {
  value: string;
  unit?: string;
  label: string;
  desc: string;
}

interface Props {
  title?: string;
  subtitle?: string;
  stats?: StatItem[];
}

const defaultStats: StatItem[] = [
  {
    value: "20+",
    unit: "YEARS",
    label: "Years of Experience",
    desc: "Designing and leading bespoke luxury travel expeditions worldwide since 2005."
  },
  {
    value: "50,000+",
    unit: "TRAVELERS",
    label: "Happy Travelers Served",
    desc: "Private couples, families, and high-profile travelers guided across 100+ countries."
  },
  {
    value: "99.4%",
    unit: "SUCCESS RATE",
    label: "Customer Satisfaction Rate",
    desc: "Verified 5-star traveler satisfaction, seamless execution, and enduring client loyalty."
  }
];

const {
  title = "TWO DECADES OF CURATING THE EXTRAORDINARY",
  subtitle = "Our track record in precision planning, insider access, and life-affirming private journeys.",
  stats = defaultStats
} = Astro.props;
---

<section class="travel-stats-section" id="travel-stats">
  <div class="stats-container">
    <div class="stats-header">
      <span class="stats-eyebrow">HERITAGE & PROMISE</span>
      <h3 class="stats-title">{title}</h3>
      <p class="stats-subtitle">{subtitle}</p>
    </div>

    <div class="stats-grid">
      {stats.map((item, index) => (
        <div class="stat-card">
          <div class="stat-card-inner">
            <div class="stat-number-wrap">
              <span class="stat-number">{item.value}</span>
              {item.unit && <span class="stat-unit">{item.unit}</span>}
            </div>
            <div class="stat-divider"></div>
            <h4 class="stat-label">{item.label}</h4>
            <p class="stat-desc">{item.desc}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .travel-stats-section {
    background-color: #FAFAFA;
    padding: 5rem 1.5rem;
    position: relative;
    border-top: 1px solid #E2E8F0;
    border-bottom: 1px solid #E2E8F0;
  }

  .stats-container {
    max-width: 1240px;
    margin: 0 auto;
  }

  .stats-header {
    text-align: center;
    max-width: 720px;
    margin: 0 auto 3.5rem;
  }

  .stats-eyebrow {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    color: #E82E72;
    text-transform: uppercase;
    display: inline-block;
    margin-bottom: 0.75rem;
  }

  .stats-title {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    font-size: 1.85rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: #0F172A;
    line-height: 1.25;
    margin: 0 0 1rem;
  }

  .stats-subtitle {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    font-size: 0.95rem;
    color: #64748B;
    line-height: 1.6;
    margin: 0;
  }

  /* 3-Column Stats Grid */
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .stat-card {
    background: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 4px;
    padding: 2.75rem 2rem;
    text-align: center;
    box-shadow: 0 4px 15px -3px rgba(0, 0, 0, 0.03);
    transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
    position: relative;
    overflow: hidden;
  }

  .stat-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 25px -5px rgba(0, 0, 0, 0.06);
    border-color: #CBD5E1;
  }

  .stat-number-wrap {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 0.35rem;
    margin-bottom: 1rem;
  }

  .stat-number {
    font-family: 'Chronicle Display', Georgia, serif;
    font-size: 3.6rem;
    font-weight: 700;
    line-height: 1;
    color: #0F172A;
    letter-spacing: -0.02em;
  }

  .stat-unit {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    font-size: 0.725rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    color: #E82E72;
    text-transform: uppercase;
  }

  .stat-divider {
    width: 36px;
    height: 2px;
    background: #E2E8F0;
    margin: 0 auto 1.25rem;
    transition: width 0.3s ease, background 0.3s ease;
  }

  .stat-card:hover .stat-divider {
    width: 54px;
    background: #E82E72;
  }

  .stat-label {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    font-size: 1.05rem;
    font-weight: 700;
    color: #1E293B;
    margin: 0 0 0.75rem;
  }

  .stat-desc {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    font-size: 0.88rem;
    color: #64748B;
    line-height: 1.55;
    margin: 0;
  }

  @media (max-width: 900px) {
    .stats-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
    .stat-card {
      padding: 2.25rem 1.5rem;
    }
    .stat-number {
      font-size: 3rem;
    }
    .stats-title {
      font-size: 1.5rem;
    }
  }
</style>
