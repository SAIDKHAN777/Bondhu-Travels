                        <div class={`slider-slide ${imgIdx === 0 ? 'is-active' : ''}`} data-slide-index={imgIdx}>
                          <img src={imgSrc} alt={`${room.name} - ছবি ${imgIdx + 1}`} loading="lazy" class="slider-img" />
                        </div>
                      ))}
                    </div>

                    {galleryImgs.length > 1 && (
                      <div class="slider-controls">
                        <button type="button" class="slider-arrow slider-arrow--prev js-room-slider-prev" aria-label="Previous photo">
