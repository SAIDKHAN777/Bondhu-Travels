                  <div class="editorial-text-inner">
                    <h3 class="editorial-room-title">{room.name}</h3>
                    <p class="editorial-room-desc">{room.description}</p>
                    
                    <div class="editorial-price-wrap">
                      <span class="editorial-price-label">ভাড়া:</span>
