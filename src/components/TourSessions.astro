            const isReversed = idx % 2 !== 0;
            const galleryImgs = (room.gallery && room.gallery.length > 0) ? room.gallery : [room.img];
            return (
              <article class={`editorial-room-row ${isReversed ? 'is-reversed' : ''}`} id={`room-${room.id}`}>
                
                <!-- TEXT & BOOKING COLUMN (Only 3 Items: Title, Description, Price) -->
