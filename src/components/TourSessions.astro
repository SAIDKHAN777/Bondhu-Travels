</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // 1. Tab Switching (By Traveller, Most Popular, By Month, In The Spotlight)
    const tabBtns = document.querySelectorAll('.js-tab-btn');
    const tabPanels = document.querySelectorAll('.tab-panel');

    tabBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const target = btn.getAttribute('data-tab-target');
        tabBtns.forEach(b => b.classList.remove('is-active'));
        tabPanels.forEach(p => p.classList.remove('is-active'));

        btn.classList.add('is-active');
        const activePanel = document.getElementById(`tab-${target}`);
        if (activePanel) activePanel.classList.add('is-active');
      });
    });

    // 1.1 Multi-Photo Room Slider Controller
    const roomSliders = document.querySelectorAll('.editorial-slider-box');
    roomSliders.forEach(slider => {
      const slides = slider.querySelectorAll('.slider-slide');
      const counter = slider.querySelector('.js-room-slider-counter');
      const prevBtn = slider.querySelector('.js-room-slider-prev');
      const nextBtn = slider.querySelector('.js-room-slider-next');

      if (slides.length <= 1) return;
      let activeIndex = 0;

      function updateSlide(idx: number) {
        if (idx < 0) idx = slides.length - 1;
        if (idx >= slides.length) idx = 0;
        activeIndex = idx;

        slides.forEach((s, i) => {
          if (i === activeIndex) {
            s.classList.add('is-active');
          } else {
            s.classList.remove('is-active');
          }
        });

        if (counter) {
          counter.textContent = `${activeIndex + 1} / ${slides.length}`;
        }
      }

      if (prevBtn) {
        prevBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          updateSlide(activeIndex - 1);
        });
      }

      if (nextBtn) {
        nextBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          updateSlide(activeIndex + 1);
        });
      }
    });

    // 2. Spotlight Dedicated Property Room Interface Logic
    const propertyInterface = document.getElementById('spotlight-property-interface');
    const openInterfaceBtns = document.querySelectorAll('.js-open-property-interface');
    const closeInterfaceBtns = document.querySelectorAll('.js-close-property-interface');
    const interfacePills = document.querySelectorAll('.js-interface-switch');
    const interfaceViews = document.querySelectorAll('.interface-content-view');
    const interfaceBadge = document.getElementById('interface-prop-badge');
    const interfaceTitle = document.getElementById('interface-prop-title');

    function openPropertyInterface(propertyKey: string) {
      if (!propertyInterface) return;
      propertyInterface.style.display = 'block';
      propertyInterface.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';

      const headerEl = document.getElementById('main-header');
      if (headerEl) {
        headerEl.classList.add('header--scrolled-white');
        headerEl.classList.remove('header--hidden');
      }

      switchInterfaceProperty(propertyKey);
      propertyInterface.scrollTop = 0;
    }

    function closePropertyInterface() {
      if (!propertyInterface) return;
      propertyInterface.style.display = 'none';
      propertyInterface.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';

      window.scrollTo({ top: 0, behavior: 'smooth' });

      const headerEl = document.getElementById('main-header');
      if (headerEl) {
        headerEl.classList.remove('header--scrolled-white');
        headerEl.classList.remove('header--hidden');
      }
    }

    function switchInterfaceProperty(propertyKey: string) {
      // Toggle views with explicit display manipulation for reliability
      interfaceViews.forEach(v => {
        const el = v as HTMLElement;
        if (v.id === `interface-view-${propertyKey}`) {
          v.classList.add('is-active');
          el.style.display = 'block';
        } else {
          v.classList.remove('is-active');
          el.style.display = 'none';
        }
      });

      // Toggle pills
      interfacePills.forEach(pill => {
        if (pill.getAttribute('data-switch') === propertyKey) {
          pill.classList.add('is-active');
        } else {
          pill.classList.remove('is-active');
        }
      });

      // Update titles
      const isResort = propertyKey === 'resort';
      if (interfaceBadge) {
        interfaceBadge.innerText = isResort ? '🌴 সেন্ট মার্টিন বিচ রিসোর্ট' : '🚤 টাঙ্গুয়ার হাওড় হাউসবোট';
      }
      if (interfaceTitle) {
        interfaceTitle.innerText = isResort ? 'কটেজ ও রুমসমূহ' : 'রুম ও কেবিনসমূহ';
      }

      // Update booking modal property dropdown
      const propSelect = document.getElementById('modal-property-select') as HTMLSelectElement | null;
      if (propSelect) {
        propSelect.value = propertyKey;
        populateRoomsForProperty(propertyKey);
      }
    }

    openInterfaceBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const target = btn.getAttribute('data-property-target') || 'houseboat';
        openPropertyInterface(target);
      });
    });

    closeInterfaceBtns.forEach(btn => {
      btn.addEventListener('click', closePropertyInterface);
    });

    if (propertyInterface) {
      let lastOverlayScrollY = 0;
      propertyInterface.addEventListener('scroll', () => {
        const currentY = propertyInterface.scrollTop;
        const diff = currentY - lastOverlayScrollY;
        const headerEl = document.getElementById('main-header');
        if (!headerEl) return;

        if (currentY <= 25) {
          headerEl.classList.remove('header--hidden');
          headerEl.classList.add('header--scrolled-white');
        } else if (diff > 6 && currentY > 70) {
          headerEl.classList.add('header--hidden');
        } else if (diff < -6) {
          headerEl.classList.remove('header--hidden');
          headerEl.classList.add('header--scrolled-white');
        }
        lastOverlayScrollY = currentY;
      }, { passive: true });
    }

    interfacePills.forEach(pill => {
      pill.addEventListener('click', () => {
        const target = pill.getAttribute('data-switch') || 'houseboat';
        switchInterfaceProperty(target);
        if (propertyInterface) propertyInterface.scrollTop = 0;
      });
    });

    // 3. Dynamic Room Population in Booking Modal
    const houseboatRooms = [
      { name: "জলতরঙ্গ (Joltorongo) — মাস্টার লেক ভিউ স্যুট", price: "৳ ১২,০০০/রাত" },
      { name: "জলকুটির (Jolkutir) — প্রিমিয়াম ব্যালকনি কেবিন", price: "৳ ৯,৫০০/রাত" },
      { name: "মেঘবরণ (Meghboron) — ফ্যামিলি লাক্সারি স্যুট", price: "৳ ১৪,০০০/রাত" },
      { name: "জলজোছনা (Joljochona) — ডিলাক্স টুইন কেবিন", price: "৳ ৮,৫০০/রাত" },
      { name: "🌟 সম্পূর্ণ হাউসবোট (Full Charter)", price: "৳ ৪৫,০০০/রাত" }
    ];

    const resortRooms = [
      { name: "প্রবাল কুটির (Probal Kutir) — মাস্টার ওশানফ্রন্ট ভিলা", price: "৳ ৯,৫০০/রাত" },
      { name: "নীল দিগন্ত (Neel Digonto) — ডিলাক্স কাপল কটেজ", price: "৳ ৭,৫০০/রাত" },
      { name: "দ্বীপ ছায়া (Dwip Chhaya) — ফ্যামিলি বিচফ্রন্ট স্যুট", price: "৳ ১১,০০০/রাত" },
      { name: "কোকোনাট গ্রোভ (Coconut Grove) — ডিলাক্স টুইন রুম", price: "৳ ৬,০০০/রাত" },
      { name: "🌟 সম্পূর্ণ রিসোর্ট কটেজ গ্রুপ বুকিং", price: "৳ ৫০,০০০/রাত" }
    ];

    const roomSelect = document.getElementById('modal-room-select') as HTMLSelectElement | null;
    const propSelect = document.getElementById('modal-property-select') as HTMLSelectElement | null;

    function populateRoomsForProperty(prop: string, selectedRoomName?: string) {
      if (!roomSelect) return;
      const list = prop === 'resort' ? resortRooms : houseboatRooms;
      roomSelect.innerHTML = list.map(r => `
        <option value="${r.name}" ${selectedRoomName && selectedRoomName.includes(r.name.split(' ')[0]) ? 'selected' : ''}>
          ${r.name} (${r.price})
        </option>
      `).join('');
    }

    if (propSelect) {
      propSelect.addEventListener('change', (e) => {
        const val = (e.target as HTMLSelectElement).value;
        populateRoomsForProperty(val);
      });
    }

    populateRoomsForProperty('houseboat');

    // 4. Booking Modal Trigger & Logic
    const bookingModal = document.getElementById('spotlight-booking-modal');
    const modalClose = document.getElementById('spotlight-modal-close');
    const openModalBtns = document.querySelectorAll('.js-open-booking-modal');
    const modalTitle = document.getElementById('modal-selected-room-title');
    const modalBadge = document.getElementById('modal-property-badge');
    const checkinInput = document.getElementById('modal-checkin-date') as HTMLInputElement | null;
    const checkoutInput = document.getElementById('modal-checkout-date') as HTMLInputElement | null;
    const bookingForm = document.getElementById('spotlight-booking-form');
    const formStatus = document.getElementById('modal-form-status');
    const whatsappBtn = document.getElementById('modal-btn-whatsapp');

    // Default dates
    const today = new Date();
    const tomorrow = new Date(today);
    tomorrow.setDate(tomorrow.getDate() + 1);
    const dayAfter = new Date(today);
    dayAfter.setDate(dayAfter.getDate() + 2);

    const formatDate = (d: Date) => d.toISOString().split('T')[0];
    if (checkinInput) checkinInput.value = formatDate(tomorrow);
    if (checkoutInput) checkoutInput.value = formatDate(dayAfter);

    openModalBtns.forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const propName = btn.getAttribute('data-property-name') || 'টাঙ্গুয়ার হাওড় নিজস্ব হাউসবোট';
        const roomName = btn.getAttribute('data-room-name') || 'কেবিন নির্বাচন';
        const isResort = propName.includes('সেন্ট মার্টিন') || roomName.includes('কটেজ') || roomName.includes('ভিলা');

        if (modalTitle) modalTitle.innerText = `${roomName}`;
        if (modalBadge) modalBadge.innerText = isResort ? '🌴 সেন্ট মার্টিন বিচ রিসোর্ট' : '🚤 টাঙ্গুয়ার হাওড় হাউসবোট';

        const propertyKey = isResort ? 'resort' : 'houseboat';
        if (propSelect) propSelect.value = propertyKey;
        populateRoomsForProperty(propertyKey, roomName);

        if (bookingModal) {
          bookingModal.style.display = 'flex';
          document.body.style.overflow = 'hidden';
        }
      });
    });

    if (modalClose && bookingModal) {
      modalClose.addEventListener('click', () => {
        bookingModal.style.display = 'none';
        document.body.style.overflow = '';
      });
    }

    if (bookingModal) {
      bookingModal.addEventListener('click', (e) => {
        if (e.target === bookingModal) {
          bookingModal.style.display = 'none';
          document.body.style.overflow = '';
        }
      });
    }

    // Direct WhatsApp Submission
    if (whatsappBtn) {
      whatsappBtn.addEventListener('click', () => {
        const guestName = (document.getElementById('modal-guest-name') as HTMLInputElement)?.value.trim() || '';
        const guestPhone = (document.getElementById('modal-guest-phone') as HTMLInputElement)?.value.trim() || '';
        const selectedProp = propSelect?.value === 'resort' ? 'সেন্ট মার্টিন পার্সোনাল বিচ রিসোর্ট' : 'টাঙ্গুয়ার হাওড় লাক্সারি হাউসবোট';
        const selectedRoom = roomSelect?.value || 'রুম নির্বাচন';
        const checkin = checkinInput?.value || '';
        const checkout = checkoutInput?.value || '';
        const guestCount = (document.getElementById('modal-guest-count') as HTMLSelectElement)?.value || '২ জন';
        const foodPref = (document.getElementById('modal-food-pref') as HTMLSelectElement)?.value || '';
        const guestNote = (document.getElementById('modal-guest-note') as HTMLTextAreaElement)?.value.trim() || '';

        if (!guestName || !guestPhone) {
          alert('দয়া করে আপনার নাম এবং মোবাইল নম্বরটি লিখুন।');
          return;
        }

        const rawPhone = bookingModal?.getAttribute('data-whatsapp-number') || '+8801700000000';
        const cleanPhone = rawPhone.replace(/\D/g, '');

        const message = `🌟 *বন্ডু ট্রাভেল ইন দ্য স্পটলাইট বুকিং রিকোয়েস্ট*
━━━━━━━━━━━━━━━━━━━━
🏨 *প্রপার্টি:* ${selectedProp}
🛏️ *কেবিন / রুম:* ${selectedRoom}
👤 *গেস্টের নাম:* ${guestName}
📞 *মোবাইল:* ${guestPhone}
📅 *তারিখ:* ${checkin} থেকে ${checkout}
👥 *অতিথি:* ${guestCount}
🍽️ *খাবার:* ${foodPref}
${guestNote ? `📝 *নোট:* ${guestNote}\n` : ''}━━━━━━━━━━━━━━━━━━━━
দয়া করে দ্রুত অ্যাভেইলেবিলিটি ও বুকিং কনফার্মেশন প্রসেস জানাবেন। ধন্যবাদ!`;

        const waUrl = `https://wa.me/${cleanPhone || '8801700000000'}?text=${encodeURIComponent(message)}`;
        window.open(waUrl, '_blank');
      });
    }

    // Online Database Booking Submit
    if (bookingForm) {
      bookingForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const guestName = (document.getElementById('modal-guest-name') as HTMLInputElement)?.value.trim() || '';
        const guestPhone = (document.getElementById('modal-guest-phone') as HTMLInputElement)?.value.trim() || '';
        const selectedProp = propSelect?.value === 'resort' ? 'সেন্ট মার্টিন পার্সোনাল বিচ রিসোর্ট' : 'টাঙ্গুয়ার হাওড় লাক্সারি হাউসবোট';
        const selectedRoom = roomSelect?.value || 'স্পটলাইট রুম';
        const checkin = checkinInput?.value || '';
        const checkout = checkoutInput?.value || '';
        const guestCount = (document.getElementById('modal-guest-count') as HTMLSelectElement)?.value || '২ জন';
        const foodPref = (document.getElementById('modal-food-pref') as HTMLSelectElement)?.value || '';
        const guestNote = (document.getElementById('modal-guest-note') as HTMLTextAreaElement)?.value.trim() || '';

        if (!guestName || !guestPhone) {
          alert('দয়া করে নাম ও মোবাইল নম্বর পূরণ করুন।');
          return;
        }

        if (formStatus) {
          formStatus.style.display = 'block';
          formStatus.style.background = 'rgba(245, 158, 11, 0.2)';
          formStatus.style.color = '#FBBF24';
          formStatus.innerText = '⏳ আপনার বুকিং রিকোয়েস্ট জমা হচ্ছে...';
        }

        try {
          const res = await fetch('/api/bookings/create', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              customerName: guestName,
              phone: guestPhone,
              tourTitle: `[স্পটলাইট] ${selectedProp} — ${selectedRoom}`,
              country: 'BANGLADESH',
              travelDate: `${checkin} থেকে ${checkout}`,
              travelers: parseInt(guestCount) || 2,
              travelerType: foodPref,
              totalPrice: 10000,
              bookingMoneyPaid: 0,
              paymentMethod: 'Spotlight Property Request',
              notes: guestNote
            })
          });

          const data = await res.json();
          if (data.success || res.ok) {
            if (formStatus) {
              formStatus.style.background = 'rgba(16, 185, 129, 0.25)';
              formStatus.style.color = '#34D399';
              formStatus.innerText = '✅ আপনার বুকিং রিকোয়েস্ট সফলভাবে জমা হয়েছে! শীঘ্রই আমাদের প্রতিনিধি আপনার সাথে যোগাযোগ করবেন।';
            }
            setTimeout(() => {
              if (bookingModal) {
                bookingModal.style.display = 'none';
                document.body.style.overflow = '';
              }
              if (formStatus) formStatus.style.display = 'none';
              bookingForm.reset();
            }, 3000);
          } else {
            throw new Error(data.error || 'রিকোয়েস্ট পাঠানো সম্ভব হয়নি');
          }
        } catch (err: any) {
          if (formStatus) {
            formStatus.style.background = 'rgba(239, 68, 68, 0.25)';
            formStatus.style.color = '#F87171';
            formStatus.innerText = `❌ এরর: ${err.message || 'সমস্যা হয়েছে। দয়া করে WhatsApp-এ যোগাযোগ করুন।'}`;
          }
        }
      });
    }

    // 5. Lightbox Preview
    const galleryModal = document.getElementById('spotlight-gallery-modal');
    const lightboxClose = document.getElementById('lightbox-close');
    const lightboxTitle = document.getElementById('lightbox-title');
    const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement | null;
    const lightboxThumbs = document.getElementById('lightbox-thumbs');

    const previewBtns = document.querySelectorAll('.js-preview-gallery');
    previewBtns.forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const title = btn.getAttribute('data-title') || 'রুম ছবি';
        const rawImgs = btn.getAttribute('data-images') || '[]';
        let images: string[] = [];
        try { images = JSON.parse(rawImgs); } catch (e) { images = []; }

        if (lightboxTitle) lightboxTitle.innerText = `${title} — ফটো গ্যালারি`;
        if (lightboxImg && images.length > 0) lightboxImg.src = images[0];

        if (lightboxThumbs) {
          lightboxThumbs.innerHTML = images.map((src, i) => `
            <img src="${src}" class="lightbox-thumb ${i === 0 ? 'active' : ''}" data-src="${src}" alt="thumb">
          `).join('');

          const thumbEls = lightboxThumbs.querySelectorAll('.lightbox-thumb');
          thumbEls.forEach(thumb => {
            thumb.addEventListener('click', () => {
              thumbEls.forEach(t => t.classList.remove('active'));
              thumb.classList.add('active');
              if (lightboxImg) lightboxImg.src = thumb.getAttribute('data-src') || '';
            });
          });
        }

        if (galleryModal) {
          galleryModal.style.display = 'flex';
          document.body.style.overflow = 'hidden';
        }
      });
    });

    if (lightboxClose && galleryModal) {
      lightboxClose.addEventListener('click', () => {
        galleryModal.style.display = 'none';
        document.body.style.overflow = '';
      });
    }

    if (galleryModal) {
      galleryModal.addEventListener('click', (e) => {
        if (e.target === galleryModal) {
          galleryModal.style.display = 'none';
          document.body.style.overflow = '';
        }
      });
    }

    // ESC Key to close any active modal or property room interface
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        if (galleryModal && galleryModal.style.display === 'flex') {
          galleryModal.style.display = 'none';
          document.body.style.overflow = '';
          return;
        }
        if (bookingModal && bookingModal.style.display === 'flex') {
          bookingModal.style.display = 'none';
          document.body.style.overflow = '';
          return;
        }
        if (propertyInterface && propertyInterface.style.display === 'block') {
          closePropertyInterface();
        }
      }
    });
  });
</script>
