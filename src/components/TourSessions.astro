      capacity: "৪-৫ জন",
      bedType: "২টি বড় ডাবল বেড",
      features: ["২টি আলাদা বেডরুম জোন", "প্রশস্ত সি-ফেসিং বারান্দা", "এসি ও আধুনিক ওয়াশরুম", "বাচ্চাদের খেলার জন্য নিরাপদ বিচ"],
      description: "পরিবার নিয়ে সেন্ট মার্টিন ভ্রমণের জন্য সবচেয়ে নিরাপদ ও আরামদায়ক স্যুট। পরিবারের সবাই একসাথে চমৎকার সময় কাটাতে পারবেন।"
    },
    {
      id: "resort-coconutgrove",
      name: "কোকোনাট গ্রোভ (Coconut Grove)",
      subtitle: "ডিলাক্স টুইন/ইকো রুম (Deluxe Twin)",
      img: "/2026/01/Group-canoeing-1.jpg",
      gallery: [
        "/2026/01/Group-canoeing-1.jpg",
        "/2022/09/Utah-adventure-2-1-scaled.jpg"
      ],
      price: "৳ ৬,০০০",
      priceUnit: "প্রতি রাত",
      capacity: "২ জন",
      bedType: "২টি আলাদা সিঙ্গেল বেড",
      features: ["টুইন বেড সেটআপ", "অ্যাটাচড ওয়াশরুম", "রিসোর্ট গার্ডেন লাউঞ্জ", "সি-ফুড বারবিকিউ বিশেষ ছাড়"],
      description: "বন্ধু বা সহকর্মীদের সাথে ভ্রমণের জন্য আদর্শ ও সাশ্রয়ী আধুনিক কটেজ। সাশ্রয়ী বাজেটে প্রিমিয়াম বিচ রিসোর্ট ফিল।"
    }
  ]
};

const {
  travellerCards: propTraveller,
  popularCards: propPopular,
  monthCards: propMonth,
  spotlightConfig: propSpotlight,
  whatsappPhone: propWhatsapp
} = Astro.props;

const travellerCards = propTraveller && propTraveller.length > 0 ? propTraveller : defaultTravellerCards;
const popularCards = propPopular && propPopular.length > 0 ? propPopular : defaultPopularCards;
const monthCards = propMonth && propMonth.length > 0 ? propMonth : defaultMonthCards;

// Merge Live DB Spotlight settings with robust fallback
const liveHouseboat: SpotlightProperty = {
  ...defaultHouseboatProperty,
  ...(propSpotlight?.houseboat || (propSpotlight?.cabins ? propSpotlight : {})),
  thumbnailImg: propSpotlight?.houseboat?.thumbnailImg || defaultHouseboatProperty.thumbnailImg,
  cardHeadline: propSpotlight?.houseboat?.cardHeadline || propSpotlight?.houseboat?.bengaliTitle || defaultHouseboatProperty.bengaliTitle,
  heroVideo: propSpotlight?.houseboat?.heroVideo !== undefined ? propSpotlight.houseboat.heroVideo : defaultHouseboatProperty.heroVideo,
  heroImg: propSpotlight?.houseboat?.heroImg || defaultHouseboatProperty.heroImg,
  englishTitle: propSpotlight?.houseboat?.englishTitle || propSpotlight?.houseboat?.title || defaultHouseboatProperty.englishTitle,
  rooms: (propSpotlight?.houseboat?.rooms && propSpotlight.houseboat.rooms.length > 0)
    ? propSpotlight.houseboat.rooms
    : (propSpotlight?.cabins && propSpotlight.cabins.length > 0)
      ? propSpotlight.cabins
      : defaultHouseboatProperty.rooms
};

const liveResort: SpotlightProperty = {
  ...defaultResortProperty,
  ...(propSpotlight?.resort || {}),
  thumbnailImg: propSpotlight?.resort?.thumbnailImg || defaultResortProperty.thumbnailImg,
  cardHeadline: propSpotlight?.resort?.cardHeadline || propSpotlight?.resort?.bengaliTitle || defaultResortProperty.bengaliTitle,
  heroVideo: propSpotlight?.resort?.heroVideo !== undefined ? propSpotlight.resort.heroVideo : defaultResortProperty.heroVideo,
  heroImg: propSpotlight?.resort?.heroImg || defaultResortProperty.heroImg,
  englishTitle: propSpotlight?.resort?.englishTitle || propSpotlight?.resort?.title || defaultResortProperty.englishTitle,
  rooms: (propSpotlight?.resort?.rooms && propSpotlight.resort.rooms.length > 0)
    ? propSpotlight.resort.rooms
    : defaultResortProperty.rooms
};

const targetWhatsapp = propWhatsapp || "+442074269888";
---

<section class="section section--filtered_tiles pt-xl sm:pt-xl pb-lg bg-light" id="tour-sessions">
  <div class="container">
    <header class="align-text-center">
      <h2 class="section-heading">START YOUR JOURNEY</h2>
      <ul class="list list--tabs filter-tab-buttons">
        <li>
          <button class="text-sm-xs text-headings uppercase js-tab-btn is-active" data-tab-target="by-traveller">
            BY TRAVELLER
          </button>
        </li>
        <li>
          <button class="text-sm-xs text-headings uppercase js-tab-btn" data-tab-target="most-popular">
            MOST POPULAR
          </button>
        </li>
        <li>
          <button class="text-sm-xs text-headings uppercase js-tab-btn" data-tab-target="by-month">
            BY MONTH
          </button>
        </li>
        <li>
          <button class="text-sm-xs text-headings uppercase js-tab-btn" data-tab-target="in-the-spotlight">
            IN THE SPOTLIGHT
          </button>
        </li>
      </ul>
    </header>

    <div class="section__content section__content--row section">
      <!-- TAB 1: BY TRAVELLER -->
      <div class="tab-panel is-active" id="tab-by-traveller">
        <div class="tiles-grid tiles-grid--5">
          {travellerCards.map((card) => (
            <div class="tile-card">
              <div class="tile-content" style={`background-image: url(${card.img || (card as any).image});`}>
                <a href={card.link || '/destinations/'} class="tile-link">
                  <h5 class="h6 strong tile-title">{card.title}</h5>
                  <div class="tile-overlay"></div>
                </a>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- TAB 2: MOST POPULAR -->
      <div class="tab-panel" id="tab-most-popular">
        <div class="tiles-grid tiles-grid--4">
          {popularCards.map((card) => (
            <div class="tile-card">
              <div class="tile-content" style={`background-image: url(${card.img || (card as any).image});`}>
                <a href={card.link} class="tile-link">
                  <h5 class="h6 strong tile-title">{card.title}</h5>
                  <div class="tile-overlay"></div>
                </a>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- TAB 3: BY MONTH -->
      <div class="tab-panel" id="tab-by-month">
        <div class="tiles-grid tiles-grid--4">
          {monthCards.map((card) => (
            <div class="tile-card">
              <div class="tile-content" style={`background-image: url(${card.img || (card as any).image});`}>
                <a href={card.link} class="tile-link">
                  <h5 class="h6 strong tile-title">{card.title}</h5>
                  <div class="tile-overlay"></div>
                </a>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- TAB 4: IN THE SPOTLIGHT (2 Clean Destination Cards, matching other tabs) -->
      <div class="tab-panel" id="tab-in-the-spotlight">
        <div class="tiles-grid tiles-grid--2">
          <!-- CARD 1: TANGUAR HAOR LUXURY HOUSEBOAT -->
          <div class="tile-card js-open-property-interface" data-property-target="houseboat" style="cursor: pointer;">
            <div class="tile-content" style={`background-image: url('${liveHouseboat.thumbnailImg || "/uploads/images/obintehasan_pindown_io_1793483591-mvwxtycm.jpg"}');`}>
              <div class="tile-link">
                <h5 class="h6 strong tile-title">{liveHouseboat.cardHeadline || liveHouseboat.bengaliTitle || liveHouseboat.title || "টাঙ্গুয়ার হাওড় নিজস্ব লাক্সারি হাউসবোট"}</h5>
                <div class="tile-overlay"></div>
              </div>
            </div>
          </div>

          <!-- CARD 2: SAINT MARTIN PERSONAL BEACH RESORT -->
          <div class="tile-card js-open-property-interface" data-property-target="resort" style="cursor: pointer;">
            <div class="tile-content" style={`background-image: url('${liveResort.thumbnailImg || "/2026/01/Couple-sitting-by-coast.jpg"}');`}>
              <div class="tile-link">
                <h5 class="h6 strong tile-title">{liveResort.cardHeadline || liveResort.bengaliTitle || liveResort.title || "সেন্ট মার্টিন পার্সোনাল বিচ রিসোর্ট"}</h5>
                <div class="tile-overlay"></div>
              </div>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

