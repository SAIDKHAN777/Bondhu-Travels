<div class="spotlight-modal-backdrop" id="spotlight-booking-modal" style="display: none;" data-whatsapp-number={targetWhatsapp}>
  <div class="spotlight-modal-dialog">
    <button type="button" class="modal-close-btn" id="spotlight-modal-close" aria-label="Close modal">&times;</button>
    
    <div class="modal-header">
      <span class="modal-badge" id="modal-property-badge">✨ বন্ডু ট্রাভেল এক্সক্লুসিভ বুকিং</span>
      <h3 class="modal-title" id="modal-selected-room-title">রুম ও কামরা নির্বাচন</h3>
      <p class="modal-subtitle">সুবিধাজনক তারিখ ও বিবরণ দিন। সরাসরি WhatsApp বা অনলাইনের মাধ্যমে বুকিং নিশ্চিত করুন।</p>
    </div>

    <form class="spotlight-booking-form" id="spotlight-booking-form">
      <div class="form-row-2">
        <div class="form-group">
          <label class="form-label">প্রপার্টি (Property)</label>
          <select class="form-select" id="modal-property-select">
            <option value="houseboat" selected>⛵ টাঙ্গুয়ার হাওড় নিজস্ব লাক্সারি হাউসবোট</option>
            <option value="resort">🌴 সেন্ট মার্টিন পার্সোনাল বিচ রিসোর্ট</option>
          </select>
        </div>
        <div class="form-group">
          <label class="form-label">নির্বাচিত রুম / কেবিন</label>
          <select class="form-select" id="modal-room-select" required>
            <!-- Dynamically populated via JS -->
          </select>
        </div>
      </div>

      <div class="form-row-2">
        <div class="form-group">
          <label class="form-label">ভ্রমণ শুরুর তারিখ (Check-in)</label>
          <input type="date" class="form-input" id="modal-checkin-date" required />
        </div>
        <div class="form-group">
          <label class="form-label">ভ্রমণ শেষের তারিখ (Check-out)</label>
          <input type="date" class="form-input" id="modal-checkout-date" required />
        </div>
      </div>

      <div class="form-row-2">
        <div class="form-group">
          <label class="form-label">আপনার নাম (Full Name)</label>
          <input type="text" class="form-input" id="modal-guest-name" placeholder="আপনার নাম লিখুন..." required />
        </div>
        <div class="form-group">
          <label class="form-label">মোবাইল / WhatsApp নম্বর</label>
          <input type="tel" class="form-input" id="modal-guest-phone" placeholder="017XXXXXXXX" required />
        </div>
      </div>

      <div class="form-row-2">
        <div class="form-group">
          <label class="form-label">অতিথির সংখ্যা (Guests)</label>
          <select class="form-select" id="modal-guest-count">
            <option value="১ জন">১ জন</option>
            <option value="২ জন" selected>২ জন</option>
            <option value="৩ জন">৩ জন</option>
            <option value="৪ জন">৪ জন</option>
