---
// Authentic Black Tomato "WHY BLACK TOMATO?" Section
// Fully redesigned: 5 Icons removed, replaced with Customer Satisfaction & Authority Stats
// + Trustpilot Badge + Client Comments Slider (100% exact match to user screenshots)
import CustomerComments from './CustomerComments.astro';

interface StatItem {
  value: string;
  unit?: string;
  label: string;
  desc: string;
}

interface Review {
  quote: string;
  author: string;
  destination?: string;
}

interface Props {
  title?: string;
  subtitle?: string;
  stats?: StatItem[];
  reviews?: Review[];
  trustpilotScore?: string;
}

const defaultStats: StatItem[] = [
  {
    value: "20+",
    unit: "YEARS",
    label: "Years of Experience",
    desc: "Crafting bespoke, transformative luxury journeys worldwide since 2005."
  },
  {
    value: "50,000+",
    unit: "TRAVELERS",
    label: "Happy Travelers Served",
    desc: "Private travelers, families and couples guided across 100+ destinations."
  }
];

const {
  title = "WHY BLACK TOMATO?",
  subtitle = "Two decades of delivering the world's most inspiring, high-touch luxury travel experiences.",
  stats = defaultStats,
  reviews
} = Astro.props;

const activeStats = stats && stats.length > 0 ? stats : defaultStats;
---

<section class="why-black-tomato-section" id="why-black-tomato" aria-label="Why Bondhu Travel">
  <div class="why-us-container">
    <!-- 1. Section Header: WHY BLACK TOMATO? -->
    <div class="why-header">
      <h2 class="why-title">{title}</h2>
      {subtitle && <p class="why-subtitle">{subtitle}</p>}
    </div>

    <!-- 2. Replaced Icons with the 3 Stats Numbers (Experience, Travelers, Satisfaction Rate) -->
    <div class="stats-counters-grid">
      {activeStats.map((item) => (
        <div class="stat-card">
          <div class="stat-card-inner">
            <div class="stat-num-box">
              <span class="stat-val">{item.value}</span>
              {item.unit && <span class="stat-unit-badge">{item.unit}</span>}
            </div>
            <div class="stat-card-divider"></div>
            <h3 class="stat-lbl">{item.label}</h3>
            <p class="stat-desc">{item.desc}</p>
          </div>
        </div>
      ))}
    </div>

    <!-- 3. Client Comments Carousel Slider (Exact match to screenshot 2) -->
    <CustomerComments reviews={reviews} />
  </div>
</section>

<style>
  .why-black-tomato-section {
    background-color: #FFFFFF;
    color: #111827;
    padding: 6rem 1.5rem 5rem;
    position: relative;
    border-top: 1px solid #F1F5F9;
  }

  .why-us-container {
    max-width: 1320px;
    margin: 0 auto;
    text-align: center;
  }

  /* Header */
  .why-header {
    max-width: 760px;
    margin: 0 auto 3.75rem;
  }

  .why-title {
    font-family: 'AlternateGotNo1D', 'Alternate Gothic', 'League Gothic', sans-serif;
    font-size: 3.5rem;
    font-weight: 400;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: #0F172A;
    margin: 0 0 1rem;
    line-height: 1.1;
  }

  .why-subtitle {
    font-family: 'Brandon Grotesque', 'Cabin', 'Josefin Sans', sans-serif;
    font-size: 1.05rem;
    letter-spacing: 0.03em;
    color: #64748B;
    line-height: 1.6;
    margin: 0;
  }

  /* Stats Numbers Grid (Experience & Travelers) */
  .stats-counters-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    max-width: 860px;
    margin: 0 auto 3.5rem auto;
    gap: 2.25rem;
  }

  .stat-card {
    background: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 6px;
    padding: 2.75rem 2rem;
    text-align: center;
    box-shadow: 0 4px 20px -4px rgba(0, 0, 0, 0.03);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.3s ease, border-color 0.3s ease;
    position: relative;
  }

  .stat-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 14px 30px -6px rgba(0, 0, 0, 0.07);
    border-color: #CBD5E1;
  }

  .stat-num-box {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 0.45rem;
    margin-bottom: 1rem;
  }

  .stat-val {
    font-family: 'Brandon Grotesque', 'Cabin', 'Josefin Sans', sans-serif;
    font-size: 3.5rem;
    font-weight: 700;
    line-height: 1;
    color: #0F172A;
    letter-spacing: -0.02em;
  }

  .stat-unit-badge {
    font-family: 'Brandon Grotesque', 'Cabin', 'Josefin Sans', sans-serif;
    font-size: 0.725rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    color: #10B981;
    text-transform: uppercase;
  }

  .stat-card-divider {
    width: 38px;
    height: 2px;
    background: #E2E8F0;
    margin: 0 auto 1.25rem;
    transition: width 0.3s ease, background 0.3s ease;
  }

  .stat-card:hover .stat-card-divider {
    width: 55px;
    background: #10B981;
  }

  .stat-lbl {
    font-family: 'Brandon Grotesque', 'Cabin', 'Josefin Sans', sans-serif;
    font-size: 1.05rem;
    font-weight: 700;
    color: #1E293B;
    margin: 0 0 0.65rem;
  }

  .stat-desc {
    font-family: 'Brandon Grotesque', 'Cabin', 'Josefin Sans', sans-serif;
    font-size: 0.88rem;
    color: #64748B;
    line-height: 1.55;
    margin: 0;
  }

  @media (max-width: 992px) {
    .stats-counters-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
    .why-title {
      font-size: 2rem;
    }
    .stat-val {
      font-size: 2.8rem;
    }
  }

  @media (max-width: 640px) {
    .why-black-tomato-section {
      padding: 4rem 1rem 3rem;
    }
    .why-title {
      font-size: 1.7rem;
    }
  }
</style>
